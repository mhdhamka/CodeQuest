{
  "name": "codequest-arena",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "prebuild": "node -e \"const fs=require('fs'); if (!fs.existsSync('bin')) fs.mkdirSync('bin');\"",
    "build:win": "cd engine && go build -o ../bin/go-engine.exe main.go",
    "build:unix": "cd engine && go build -o ../bin/go-engine main.go",
    "build": "cd engine && go build -o ../bin/go-engine.exe main.go",
    "start": "node server.js",
    "lint": "node --check server.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "vue": "^3.5.43",
    "vue3-sfc-loader": "^0.9.5"
  }
}