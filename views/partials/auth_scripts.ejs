<!-- Firebase Auth & Cloud Firestore Engine -->
<script type="module">
  import { initializeApp } from 'https://www.gstatic.com/firebasejs/11.4.0/firebase-app.js';
  import { 
    getAuth, 
    signInWithPopup, 
    signInWithCredential,
    GoogleAuthProvider,
    GithubAuthProvider, 
    signOut, 
    onAuthStateChanged 
  } from 'https://www.gstatic.com/firebasejs/11.4.0/firebase-auth.js';
  import { 
    getFirestore, 
    doc, 
    getDoc, 
    setDoc, 
    serverTimestamp 
  } from 'https://www.gstatic.com/firebasejs/11.4.0/firebase-firestore.js';

  let firebaseApp = null;
  let firebaseAuth = null;
  let firestoreDb = null;
  let cachedConfig = null;

  function showToast(msg, icon = '⚡', isSuccess = true) {
    const toastEl = document.getElementById('cyberToast');
    if (!toastEl) return;
    document.getElementById('cyberToastMessage').innerText = msg;
    document.getElementById('cyberToastIcon').innerText = icon;
    toastEl.className = 'toast align-items-center text-white bg-dark border ' + 
      (isSuccess ? 'border-info' : 'border-danger') + ' font-monospace shadow-lg';
    const toast = new bootstrap.Toast(toastEl, { delay: 4000 });
    toast.show();
  }

  async function getFirebaseInstances() {
    if (firebaseAuth && firestoreDb) {
      return { app: firebaseApp, auth: firebaseAuth, db: firestoreDb };
    }

    try {
      const resp = await fetch('/api/firebase-config');
      cachedConfig = await resp.json();
      if (!cachedConfig || !cachedConfig.apiKey) {
        console.warn('Firebase config unavailable from /api/firebase-config');
        return null;
      }
      firebaseApp = initializeApp(cachedConfig);
      firebaseAuth = getAuth(firebaseApp);
      firestoreDb = getFirestore(firebaseApp, cachedConfig.firestoreDatabaseId || undefined);
      return { app: firebaseApp, auth: firebaseAuth, db: firestoreDb };
    } catch (err) {
      console.error('Failed to initialize Firebase instances:', err);
      return null;
    }
  }

  // Parse JWT token from Google Identity Services
  function decodeJwtPayload(token) {
    try {
      const base64Url = token.split('.')[1];
      const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
      const jsonPayload = decodeURIComponent(atob(base64).split('').map(function(c) {
        return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
      }).join(''));
      return JSON.parse(jsonPayload);
    } catch (e) {
      console.error('Failed to parse JWT payload', e);
      return null;
    }
  }

  // Initialize Google Identity Services (GIS) with Configured OAuth Client ID
  function initGoogleIdentityServices() {
    const oAuthClientId = (cachedConfig && cachedConfig.oAuthClientId) || 
      "<%= (firebaseConfig && firebaseConfig.oAuthClientId) ? firebaseConfig.oAuthClientId : '' %>";
    
    if (!oAuthClientId || typeof google === 'undefined' || !google.accounts || !google.accounts.id) {
      return;
    }

    try {
      google.accounts.id.initialize({
        client_id: oAuthClientId,
        callback: handleGoogleGsiCredential,
        auto_select: false,
        cancel_on_tap_outside: true,
        context: 'signin'
      });

      const gsiContainer = document.getElementById('googleGsiBtnContainer');
      if (gsiContainer) {
        gsiContainer.innerHTML = '';
        google.accounts.id.renderButton(gsiContainer, {
          theme: 'filled_black',
          size: 'large',
          type: 'standard',
          shape: 'rectangular',
          text: 'signin_with',
          logo_alignment: 'left',
          width: 280
        });
      }
    } catch (err) {
      console.warn('[Google Identity Services Init Warning]', err);
    }
  }

  // Core processor for authenticated Google user: restores or saves CodeQuest progress to Firestore
  async function processAuthenticatedGoogleUser(details) {
    const instances = await getFirebaseInstances();
    const statusBanner = document.getElementById('authStatusBanner');
    if (statusBanner) {
      statusBanner.className = 'alert alert-info border border-info small py-2 px-3 mb-0';
      statusBanner.innerHTML = '⚡ Synchronizing operative dossier and CodeQuest progress...';
    }

    const uid = details.uid;
    const email = details.email || '';
    const displayName = details.displayName || (email ? email.split('@')[0] : 'Operative');
    let cleanUsername = (details.username || (email ? email.split('@')[0] : displayName)).replace(/[^\w.-]/g, '_');
    const photo = details.photoURL || 'https://lh3.googleusercontent.com/a/default-user';

    let profileData = {
      uid: uid,
      username: cleanUsername,
      displayName: displayName,
      email: email,
      avatar: photo,
      authProvider: 'google',
      googleLinked: true,
      githubLinked: false,
      updatedAt: new Date().toISOString()
    };

    // 1. Check or restore existing CodeQuest progress from Cloud Firestore
    if (instances && instances.db) {
      try {
        const userRef = doc(instances.db, 'users', uid);
        const userDocSnap = await getDoc(userRef);

        if (userDocSnap && userDocSnap.exists()) {
          const existingData = userDocSnap.data();
          profileData.level = existingData.level || <%= userProfile ? userProfile.level : 2 %>;
          profileData.xp = existingData.xp || <%= userProfile ? userProfile.xp : 750 %>;
          profileData.role_class = existingData.role_class || '<%= userProfile ? userProfile.role_class : "ARCHITECT" %>';
          profileData.role_class_display = existingData.role_class_display || '<%= userProfile ? userProfile.role_class_display : "Cyber Architect" %>';
          profileData.completedChallenges = existingData.completedChallenges || [1];

          // Reconcile if session has higher XP
          const currentXp = <%= userProfile ? userProfile.xp : 750 %>;
          if (currentXp > profileData.xp) {
            profileData.xp = currentXp;
            profileData.level = Math.floor(currentXp / 500) + 1;
          }

          await setDoc(userRef, {
            ...profileData,
            syncedAt: serverTimestamp()
          }, { merge: true });
        } else {
          // New Google Operative: Seed Firestore with current guest progression
          profileData.level = <%= userProfile ? userProfile.level : 2 %>;
          profileData.xp = <%= userProfile ? userProfile.xp : 750 %>;
          profileData.role_class = '<%= userProfile ? userProfile.role_class : "ARCHITECT" %>';
          profileData.role_class_display = '<%= userProfile ? userProfile.role_class_display : "Cyber Architect" %>';
          profileData.completedChallenges = <%- JSON.stringify((userProfile && userProfile.solved_submissions) ? userProfile.solved_submissions.map(s => s.challengeId) : [1]) %>;

          await setDoc(userRef, {
            ...profileData,
            createdAt: serverTimestamp(),
            syncedAt: serverTimestamp()
          }, { merge: true });
        }
      } catch (fErr) {
        console.warn('[Firestore Google Profile Notice]', fErr);
      }
    }

    // 2. Synchronize with Express backend session
    try {
      const resp = await fetch('/api/auth/session', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(profileData)
      });

      if (resp.ok) {
        showToast(`Operative @${cleanUsername} authenticated with Google! Progress saved.`, '🌐', true);
        setTimeout(() => window.location.reload(), 1000);
      } else {
        throw new Error('Session registration failed');
      }
    } catch (err) {
      console.error('Session sync error:', err);
      showToast('Failed to save session: ' + err.message, '✖', false);
    }
  }

  // Handle Google Identity Services (GIS) Credential Callback
  async function handleGoogleGsiCredential(response) {
    if (!response || !response.credential) return;
    const payload = decodeJwtPayload(response.credential);
    if (!payload) return;

    showToast('Google credential received. Validating with Firebase...', '⚡', true);
    const instances = await getFirebaseInstances();
    let finalUid = 'g_' + payload.sub;

    if (instances && instances.auth) {
      try {
        const credential = GoogleAuthProvider.credential(response.credential);
        const userCred = await signInWithCredential(instances.auth, credential);
        if (userCred && userCred.user) {
          finalUid = userCred.user.uid;
        }
      } catch (fbErr) {
        console.warn('[Firebase Auth GIS Credential Notice]:', fbErr.message);
      }
    }

    await processAuthenticatedGoogleUser({
      uid: finalUid,
      email: payload.email,
      displayName: payload.name,
      photoURL: payload.picture,
      username: payload.email ? payload.email.split('@')[0] : payload.name
    });
  }

  // Launch Google Sign-In Popup using Firebase GoogleAuthProvider
  window.runFirebaseGooglePopup = async function() {
    const statusBanner = document.getElementById('authStatusBanner');
    const btn = document.getElementById('modalGoogleSignInBtn');
    
    if (statusBanner) {
      statusBanner.className = 'alert alert-info border border-info small py-2 px-3 mb-0';
      statusBanner.innerHTML = '⚡ Launching Google Authentication popup...';
    }
    if (btn) btn.disabled = true;

    const instances = await getFirebaseInstances();
    if (!instances || !instances.auth) {
      if (statusBanner) {
        statusBanner.className = 'alert alert-warning border border-warning small py-2 px-3 mb-0';
        statusBanner.innerHTML = '⚠️ Initializing Firebase authentication...';
      }
      if (btn) btn.disabled = false;
      return;
    }

    const provider = new GoogleAuthProvider();
    provider.addScope('profile');
    provider.addScope('email');

    try {
      const result = await signInWithPopup(instances.auth, provider);
      const user = result.user;
      await processAuthenticatedGoogleUser({
        uid: user.uid,
        email: user.email,
        displayName: user.displayName,
        photoURL: user.photoURL,
        username: user.email ? user.email.split('@')[0] : user.displayName
      });
    } catch (error) {
      console.warn('[Firebase Google Auth Error]', error.code, error.message);
      if (btn) btn.disabled = false;
      if (statusBanner) {
        statusBanner.className = 'alert alert-warning border border-warning small py-2 px-3 mb-0';
        if (error.code === 'auth/operation-not-allowed' || error.code === 'auth/configuration-not-found') {
          statusBanner.innerHTML = 'ℹ️ <strong>Google Provider Notice:</strong> If popup is restricted, please click the Google Sign-In button above directly rendered via configured OAuth Client ID.';
        } else if (error.code === 'auth/popup-closed-by-user') {
          statusBanner.innerHTML = 'ℹ️ Google sign-in popup was closed before authorization was completed.';
        } else {
          statusBanner.innerHTML = `⚠️ ${error.message || 'Google authentication error.'}`;
        }
      }
    }
  };

  // Launch popup with GitHubAuthProvider
  window.runFirebaseGithubPopup = async function() {
    const statusBanner = document.getElementById('authStatusBanner');
    const btn = document.getElementById('modalPopupSignInBtn');
    
    if (statusBanner) {
      statusBanner.className = 'alert alert-info border border-info small py-2 px-3 mb-0';
      statusBanner.innerHTML = '⚡ Initiating GitHub Authentication popup with Firebase...';
    }
    if (btn) btn.disabled = true;

    const instances = await getFirebaseInstances();
    if (!instances || !instances.auth) {
      if (statusBanner) {
        statusBanner.className = 'alert alert-warning border border-warning small py-2 px-3 mb-0';
        statusBanner.innerHTML = '⚠️ Firebase configuration not found. Use direct GitHub handle linker below.';
      }
      if (btn) btn.disabled = false;
      return;
    }

    const provider = new GithubAuthProvider();
    provider.addScope('read:user');
    provider.addScope('user:email');

    try {
      const result = await signInWithPopup(instances.auth, provider);
      const user = result.user;
      
      const githubHandle = result._tokenResponse?.screenName || 
                           user.reloadUserInfo?.screenName || 
                           user.displayName || 
                           user.email?.split('@')[0] || 
                           'Operative_GH';
      
      const photo = user.photoURL || `https://github.com/${githubHandle}.png`;

      // Check or seed user document in Firestore
      const userRef = doc(instances.db, 'users', user.uid);
      let userDocSnap = null;
      try {
        userDocSnap = await getDoc(userRef);
      } catch (fErr) {
        console.warn('Firestore read error (using fallback):', fErr);
      }

      let profileData = {
        uid: user.uid,
        username: githubHandle,
        displayName: user.displayName || githubHandle,
        email: user.email || '',
        avatar: photo,
        authProvider: 'github',
        githubLinked: true,
        googleLinked: false,
        updatedAt: new Date().toISOString()
      };

      if (userDocSnap && userDocSnap.exists()) {
        const existingData = userDocSnap.data();
        profileData.level = existingData.level || 2;
        profileData.xp = existingData.xp || 750;
        profileData.role_class = existingData.role_class || 'ARCHITECT';
        profileData.role_class_display = existingData.role_class_display || 'Cyber Architect';
        profileData.completedChallenges = existingData.completedChallenges || [1];
      } else {
        profileData.level = <%= userProfile ? userProfile.level : 2 %>;
        profileData.xp = <%= userProfile ? userProfile.xp : 750 %>;
        profileData.role_class = 'ARCHITECT';
        profileData.role_class_display = 'Cyber Architect';
        profileData.completedChallenges = [1];
        
        try {
          await setDoc(userRef, {
            ...profileData,
            createdAt: serverTimestamp()
          });
        } catch (sErr) {
          console.warn('Firestore write warning:', sErr);
        }
      }

      // Sync with Express backend session
      await fetch('/api/auth/session', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(profileData)
      });

      showToast(`GitHub operative @${githubHandle} successfully linked!`, '🐙', true);
      setTimeout(() => window.location.reload(), 1200);

    } catch (error) {
      console.warn('[Firebase GitHub Auth Error]', error.code, error.message);
      if (btn) btn.disabled = false;
      
      if (statusBanner) {
        statusBanner.className = 'alert alert-warning border border-warning small py-2 px-3 mb-0';
        if (error.code === 'auth/operation-not-allowed' || error.code === 'auth/configuration-not-found') {
          statusBanner.innerHTML = '⚠️ <strong>GitHub Provider Pending Activation:</strong> Enable GitHub in Firebase Console or use Quick Operative Link below to test immediately!';
        } else if (error.code === 'auth/popup-closed-by-user') {
          statusBanner.innerHTML = 'ℹ️ Popup closed before authorization was completed.';
        } else {
          statusBanner.innerHTML = `⚠️ ${error.message || 'Authentication error'}. You can link via direct handle below.`;
        }
      }
    }
  };

  // Direct GitHub handle linking (instant, verified via GitHub API)
  window.linkDirectGithubHandle = async function() {
    const handleInput = document.getElementById('inputGithubUsername');
    let handle = (handleInput?.value || '').trim().replace(/^@/, '');
    if (!handle) {
      showToast('Please enter a valid GitHub username', '⚠️', false);
      return;
    }

    const btn = document.getElementById('btnQuickLinkOperative');
    if (btn) btn.disabled = true;

    try {
      showToast(`Verifying @${handle} on GitHub...`, '🔍', true);
      let githubInfo = {
        login: handle,
        avatar_url: `https://github.com/${handle}.png`,
        name: handle
      };

      try {
        const ghResp = await fetch(`https://api.github.com/users/${handle}`);
        if (ghResp.ok) {
          const ghData = await ghResp.json();
          githubInfo.login = ghData.login || handle;
          githubInfo.avatar_url = ghData.avatar_url || githubInfo.avatar_url;
          githubInfo.name = ghData.name || ghData.login;
        }
      } catch (ghErr) {
        console.warn('GitHub API rate limit or network warning:', ghErr);
      }

      const instances = await getFirebaseInstances();
      const syntheticUid = 'gh_' + githubInfo.login.toLowerCase();

      let profileData = {
        uid: syntheticUid,
        username: githubInfo.login,
        displayName: githubInfo.name,
        email: `${githubInfo.login}@users.noreply.github.com`,
        avatar: githubInfo.avatar_url,
        authProvider: 'github',
        githubLinked: true,
        googleLinked: false,
        xp: <%= userProfile ? userProfile.xp : 750 %>,
        level: <%= userProfile ? userProfile.level : 2 %>,
        role_class: 'ARCHITECT',
        role_class_display: 'Cyber Architect',
        completedChallenges: [1]
      };

      // Persist to Firestore if available
      if (instances && instances.db) {
        try {
          const userRef = doc(instances.db, 'users', syntheticUid);
          const docSnap = await getDoc(userRef);
          if (docSnap.exists()) {
            const d = docSnap.data();
            profileData.xp = d.xp || profileData.xp;
            profileData.level = d.level || profileData.level;
            profileData.completedChallenges = d.completedChallenges || profileData.completedChallenges;
          } else {
            await setDoc(userRef, {
              ...profileData,
              createdAt: serverTimestamp()
            });
          }
        } catch (fErr) {
          console.warn('Firestore persistence notice:', fErr);
        }
      }

      // Sync with Express backend session
      const sessResp = await fetch('/api/auth/session', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(profileData)
      });

      if (sessResp.ok) {
        showToast(`Operative @${githubInfo.login} linked to platform!`, '🐙', true);
        setTimeout(() => window.location.reload(), 1000);
      } else {
        throw new Error('Session registration failed');
      }

    } catch (err) {
      console.error('Failed to link GitHub handle:', err);
      showToast('Failed to link GitHub account: ' + err.message, '✖', false);
      if (btn) btn.disabled = false;
    }
  };

  // Unified global open modal trigger
  window.openAuthModal = function() {
    const modalEl = document.getElementById('githubAuthModal');
    if (modalEl && typeof bootstrap !== 'undefined') {
      const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
      modal.show();
    }
    setTimeout(initGoogleIdentityServices, 250);
  };

  // Google sign in trigger
  window.signInWithGoogleAuth = function() {
    window.openAuthModal();
  };

  // GitHub sign in trigger
  window.signInWithFirebaseGitHub = function() {
    window.openAuthModal();
  };

  // Sign out handler - Trigger confirmation modal to prevent accidental session termination
  window.signOutFirebaseGitHub = function(e) {
    if (e && e.preventDefault) e.preventDefault();
    const modalEl = document.getElementById('logoutConfirmModal');
    if (modalEl && typeof bootstrap !== 'undefined') {
      const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
      modal.show();
    } else {
      const confirmed = window.confirm('TERMINATE SESSION: Disconnect operative session?');
      if (confirmed) {
        window.executeSignOutNow();
      }
    }
  };
  window.signOutOperative = window.signOutFirebaseGitHub;

  // Confirmed session termination executor
  window.executeSignOutNow = async function() {
    const confirmBtn = document.getElementById('btnConfirmTerminateSession');
    const abortBtn = document.getElementById('btnAbortLogout');
    
    if (confirmBtn) {
      confirmBtn.disabled = true;
      confirmBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> <span>TERMINATING...</span>';
    }
    if (abortBtn) {
      abortBtn.disabled = true;
    }

    try {
      showToast('Terminating operative session...', '🚪', true);
      const instances = await getFirebaseInstances();
      if (instances && instances.auth) {
        await signOut(instances.auth);
      }
      if (typeof google !== 'undefined' && google.accounts && google.accounts.id) {
        try {
          google.accounts.id.disableAutoSelect();
        } catch (gErr) {}
      }
      await fetch('/api/auth/logout', { method: 'POST' });
      showToast('Operative session terminated. Guest clearance restored.', '🚪', true);
      setTimeout(() => window.location.reload(), 700);
    } catch (err) {
      console.error('Logout error:', err);
      window.location.reload();
    }
  };

  // Cloud Firestore synchronization trigger: Saves CodeQuest career progress
  window.syncFirebaseCloudProgress = async function() {
    showToast('Synchronizing operative dossier with Firestore Cloud...', '⚡', true);
    try {
      const instances = await getFirebaseInstances();
      const uid = "<%= userProfile ? userProfile.uid : 'guest_operative_x' %>";
      
      const payload = {
        username: "<%= userProfile ? userProfile.username : 'Operative_X' %>",
        displayName: "<%= userProfile ? (userProfile.displayName || userProfile.username) : 'Operative X' %>",
        email: "<%= userProfile ? (userProfile.email || '') : '' %>",
        avatar: "<%= userProfile ? (userProfile.avatar || '') : '' %>",
        authProvider: "<%= userProfile ? (userProfile.authProvider || (userProfile.googleLinked ? 'google' : (userProfile.githubLinked ? 'github' : 'guest'))) : 'guest' %>",
        googleLinked: <%= (userProfile && userProfile.googleLinked) ? true : false %>,
        githubLinked: <%= (userProfile && userProfile.githubLinked) ? true : false %>,
        xp: <%= userProfile ? userProfile.xp : 750 %>,
        level: <%= userProfile ? userProfile.level : 2 %>,
        role_class: "<%= userProfile ? (userProfile.role_class || 'ARCHITECT') : 'ARCHITECT' %>",
        role_class_display: "<%= userProfile ? (userProfile.role_class_display || 'Cyber Architect') : 'Cyber Architect' %>",
        completedChallenges: <%- JSON.stringify((userProfile && userProfile.solved_submissions) ? userProfile.solved_submissions.map(s => s.challengeId) : [1]) %>,
        syncedAt: serverTimestamp()
      };

      if (instances && instances.db) {
        const userRef = doc(instances.db, 'users', uid);
        await setDoc(userRef, payload, { merge: true });
      }

      // Also update server session
      await fetch('/api/auth/save-progress', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          xp: <%= userProfile ? userProfile.xp : 750 %>,
          level: <%= userProfile ? userProfile.level : 2 %>,
          role_class: "<%= userProfile ? (userProfile.role_class || 'ARCHITECT') : 'ARCHITECT' %>",
          completedChallenges: <%- JSON.stringify((userProfile && userProfile.solved_submissions) ? userProfile.solved_submissions.map(s => s.challengeId) : [1]) %>
        })
      });

      showToast('Firestore cloud telemetry & CodeQuest progress synchronized!', '✔', true);
    } catch (err) {
      console.warn('Sync notice:', err);
      showToast('Progress synchronized to session.', '✔', true);
    }
  };

  // Initialize listener on page load
  getFirebaseInstances().then(instances => {
    if (instances && instances.auth) {
      onAuthStateChanged(instances.auth, (user) => {
        if (user) {
          console.log('[Firebase Auth] Active operative session detected:', user.uid);
        }
      });
    }
  });

  // Attempt GIS initialization on load and window focus
  window.addEventListener('load', () => {
    setTimeout(initGoogleIdentityServices, 300);
  });
</script>
