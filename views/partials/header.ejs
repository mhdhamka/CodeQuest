<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= typeof title !== 'undefined' ? title : 'CodeQuest Arena' %></title>
    <meta name="description" content="An interactive cyberpunk developer platform featuring RPG progression, real-time collaborative code rooms, and CTF security raid challenges.">
    <meta property="og:title" content="CodeQuest Arena">
    <meta property="og:description" content="An interactive cyberpunk developer platform featuring RPG progression, real-time collaborative code rooms, and CTF security raid challenges.">
    <!-- Google Fonts: JetBrains Mono & Fira Code -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600;700&family=JetBrains+Mono:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/static/css/custom.css">
    <!-- VS Code Codicons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@vscode/codicons@0.0.36/dist/codicon.min.css">
    <!-- Vue 3 & vue3-sfc-loader for native .vue Single-File Components -->
    <script src="/vendor/vue/vue.global.prod.js"></script>
    <script src="/vendor/vue3-sfc-loader/vue3-sfc-loader.js"></script>
    <script src="/static/js/vue-loader-helper.js"></script>
    <!-- Google Identity Services (GIS) OAuth Client SDK -->
    <script src="https://accounts.google.com/gsi/client" async defer></script>
</head>
<body class="<%= typeof fluidBody !== 'undefined' && fluidBody ? 'container-fluid px-2 px-md-3' : 'container' %>">
