<%- include('../partials/header', { title: 'Initialize & Configure Code Room' }) %>
<%- include('../partials/navbar', { activeNav: 'workspace' }) %>

<div class="container my-4">
  
  <!-- Section Header and Big Title -->
  <div class="text-center mb-5">
    <div class="mb-3">
      <span class="badge bg-black rounded-pill px-3 py-2 font-monospace small shadow-sm" style="color: #00e5ff; border: 1px solid #00e5ff; box-shadow: 0 0 10px rgba(0, 229, 255, 0.2);">
        // SECURE_OPERATIONS_COMMAND
      </span>
    </div>
    <h1 class="text-white fw-bold font-monospace tracking-wide display-5" style="text-shadow: 0 0 12px rgba(0, 229, 255, 0.4);">
      THE COLLABORATIVE WORKSPACE ARENA
    </h1>
    <p class="text-muted small font-monospace mt-2">
      [MISSION BRIEFING]: Initialize a secure real-time room with specific objectives, description details, and parameters to accelerate your development workflows.
    </p>
  </div>

  <!-- Room Creation Form Card -->
  <div class="mx-auto" style="max-width: 650px;">
    <div class="card text-white shadow-lg p-4 p-md-5" style="background-color: #0d1117 !important; border: 1px solid #00e5ff; box-shadow: 0 0 15px rgba(0, 229, 255, 0.2) !important;">
      <div class="d-flex align-items-center gap-2 mb-3 font-monospace small">
        <span class="badge bg-black px-2 py-1" style="color: #00e5ff; border: 1px solid #00e5ff;">🟢 NEW_ROOM_CONFIG</span>
        <span class="text-muted">// WORKSPACE_DEPLOYMENT</span>
      </div>
      
      <h2 class="h4 fw-bold font-monospace mb-4" style="color: #00e5ff;">Initialize & Configure Code Room</h2>
      
      <form method="POST" action="/workspace/room/create/" class="font-monospace">
        <div class="mb-4">
          <label for="id_name" class="form-label text-light small">// ROOM NAME</label>
          <input type="text" name="name" id="id_name" class="form-control" placeholder="e.g. Sprint Hackathon: eBPF Telemetry" required>
          <div class="form-text text-muted small mt-1">Designate a recognizable title for this session.</div>
        </div>

        <div class="mb-4">
          <label for="id_description" class="form-label text-light small">// DESCRIPTION</label>
          <textarea name="description" id="id_description" class="form-control" rows="4" placeholder="Describe the objectives or scope of the room..."></textarea>
          <div class="form-text text-muted small mt-1">Describe the objectives or scope of the room.</div>
        </div>

        <div class="mb-4">
          <label for="id_focus" class="form-label text-light small">// FOCUS / TECH STACK</label>
          <input type="text" name="focus" id="id_focus" class="form-control" placeholder="e.g. Python / Django / WebSockets">
          <div class="form-text text-muted small mt-1">Primary technology stack or focus area.</div>
        </div>

        <!-- Deployment Helper Note -->
        <div class="mb-4 p-3 bg-black border border-secondary rounded small text-muted">
          <code>&gt; TIP: Add a detailed room description or objective so teammates instantly understand the focus of the sprint session or bug fix.</code>
        </div>
        
        <div class="d-flex justify-content-between align-items-center mt-4">
          <a href="/workspace/" class="btn btn-sm btn-outline-secondary font-monospace">← Cancel</a>
          <button type="submit" class="btn fw-bold px-4 font-monospace shadow" style="background-color: #00e5ff; color: #000; border: none;">
            [ DEPLOY ROOM ] →
          </button>
        </div>
      </form>
    </div>
  </div>

</div>

<!-- CSS Overrides to match Cyberpunk Dark Theme -->
<style>
  input[type="text"], textarea {
    display: block;
    width: 100%;
    padding: 0.6rem 0.75rem;
    font-size: 0.9rem;
    font-family: var(--bs-font-monospace);
    color: #fff !important;
    background-color: #000 !important;
    border: 1px solid #00e5ff !important;
    border-radius: 0.375rem;
    transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
  }
  input[type="text"]:focus, textarea:focus {
    color: #fff !important;
    background-color: #000 !important;
    border-color: #ffb700 !important;
    outline: 0;
    box-shadow: 0 0 10px rgba(0, 229, 255, 0.4);
  }
  textarea {
    resize: vertical;
    min-height: 110px;
  }
</style>

<%- include('../partials/footer') %>
