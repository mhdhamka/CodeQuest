<%- include('../partials/header', { title: 'CodeQuest // GitHub Codespaces' }) %>
<%- include('../partials/navbar', { activeNav: 'workspace' }) %>

<div class="container my-4">
  
  <!-- Header: Codespaces Management -->
  <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <i class="codicon codicon-vscode text-info fs-3"></i>
        <h1 class="h3 fw-bold text-light mb-0">VS Code Codespaces</h1>
        <span class="badge bg-black border border-secondary text-muted"><%= rooms ? rooms.length : 0 %> Codespaces</span>
      </div>
      <p class="text-muted small mb-0 font-monospace">
        Cloud developer environments powered by the Monaco Editor with real-time multiplayer synchronization, Go 1.22, and Vue 3 SFC.
      </p>
    </div>

    <div class="d-flex align-items-center gap-2">
      <a href="/workspace/create/" class="btn btn-sm btn-gh-primary font-monospace d-flex align-items-center gap-1">
        <i class="codicon codicon-plus"></i>
        <span>New Codespace</span>
      </a>
    </div>
  </div>

  <!-- Search & Filter Bar -->
  <div class="p-3 rounded border mb-4" style="background: var(--gh-canvas-default); border-color: var(--gh-border-default) !important;">
    <div class="row g-2 align-items-center">
      <div class="col-md-7">
        <div class="input-group input-group-sm">
          <span class="input-group-text bg-dark border-secondary text-muted">
            <i class="codicon codicon-search"></i>
          </span>
          <input type="text" id="roomSearchInput" class="form-control bg-dark text-light border-secondary font-monospace" placeholder="Filter codespaces by name, focus, or runtime (e.g. go, vue, python)...">
        </div>
      </div>
      <div class="col-md-5 d-flex justify-content-md-end gap-2">
        <a href="/workspace/1?lang=go" class="btn btn-sm btn-gh-secondary font-monospace d-flex align-items-center gap-1 text-light">
          <i class="codicon codicon-file-code text-go"></i> Quick Go (.go)
        </a>
        <a href="/workspace/1?lang=vue" class="btn btn-sm btn-gh-secondary font-monospace d-flex align-items-center gap-1 text-light">
          <i class="codicon codicon-symbol-class text-vue"></i> Quick Vue (.vue)
        </a>
      </div>
    </div>
  </div>

  <!-- Active Codespaces Grid (GitHub Codespaces Style) -->
  <div class="row g-3 mb-5" id="roomContainer">
    <% if (rooms && rooms.length > 0) { %>
      <% rooms.forEach(function(room) { 
          var roomFocus = (room.focus || '').toLowerCase();
          var isGo = roomFocus.includes('go');
          var isVue = roomFocus.includes('vue');
      %>
        <div class="col-md-6 col-lg-4 room-card-item" 
             data-room-name="<%= (room.name || '').toLowerCase() %>" 
             data-room-desc="<%= (room.description || '').toLowerCase() %>" 
             data-room-focus="<%= (room.focus || '').toLowerCase() %>">
          <div class="card h-100 rounded border p-3 font-monospace d-flex flex-column justify-content-between" style="background: var(--gh-canvas-default); border-color: var(--gh-border-default) !important;">
            <div>
              <!-- Top Metadata -->
              <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="d-flex align-items-center gap-2">
                  <span class="status-indicator-dot"></span>
                  <span class="text-success small fw-bold">Active</span>
                  <span class="badge bg-black border border-secondary text-muted small">Port 3000</span>
                </div>
                <div class="dropdown">
                  <button class="btn btn-link text-muted p-0" type="button" data-bs-toggle="dropdown">
                    <i class="codicon codicon-kebab-vertical"></i>
                  </button>
                  <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end font-monospace small">
                    <li><a class="dropdown-item" href="/workspace/rooms/<%= room.id %>/edit/"><i class="codicon codicon-edit me-1"></i> Edit Details</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                      <button class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#deleteModal<%= room.id %>">
                        <i class="codicon codicon-trash me-1"></i> Delete Codespace
                      </button>
                    </li>
                  </ul>
                </div>
              </div>

              <!-- Codespace Title -->
              <h5 class="text-light fw-bold mb-1 text-truncate" style="font-size: 0.95rem;">
                <a href="/workspace/<%= room.id %>" class="text-light text-decoration-none">
                  <%= room.name %>
                </a>
              </h5>

              <!-- Git Branch & Runtime -->
              <div class="d-flex align-items-center gap-2 text-muted small mb-2" style="font-size: 0.72rem;">
                <span class="d-flex align-items-center gap-1">
                  <i class="codicon codicon-git-branch"></i> main
                </span>
                <span>•</span>
                <% if (isGo) { %>
                  <span class="badge badge-go"><i class="codicon codicon-file-code"></i> Go 1.22</span>
                <% } else if (isVue) { %>
                  <span class="badge badge-vue"><i class="codicon codicon-symbol-class"></i> Vue 3 SFC</span>
                <% } else if (room.focus) { %>
                  <span class="badge bg-black border border-secondary text-light"><%= room.focus %></span>
                <% } else { %>
                  <span class="badge badge-go">Go / Vue / TS</span>
                <% } %>
              </div>

              <!-- Description -->
              <% if (room.description) { %>
                <p class="text-muted small mb-3" style="line-height: 1.4; font-size: 0.76rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                  <%= room.description %>
                </p>
              <% } %>
            </div>

            <!-- Bottom Actions -->
            <div class="pt-2 border-top d-flex gap-2" style="border-color: var(--gh-border-default) !important;">
              <a href="/workspace/<%= room.id %>" class="btn btn-sm btn-gh-primary font-monospace flex-grow-1 d-flex align-items-center justify-content-center gap-1">
                <i class="codicon codicon-vscode"></i>
                <span>Open in VS Code</span>
              </a>
              <a href="/workspace/rooms/<%= room.id %>/edit/" class="btn btn-sm btn-gh-secondary text-light" title="Configure">
                <i class="codicon codicon-settings-gear"></i>
              </a>
            </div>
          </div>
        </div>

        <!-- Delete Modal -->
        <div class="modal fade font-monospace" id="deleteModal<%= room.id %>" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark border-danger text-white">
              <div class="modal-header border-danger">
                <h5 class="modal-title text-danger fs-6"><i class="codicon codicon-warning me-1"></i> Delete Codespace #<%= room.id %></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
              </div>
              <div class="modal-body text-muted small">
                Are you sure you want to terminate <strong class="text-light"><%= room.name %></strong>? Collaborative buffer and peer sync records will be deleted.
              </div>
              <div class="modal-footer border-danger">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="POST" action="/workspace/room/<%= room.id %>/delete/">
                  <button type="submit" class="btn btn-sm btn-danger fw-bold">Delete Codespace</button>
                </form>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div class="col-12" id="noRoomsPlaceholder">
        <div class="p-4 rounded border text-center font-monospace text-muted" style="background: var(--gh-canvas-default); border-color: var(--gh-border-default) !important;">
          <i class="codicon codicon-vscode fs-3 mb-2 text-info"></i>
          <div>No active Codespaces found.</div>
          <a href="/workspace/create/" class="btn btn-sm btn-gh-primary mt-2">+ Create First Codespace</a>
        </div>
      </div>
    <% } %>
  </div>

  <!-- Quick Start Language Templates -->
  <div class="border-top pt-4" style="border-color: var(--gh-border-default) !important;">
    <div class="d-flex align-items-center gap-2 mb-3">
      <i class="codicon codicon-sparkle text-warning fs-4"></i>
      <h2 class="h5 fw-bold text-light mb-0">Quick Start from Template</h2>
    </div>

    <div class="row g-3">
      <!-- Go Template -->
      <div class="col-md-6 col-lg-3">
        <div class="p-3 rounded border font-monospace h-100 d-flex flex-column justify-content-between" style="background: var(--gh-canvas-default); border-color: var(--gh-border-default) !important;">
          <div>
            <div class="d-flex align-items-center gap-2 mb-2">
              <i class="codicon codicon-file-code text-go fs-4"></i>
              <div>
                <strong class="text-light d-block" style="font-size: 0.85rem;">Go Concurrency Microservice</strong>
                <span class="badge badge-go" style="font-size: 0.6rem;">main.go</span>
              </div>
            </div>
            <p class="text-muted small mb-3" style="font-size: 0.74rem;">
              Goroutines, Mutex synchronization, channel pipelines, and race-detection sandbox.
            </p>
          </div>
          <a href="/workspace/1?lang=go" class="btn btn-sm btn-gh-secondary text-light w-100 text-center">
            Launch Go Template
          </a>
        </div>
      </div>

      <!-- Vue Template -->
      <div class="col-md-6 col-lg-3">
        <div class="p-3 rounded border font-monospace h-100 d-flex flex-column justify-content-between" style="background: var(--gh-canvas-default); border-color: var(--gh-border-default) !important;">
          <div>
            <div class="d-flex align-items-center gap-2 mb-2">
              <i class="codicon codicon-symbol-class text-vue fs-4"></i>
              <div>
                <strong class="text-light d-block" style="font-size: 0.85rem;">Vue 3 SFC Reactive App</strong>
                <span class="badge badge-vue" style="font-size: 0.6rem;">App.vue</span>
              </div>
            </div>
            <p class="text-muted small mb-3" style="font-size: 0.74rem;">
              Single File Components with script setup, scoped CSS, and live reactive virtual DOM preview.
            </p>
          </div>
          <a href="/workspace/1?lang=vue" class="btn btn-sm btn-gh-secondary text-light w-100 text-center">
            Launch Vue Template
          </a>
        </div>
      </div>

      <!-- TypeScript Template -->
      <div class="col-md-6 col-lg-3">
        <div class="p-3 rounded border font-monospace h-100 d-flex flex-column justify-content-between" style="background: var(--gh-canvas-default); border-color: var(--gh-border-default) !important;">
          <div>
            <div class="d-flex align-items-center gap-2 mb-2">
              <i class="codicon codicon-file-code text-info fs-4"></i>
              <div>
                <strong class="text-light d-block" style="font-size: 0.85rem;">TypeScript Distributed Node</strong>
                <span class="badge bg-black border border-secondary text-muted" style="font-size: 0.6rem;">handler.ts</span>
              </div>
            </div>
            <p class="text-muted small mb-3" style="font-size: 0.74rem;">
              Type-safe telemetry handlers, CRDT delta synchronization, and modern ECMAScript decorators.
            </p>
          </div>
          <a href="/workspace/1?lang=typescript" class="btn btn-sm btn-gh-secondary text-light w-100 text-center">
            Launch TS Template
          </a>
        </div>
      </div>

      <!-- Python Security Audit Template -->
      <div class="col-md-6 col-lg-3">
        <div class="p-3 rounded border font-monospace h-100 d-flex flex-column justify-content-between" style="background: var(--gh-canvas-default); border-color: var(--gh-border-default) !important;">
          <div>
            <div class="d-flex align-items-center gap-2 mb-2">
              <i class="codicon codicon-file-code text-warning fs-4"></i>
              <div>
                <strong class="text-light d-block" style="font-size: 0.85rem;">Python Security Audit</strong>
                <span class="badge bg-black border border-secondary text-muted" style="font-size: 0.6rem;">solution.py</span>
              </div>
            </div>
            <p class="text-muted small mb-3" style="font-size: 0.74rem;">
              Cryptographic hash verification, vulnerability exploit reproduction, and automated patch testing.
            </p>
          </div>
          <a href="/workspace/1?lang=python" class="btn btn-sm btn-gh-secondary text-light w-100 text-center">
            Launch Python Template
          </a>
        </div>
      </div>
    </div>
  </div>

</div>

<script>
  // Live filter codespaces by name or focus
  const searchInput = document.getElementById('roomSearchInput');
  const cards = document.querySelectorAll('.room-card-item');

  if (searchInput) {
    searchInput.addEventListener('input', function() {
      const q = (this.value || '').toLowerCase().trim();
      cards.forEach(card => {
        const name = card.getAttribute('data-room-name') || '';
        const desc = card.getAttribute('data-room-desc') || '';
        const focus = card.getAttribute('data-room-focus') || '';
        const matches = name.includes(q) || desc.includes(q) || focus.includes(q);
        card.style.display = matches ? '' : 'none';
      });
    });
  }
</script>

<%- include('../partials/footer') %>
