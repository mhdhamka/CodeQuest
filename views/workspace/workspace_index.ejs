<%- include('../partials/header', { title: 'Collaborative Workspace Arena' }) %>
<%- include('../partials/navbar', { activeNav: 'workspace' }) %>

<div class="container my-4">
  <!-- Hero Header / Game Mission Briefing -->
  <div class="row mb-5 text-center">
    <div class="col">
      <div class="d-inline-block border border-info bg-black px-3 py-1 rounded-pill mb-3 shadow-sm">
        <span class="text-info font-monospace small tracking-widest">// SECURE_OPERATIONS_COMMAND</span>
      </div>
      <h1 class="display-4 fw-bold text-light font-monospace" style="text-shadow: 0 0 25px rgba(13, 202, 240, 0.4);">
        THE COLLABORATIVE WORKSPACE ARENA
      </h1>
      <p class="lead text-muted font-monospace mt-3 mx-auto" style="font-size: 0.95rem; max-width: 700px; line-height: 1.7;">
        [MISSION BRIEFING]: Co-author code in real-time rooms, build cheatsheets together, and accelerate your development workflows in team sprint hackathons.
      </p>
    </div>
  </div>

  <!-- Live Activity Ticker -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="bg-black border border-success p-2 rounded font-monospace small text-success overflow-hidden shadow-sm d-flex align-items-center">
        <span class="badge bg-success text-dark me-2">BROADCAST</span>
        <marquee scrollamount="4" class="text-light">
          &gt;&gt; System status: Optimal. // New sprint hackathon rooms initialized. // Secure your code repositories and sync with teammates in real-time.
        </marquee>
      </div>
    </div>
  </div>

  <!-- Main Workspace Card & Quick Room Creator -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card bg-dark border-success text-white shadow-lg position-relative overflow-hidden hover-lift" style="background-color: #12161f !important;">
        <div class="position-absolute top-0 start-0 w-100 bg-success" style="height: 3px;"></div>
        <div class="card-body p-4 p-md-5 d-flex flex-column flex-md-row align-items-center justify-content-between gap-4">
          <div>
            <div class="d-flex align-items-center gap-2 mb-2 font-monospace small">
              <span class="badge bg-black border border-success text-success px-2 py-1">🟢 LIVE_SYNC_ACTIVE</span>
              <span class="text-muted">// MULTIPLAYER_CODE_LINK</span>
            </div>
            <h3 class="card-title h4 text-success fw-bold font-monospace mb-2">Sync & Conquer Together</h3>
            <p class="card-text text-muted small font-monospace mb-0" style="max-width: 650px; line-height: 1.6;">
              Drop into real-time rooms to co-author code, build cheatsheets together, and race against the clock in team sprint hackathons.
            </p>
          </div>
          <div class="text-nowrap d-flex flex-column gap-2">
            <a href="/workspace/room/create/" class="btn btn-success font-monospace fw-bold px-4 py-2 shadow">
              + [ NEW CODE ROOM ]
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- CREATED ROOMS SECTION WITH LIVE SEARCH FILTER -->
  <div class="row align-items-center mb-3 g-2">
    <div class="col-md-6">
      <h3 class="h5 text-info font-monospace d-flex align-items-center gap-2 mb-0">
        <span></span> ACTIVE_CREATED_ROOMS <span class="badge bg-secondary text-dark font-monospace" id="roomCountBadge"><%= rooms.length %> Active</span>
      </h3>
    </div>
    <!-- Live Search Input -->
    <div class="col-md-6">
      <input type="text" id="roomSearchInput" class="form-control form-control-sm bg-dark text-light border-info font-monospace" placeholder="> Search rooms by name, description, or focus...">
    </div>
  </div>

  <div class="row g-3 mb-5" id="roomContainer">
    <% if (rooms && rooms.length > 0) { %>
      <% rooms.forEach(function(room) { %>
        <div class="col-md-4 room-card-item" 
             data-room-name="<%= (room.name || '').toLowerCase() %>" 
             data-room-desc="<%= (room.description || '').toLowerCase() %>" 
             data-room-focus="<%= (room.focus || '').toLowerCase() %>">
          <div class="card bg-dark border-info text-white h-100 shadow-sm" style="background-color: #12161f !important;">
            <div class="card-body d-flex flex-column justify-content-between p-3 font-monospace">
              <div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="badge bg-black border border-info text-info small">ROOM #<%= room.id %></span>
                  <span class="text-muted small"><%= new Date(room.created_at).toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' }) %></span>
                </div>
                <h5 class="text-light fw-bold text-truncate mb-2"><%= room.name %></h5>
                
                <!-- Dynamic Description Display -->
                <% if (room.description) { %>
                  <p class="text-muted small mb-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis;">
                    <%= room.description %>
                  </p>
                <% } %>

                <!-- Dynamic Focus / Tech Stack Badge -->
                <% if (room.focus) { %>
                  <div class="mb-3">
                    <span class="badge bg-secondary text-dark font-monospace" style="font-size: 0.7rem;">// <%= room.focus %></span>
                  </div>
                <% } %>
              </div>
              
              <!-- Room Action Buttons: Access + Edit + Delete -->
              <div class="d-flex gap-2">
                <a href="/workspace/room/<%= room.id %>/" class="btn btn-sm btn-outline-info font-monospace fw-bold flex-grow-1">
                  [ ACCESS ] →
                </a>
                <a href="/workspace/rooms/<%= room.id %>/edit/" class="btn btn-sm btn-outline-warning font-monospace" title="Edit Room Details">
                  [ EDIT ]
                </a>
                <!-- Delete Button Trigger -->
                <button type="button" class="btn btn-sm btn-outline-danger font-monospace" data-bs-toggle="modal" data-bs-target="#deleteModal<%= room.id %>" title="Terminate Room">
                  ✖
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Delete Confirmation Modal per Room -->
        <div class="modal fade font-monospace" id="deleteModal<%= room.id %>" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark border-danger text-white">
              <div class="modal-header border-danger">
                <h5 class="modal-title text-danger fs-6">⚠️ TERMINATE_ROOM [ #<%= room.id %> ]</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <div class="modal-body text-muted small">
                Are you sure you want to delete <strong class="text-light"><%= room.name %></strong>? This action cannot be undone.
              </div>
              <div class="modal-footer border-danger">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="POST" action="/workspace/room/<%= room.id %>/delete/">
                  <button type="submit" class="btn btn-sm btn-danger fw-bold">[ CONFIRM DELETION ]</button>
                </form>
              </div>
            </div>
          </div>
        </div>

      <% }); %>
    <% } else { %>
      <div class="col-12" id="noRoomsPlaceholder">
        <div class="p-4 bg-dark border border-secondary text-center text-muted font-monospace rounded">
          <code>&gt; No active rooms initialized yet. Click "+ New Code Room" above to spin up your first session.</code>
        </div>
      </div>
    <% } %>
  </div>

  <!-- Additional Feature Grid -->
  <div class="row g-4 mb-5">
    <div class="col-md-4">
      <div class="card h-100 bg-dark border-info text-white shadow-lg position-relative overflow-hidden" style="background-color: #12161f !important;">
        <div class="position-absolute top-0 start-0 w-100 bg-info" style="height: 3px;"></div>
        <div class="card-body p-4 d-flex flex-column justify-content-between">
          <div>
            <div class="d-flex align-items-center gap-2 mb-3 font-monospace small">
              <span class="badge bg-black border border-info text-info px-2 py-1">⚡ QUICK_DEPLOY</span>
            </div>
            <h5 class="card-title text-info fw-bold font-monospace mb-2">Instant Room Spin-Up</h5>
            <p class="card-text text-muted small font-monospace mb-4">
              Launch a fresh co-authoring code room or an impromptu sprint session immediately.
            </p>
          </div>
          <div class="d-grid gap-2">
            <a href="/workspace/room/create/" class="btn btn-sm btn-outline-info font-monospace fw-bold">
              + New Code Room
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card h-100 bg-dark border-warning text-white shadow-lg position-relative overflow-hidden" style="background-color: #12161f !important;">
        <div class="position-absolute top-0 start-0 w-100 bg-warning" style="height: 3px;"></div>
        <div class="card-body p-4 d-flex flex-column justify-content-between">
          <div>
            <div class="d-flex align-items-center gap-2 mb-3 font-monospace small">
              <span class="badge bg-black border border-warning text-warning px-2 py-1">📡 LIVE_TELEMETRY</span>
            </div>
            <h5 class="card-title text-warning fw-bold font-monospace mb-2">Active Collaborators</h5>
            <p class="card-text text-muted small font-monospace mb-3">
              Real-time peer presence and cursor tracking across all active development sectors.
            </p>
          </div>
          <div class="mt-auto">
            <span class="badge bg-black border border-warning text-warning font-monospace px-3 py-2 w-100 text-center">
              ● 24 PEERS CONNECTED
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card h-100 bg-dark border-danger text-white shadow-lg position-relative overflow-hidden" style="background-color: #12161f !important;">
        <div class="position-absolute top-0 start-0 w-100 bg-danger" style="height: 3px;"></div>
        <div class="card-body p-4 d-flex flex-column justify-content-between">
          <div>
            <div class="d-flex align-items-center gap-2 mb-3 font-monospace small">
              <span class="badge bg-black border border-danger text-danger px-2 py-1">🛡️ COMBAT_ZONE</span>
            </div>
            <h5 class="card-title text-danger fw-bold font-monospace mb-2">Security Raids</h5>
            <p class="card-text text-muted small font-monospace mb-3">
              Team up with developers to hunt vulnerabilities, extract flags, and level up your operative dossier.
            </p>
          </div>
          <div class="d-grid gap-2">
            <a href="/projects/" class="btn btn-sm btn-outline-danger font-monospace fw-bold">
              Access Combat Zone →
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>

<!-- Client-side Realtime Room Filter Script -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('roomSearchInput');
    const roomCards = document.querySelectorAll('.room-card-item');

    if (searchInput) {
      searchInput.addEventListener('input', function() {
        const query = this.value.trim().toLowerCase();
        let visibleCount = 0;

        roomCards.forEach(function(card) {
          const name = card.getAttribute('data-room-name') || '';
          const desc = card.getAttribute('data-room-desc') || '';
          const focus = card.getAttribute('data-room-focus') || '';

          if (name.includes(query) || desc.includes(query) || focus.includes(query)) {
            card.style.display = '';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        const badge = document.getElementById('roomCountBadge');
        if (badge) {
          badge.innerText = visibleCount + ' Active';
        }
      });
    }
  });
</script>

<%- include('../partials/footer') %>
