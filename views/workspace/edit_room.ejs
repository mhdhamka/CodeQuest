<%- include('../partials/header', { title: 'Edit Room Settings // #' + room.id }) %>
<%- include('../partials/navbar', { activeNav: 'workspace' }) %>

<div class="container my-4" style="max-width: 650px;">
  
  <div class="card bg-dark border-warning text-white shadow-lg p-4 p-md-5" style="background-color: #12161f !important; box-shadow: 0 0 20px rgba(255, 183, 0, 0.15) !important;">
    
    <div class="mb-4 text-center">
      <span class="badge bg-black border border-warning text-warning px-3 py-1 font-monospace small mb-2">⚙️ CONFIGURATION_PANEL</span>
      <h2 class="h3 fw-bold font-monospace text-light">Edit Room Settings</h2>
      <p class="text-muted small font-monospace">Update identifiers, parameters, and focus areas for Room #<%= room.id %></p>
    </div>

    <!-- Edit Form -->
    <form method="POST" action="/workspace/rooms/<%= room.id %>/edit/" class="font-monospace">
      
      <!-- Room Name -->
      <div class="mb-3">
        <label for="id_name" class="form-label text-warning small">// ROOM_NAME</label>
        <input type="text" name="name" id="id_name" class="form-control" value="<%= room.name %>" required>
      </div>

      <!-- Room Description -->
      <div class="mb-3">
        <label for="id_description" class="form-label text-warning small">// DESCRIPTION</label>
        <textarea name="description" id="id_description" class="form-control" rows="4"><%= room.description || '' %></textarea>
      </div>

      <!-- Room Focus / Tech Stack -->
      <div class="mb-4">
        <label for="id_focus" class="form-label text-warning small">// FOCUS / TECH STACK</label>
        <input type="text" name="focus" id="id_focus" class="form-control" value="<%= room.focus || '' %>">
      </div>

      <div class="d-flex justify-content-between align-items-center mt-4">
        <a href="/workspace/room/<%= room.id %>/" class="btn btn-sm btn-outline-secondary font-monospace">
          ← Cancel
        </a>
        <button type="submit" class="btn btn-warning font-monospace fw-bold px-4 text-dark shadow">
          [ SAVE CHANGES ]
        </button>
      </div>
    </form>

  </div>

</div>

<!-- Custom CSS Overrides to match Warning Theme -->
<style>
  input[type="text"], textarea {
    display: block;
    width: 100%;
    padding: 0.6rem 0.75rem;
    font-size: 0.9rem;
    font-family: var(--bs-font-monospace);
    color: #fff !important;
    background-color: #000 !important;
    border: 1px solid #ffb700 !important;
    border-radius: 0.375rem;
  }
  input[type="text"]:focus, textarea:focus {
    color: #fff !important;
    background-color: #000 !important;
    border-color: #ffb700 !important;
    outline: 0;
    box-shadow: 0 0 10px rgba(255, 183, 0, 0.4);
  }
  textarea {
    resize: vertical;
    min-height: 100px;
  }
</style>

<%- include('../partials/footer') %>
