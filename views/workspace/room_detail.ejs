  // Language Switcher Function (supports Go, Vue, Python, etc.)
  window.selectWorkspaceLanguage = function(langKey) {
    const conf = languageConfigs[langKey] || languageConfigs.python;
    if (languageSelect) languageSelect.value = langKey;
    if (activeFileName) activeFileName.innerText = conf.filename;
    if (statusLangName) statusLangName.innerText = conf.label;
    if (breadcrumbFilename) breadcrumbFilename.innerText = conf.filename;
    if (titlebarActiveFile) titlebarActiveFile.innerText = conf.filename;
    if (activeRuntimeBadge) activeRuntimeBadge.innerText = conf.runtime;

    // Update active tab styles
    document.querySelectorAll('#editorTabsBar .vscode-tab').forEach(tab => {
      if (tab.getAttribute('data-lang') === langKey) {
        tab.classList.add('active');
      } else {
        tab.classList.remove('active');
      }
    });

    // Update explorer file items
    document.querySelectorAll('.vscode-file-item').forEach(item => {
      if (item.getAttribute('data-lang') === langKey) {
        item.classList.add('active');
      } else {
        item.classList.remove('active');
      }
    });

    // Update Monaco language model
    if (codeEditor && window.monaco) {
      const model = codeEditor.getModel();
      const monacoLang = langKey === 'vue' ? 'html' : langKey;
      window.monaco.editor.setModelLanguage(model, monacoLang);

      // If editor currently has default template or empty, load new template
      const currentCode = codeEditor.getValue().trim();
      const isDefaultCode = Object.values(languageConfigs).some(c => c.template.trim() === currentCode);
      if (isDefaultCode || currentCode === '') {
        codeEditor.setValue(conf.template);
        broadcastLocalEdit();
      }

      // If Vue is selected, render component preview
      if (langKey === 'vue') {
        renderVueComponentPreview(codeEditor.getValue());
      }
