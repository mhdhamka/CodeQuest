  // BroadcastChannel Setup for instant local tab synchronization
  try {
    broadcastChannel = new BroadcastChannel('codequest_room_' + roomId);
    broadcastChannel.onmessage = (event) => {
      const data = event.data;
      if (!data) return;

      if (data.type === 'code_update' && data.sender !== currentUser) {
        handleRemoteCode(data.code, data.sender);
      } else if (data.type === 'cursor_move' && data.sender !== currentUser) {
        handleRemoteCursor(data);
      } else if (data.type === 'lock_update') {
        applyLockState(data.isLocked);
      } else if (data.type === 'timer_sync') {
        handleRemoteTimerSync(data);
      } else if (data.type === 'container_run') {
        appendConsoleLog(data.log);
      }
    };
  } catch (e) {
    console.warn('BroadcastChannel not supported in this browser environment:', e);
  }

  // Predefined Challenges and Solved Submissions
  const allChallenges = <%- JSON.stringify(challenges || []) %>;
  const userSolvedSubmissions = <%- JSON.stringify(userProfile?.solved_submissions || []) %>;
  const userSolvedChallengeIds = new Set(userSolvedSubmissions.filter(s => s.is_correct).map(s => Number(s.challengeId)));
  let selectedChallenge = allChallenges.length > 0 ? allChallenges[0] : null;
  let isSubmittingChallenge = false;

  // Mission Urgency Countdown Timer State
  let timerInterval = null;
  let timerTotalSeconds = selectedChallenge ? (selectedChallenge.time_limit_seconds || 300) : 300;
  let timerSecondsRemaining = timerTotalSeconds;
