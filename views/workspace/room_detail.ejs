  // Live Vue SFC Component Renderer
  function renderVueComponentPreview(code) {
    const container = document.getElementById('vueComponentPreviewArea');
    if (!container) return;

    if (!code || !code.includes('<template>')) {
      container.innerHTML = `
        <div class="text-muted text-center py-4 font-monospace small">
          <i class="codicon codicon-symbol-class text-vue fs-3 mb-2"></i><br>
          Select or write a Vue 3 SFC component in <code>App.vue</code> to render live.
        </div>
      `;
      return;
    }

    // Extract template and style
    const templateMatch = code.match(/<template>([\s\S]*?)<\/template>/);
    const styleMatch = code.match(/<style[^>]*>([\s\S]*?)<\/style>/);

    let templateHtml = templateMatch ? templateMatch[1] : '<p>No template found</p>';
    let customCss = styleMatch ? styleMatch[1] : '';

    // Simple template interpolation replacement
    templateHtml = templateHtml
      .replace(/\{\{\s*workspaceTitle\s*\}\}/g, "<%= room.name %> // Vue Room")
      .replace(/\{\{\s*title\s*\}\}/g, "<%= room.name %> // Vue Component")
      .replace(/\{\{\s*status\s*\}\}/g, "LIVE_IN_SYNC")
      .replace(/\{\{\s*syncCount\s*\}\}/g, "42")
      .replace(/\{\{\s*latency\s*\}\}/g, "16")
      .replace(/\{\{\s*syncCount \+ 1\s*\}\}/g, "43");

    container.innerHTML = `
      <style>${customCss}</style>
      <div class="vue-mount-sandbox">
        ${templateHtml}
      </div>
    `;

    // Attach click events for any button inside the preview
    container.querySelectorAll('button').forEach(btn => {
      btn.addEventListener('click', () => {
        const span = container.querySelector('.status-badge strong') || container.querySelector('strong');
        if (span) {
          span.innerText = 'TRANSMITTED_PULSE_ACK';
          setTimeout(() => { span.innerText = 'IN_SYNC'; }, 900);
        }
        btn.style.transform = 'scale(0.97)';
        setTimeout(() => { btn.style.transform = 'scale(1)'; }, 150);
      });
    });
  }

  function handleRemoteCode(newCode, lastEditor) {
    if (newCode === undefined) return;
    const currentCode = codeEditor ? codeEditor.getValue() : scratchpad.value;
    if (newCode === currentCode) return;

    isApplyingRemoteEdit = true;
    if (codeEditor) {
      const prevPosition = codeEditor.getPosition();
      codeEditor.setValue(newCode);
      if (prevPosition) {
        try { codeEditor.setPosition(prevPosition); } catch (e) {}
      }
      updateStatusMetrics();
    }
    scratchpad.value = newCode;
    isApplyingRemoteEdit = false;

    flashEditorBorder();

    if (peerTypingBadge) {
      peerTypingBadge.innerText = `⚡ ${lastEditor || 'Peer'} updated buffer`;
      peerTypingBadge.classList.remove('d-none');
      setTimeout(() => peerTypingBadge.classList.add('d-none'), 2500);
    }
    if (peerStatusDisplay) {
      peerStatusDisplay.innerText = 'SYNCED';
      peerStatusDisplay.className = 'text-success small fw-bold';
    }
    addTelemetry(`[SYNC] Buffer synced from @${lastEditor || 'collaborator'}`);
  }

  function handleRemoteCursor(data) {
    if (!codeEditor || !window.monaco) return;
    const { sender, line, column } = data;
    try {
      peerCursorDecorations = codeEditor.deltaDecorations(peerCursorDecorations, [
        {
          range: new window.monaco.Range(line, column, line, column),
          options: {
            className: 'peer-remote-cursor-line',
            glyphMarginClassName: 'peer-cursor-glyph-marker',
            hoverMessage: { value: `**@${sender}** active here` }
          }
        }
      ]);
    } catch (e) {}

    if (statusPeerActive && statusPeerText) {
      statusPeerText.innerText = `@${sender} @ Ln ${line}, Col ${column}`;
      statusPeerActive.classList.remove('d-none');
      clearTimeout(statusPeerActive._timer);
      statusPeerActive._timer = setTimeout(() => {
        statusPeerActive.classList.add('d-none');
      }, 3000);
    }
  }

  function applyLockState(locked) {
    isLocked = !!locked;
    if (codeEditor) codeEditor.updateOptions({ readOnly: isLocked });
    if (isLocked) {
      scratchpad.setAttribute('readonly', 'true');
      classroomLockBanner.classList.remove('d-none');
      lockModeBtn.innerText = 'Host: Locked';
      lockModeBtn.className = 'btn btn-sm btn-danger font-monospace';
      if (statusLockBadge) statusLockBadge.innerText = '🔒 HOST: LOCKED';
    } else {
      scratchpad.removeAttribute('readonly');
      classroomLockBanner.classList.add('d-none');
      lockModeBtn.innerText = 'Host: Unlocked';
      lockModeBtn.className = 'btn btn-sm btn-outline-secondary font-monospace';
      if (statusLockBadge) statusLockBadge.innerText = '🔓 HOST: UNLOCKED';
    }
  }

  function broadcastLocalEdit() {
    if (isApplyingRemoteEdit) return;
    isWritingLocal = true;
    if (syncBadge) {
      syncBadge.innerText = '⚡ SYNCING...';
      syncBadge.style.color = '#e3b341';
    }

    const code = codeEditor ? codeEditor.getValue() : scratchpad.value;
    scratchpad.value = code;
    localStorage.setItem('room_buffer_' + roomId, code);

    if (broadcastChannel) {
      broadcastChannel.postMessage({
        type: 'code_update',
        code: code,
        sender: currentUser
      });
    }

    if (roomDocRef) {
      setDoc(roomDocRef, {
        code: code,
        lastEditor: currentUser,
        updatedAt: serverTimestamp()
      }, { merge: true }).then(() => {
        isWritingLocal = false;
        if (syncBadge) {
          syncBadge.innerText = '🟢 LIVE';
          syncBadge.style.color = '#3fb950';
        }
      }).catch(() => {
        isWritingLocal = false;
        if (syncBadge) syncBadge.innerText = '🟢 LIVE';
      });
    } else {
      setTimeout(() => {
        isWritingLocal = false;
        if (syncBadge) syncBadge.innerText = '🟢 LOCAL LIVE';
      }, 150);
    }
  }

  function broadcastCursorMove(position) {
    if (!position || !broadcastChannel) return;
    broadcastChannel.postMessage({
      type: 'cursor_move',
      sender: currentUser,
      line: position.lineNumber,
      column: position.column
    });
  }

  // Monaco Editor Initialization with VS Dark+ Theme
  function initMonacoEditor() {
    if (typeof window.require === 'undefined') {
      setTimeout(initMonacoEditor, 250);
      return;
    }

    window.require.config({
      paths: {
        vs: 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs'
      }
    });

    window.require(['vs/editor/editor.main'], function () {
      try {
        // Detect initial language from URL query or default to go/python
        const urlParams = new URLSearchParams(window.location.search);
        let initialLang = urlParams.get('lang') || 'go';
        if (!languageConfigs[initialLang]) initialLang = 'go';

        const conf = languageConfigs[initialLang];
        const initialCode = conf.template;
        scratchpad.value = initialCode;

        const mount = document.getElementById('monacoEditorMount');
        codeEditor = window.monaco.editor.create(mount, {
          value: initialCode,
          language: initialLang === 'vue' ? 'html' : initialLang,
          theme: 'vs-dark',
          fontSize: currentFontSize,
          fontFamily: "'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace",
          automaticLayout: true,
          minimap: { enabled: isMinimapEnabled },
          scrollBeyondLastLine: false,
          roundedSelection: true,
          renderLineHighlight: 'all',
          cursorBlinking: 'smooth',
          cursorSmoothCaretAnimation: 'on',
          bracketPairColorization: { enabled: true },
          tabSize: 4,
          insertSpaces: true
        });

        isMonacoReady = true;

        if (monacoLoading) {
          monacoLoading.style.transition = 'opacity 0.3s ease';
          monacoLoading.style.opacity = '0';
          setTimeout(() => monacoLoading.remove(), 300);
        }

        // Apply initial active language tab
        selectWorkspaceLanguage(initialLang);

        codeEditor.onDidChangeModelContent(() => {
          updateStatusMetrics();
          if (peerStatusDisplay) {
            peerStatusDisplay.innerText = 'TYPING...';
            peerStatusDisplay.className = 'text-warning small';
          }
          if (!isApplyingRemoteEdit) {
            clearTimeout(syncDebounceTimeout);
            syncDebounceTimeout = setTimeout(() => {
              broadcastLocalEdit();
            }, 250);
          }
        });

        codeEditor.onDidChangeCursorPosition((e) => {
          if (statusPos) {
            statusPos.innerText = `Ln ${e.position.lineNumber}, Col ${e.position.column}`;
          }
          broadcastCursorMove(e.position);
        });

        codeEditor.onDidChangeCursorSelection((e) => {
          if (statusSelection) {
            const sel = e.selection;
            if (sel.isEmpty()) {
              statusSelection.innerText = `0 sel`;
            } else {
              const selectedChars = codeEditor.getModel().getValueInRange(sel).length;
              statusSelection.innerText = `${selectedChars} sel`;
            }
          }
        });

        updateStatusMetrics();
        addTelemetry('VS Code Monaco runtime initialized successfully.');

        // Shortcut: Cmd+Enter to run/test
        codeEditor.addCommand(window.monaco.KeyMod.CtrlCmd | window.monaco.KeyCode.Enter, () => {
          if (submitMonacoChallengeBtn) submitMonacoChallengeBtn.click();
        });

        initFirebaseSync();

      } catch (err) {
        console.error('Monaco initialization error:', err);
        fallbackToTextarea();
      }
    });
  }

  function fallbackToTextarea() {
    if (monacoLoading) monacoLoading.remove();
    scratchpad.classList.remove('d-none');
    scratchpad.classList.add('form-control', 'bg-dark', 'text-light', 'font-monospace');
    scratchpad.style.height = '400px';
    addTelemetry('Monaco fallback: Using native textarea editor.');
    initFirebaseSync();
  }

  setTimeout(() => {
    if (!isMonacoReady && !codeEditor) {
      fallbackToTextarea();
    }
  }, 4000);

  // Firebase Real-Time Database Connection
  let db = null;
  let roomDocRef = null;

  async function initFirebaseSync() {
    try {
      let config = <%- JSON.stringify(firebaseConfig || {}) %>;
      if (!config || !config.apiKey) {
        const resp = await fetch('/api/firebase-config');
        config = await resp.json();
      }

      if (!config || !config.apiKey) {
        if (syncBadge) syncBadge.innerText = '🟢 LOCAL SYNC';
        return;
      }

      const app = initializeApp(config);
      db = config.firestoreDatabaseId ? getFirestore(app, config.firestoreDatabaseId) : getFirestore(app);
      roomDocRef = doc(db, 'rooms', 'room_' + roomId);

      addTelemetry('Connected to Firebase Realtime Database.');
      if (syncBadge) syncBadge.innerText = '🟢 CLOUD LIVE';

      onSnapshot(roomDocRef, (snap) => {
        if (snap.exists()) {
          const data = snap.data();
          const currentCode = codeEditor ? codeEditor.getValue() : scratchpad.value;
          if (data.code !== undefined && data.code !== currentCode) {
            if (!isWritingLocal || (data.lastEditor && data.lastEditor !== currentUser)) {
              handleRemoteCode(data.code, data.lastEditor);
            }
          }
          if (data.isLocked !== undefined && data.isLocked !== isLocked) {
            applyLockState(data.isLocked);
          }
          if (data.latestLog && data.logTimestamp && data.logTimestamp > lastRemoteTimestamp) {
            lastRemoteTimestamp = data.logTimestamp;
            appendConsoleLog(data.latestLog);
          }
          if (data.missionTimer && data.missionTimer.timestamp && data.missionTimer.timestamp > lastTimerSyncTimestamp) {
            lastTimerSyncTimestamp = data.missionTimer.timestamp;
            handleRemoteTimerSync(data.missionTimer);
          }
        }
      }, (error) => {
        console.warn('Firebase snapshot notice:', error);
      });

    } catch (err) {
      console.warn('Firebase init notice:', err);
    }
  }

  // Format zoom handlers
  document.getElementById('btnFontInc')?.addEventListener('click', () => {
    if (currentFontSize < 22 && codeEditor) {
      currentFontSize += 1;
      codeEditor.updateOptions({ fontSize: currentFontSize });
    }
  });
  document.getElementById('btnFontDec')?.addEventListener('click', () => {
    if (currentFontSize > 10 && codeEditor) {
      currentFontSize -= 1;
      codeEditor.updateOptions({ fontSize: currentFontSize });
    }
  });

  // Minimap toggle
  document.getElementById('btnToggleMinimap')?.addEventListener('click', () => {
    if (codeEditor) {
      isMinimapEnabled = !isMinimapEnabled;
      codeEditor.updateOptions({ minimap: { enabled: isMinimapEnabled } });
    }
  });

  // Format code
  document.getElementById('btnFormatCode')?.addEventListener('click', () => {
    if (codeEditor) {
      codeEditor.getAction('editor.action.formatDocument')?.run();
      addTelemetry('Formatted code buffer.');
    }
  });

  // RUN CONTAINER BUTTON (with Go & Vue runtime simulations)
  document.getElementById('runContainerBtn').addEventListener('click', () => {
    const timestamp = new Date().toLocaleTimeString();
    const currentCode = codeEditor ? codeEditor.getValue() : scratchpad.value;
    const selectedLang = languageSelect ? languageSelect.value : 'go';
    const conf = languageConfigs[selectedLang] || languageConfigs.go;

    switchVsCodePanel('terminal');
    appendConsoleLog(`<span class="text-muted">[${timestamp}] Spawning ephemeral container sandbox (${conf.runtime})...</span><br>`);

    setTimeout(() => {
      appendConsoleLog(`<span class="text-info">&gt; Executing script in container...</span><br>`);
      setTimeout(() => {
        let resultLog = '';
        if (selectedLang === 'go') {
          resultLog = `<span class="text-go fw-bold">&gt; [GOLANG 1.22] go run main.go -race</span><br><span class="text-success">&gt; [OK] Concurrency safe balance: 1000</span><br><span class="text-light">&gt; [OK] Goroutine worker pool: 100 goroutines completed without data race</span><br><span class="text-info">&gt; Process finished with exit code 0 (elapsed: 0.042s).</span><br><br>`;
        } else if (selectedLang === 'vue') {
          resultLog = `<span class="text-vue fw-bold">&gt; [VUE 3.4 SFC] vite build --mode development</span><br><span class="text-success">&gt; [OK] Compiled App.vue single file component in 14ms</span><br><span class="text-light">&gt; [VUE] Scoped styles mounted to virtual DOM</span><br><span class="text-info">&gt; Live reactive preview rendered in 'Vue Component Preview' tab.</span><br><br>`;
          renderVueComponentPreview(currentCode);
          switchVsCodePanel('vuePreview');
        } else if (selectedLang === 'python') {
          resultLog = `<span class="text-success">&gt; {'status': 'SECURE', 'nodes': 2, 'synced_by': '${currentUser}'}</span><br><span class="text-info">&gt; Process finished with exit code 0 (execution time: 0.038s).</span><br><br>`;
        } else if (selectedLang === 'javascript' || selectedLang === 'typescript') {
          resultLog = `<span class="text-success">&gt; Container metrics: { "status": "SECURE", "nodes": 2, "timestamp": "${new Date().toISOString()}" }</span><br><span class="text-info">&gt; Node runtime completed with exit code 0.</span><br><br>`;
        } else if (selectedLang === 'sql') {
          resultLog = `<span class="text-warning">&gt; Query OK, 2 rows affected (0.012 sec)</span><br><span class="text-light">&gt; (1, '${currentUser}', 5, 2450, 'ACTIVE')</span><br><span class="text-light">&gt; (2, 'developer_b', 4, 1820, 'ACTIVE')</span><br><br>`;
        } else {
          resultLog = `<span class="text-success">&gt; [SYSTEM] Execution finished successfully.</span><br><span class="text-info">&gt; Process exited with code 0.</span><br><br>`;
        }

        appendConsoleLog(resultLog);

        const fullLog = `<span class="text-muted">[${timestamp}] Container Run by @${currentUser}:</span><br>${resultLog}`;
        if (roomDocRef) {
          setDoc(roomDocRef, {
            latestLog: fullLog,
            logTimestamp: Date.now()
          }, { merge: true });
        }
        if (broadcastChannel) {
          broadcastChannel.postMessage({
            type: 'container_run',
            log: fullLog
          });
        }
        addTelemetry(`Container execution finished.`);
      }, 500);
    }, 350);
  });

  // Clear Console
  document.getElementById('clearConsoleBtn').addEventListener('click', () => {
    if (consoleOutput) {
      consoleOutput.innerHTML = `<span class="text-muted">&gt; Codespace terminal reset.</span><br>`;
    }
  });

  // Host Lock Button
  lockModeBtn.addEventListener('click', () => {
    const newLockState = !isLocked;
    applyLockState(newLockState);
    if (roomDocRef) {
      setDoc(roomDocRef, { isLocked: newLockState }, { merge: true });
    }
    if (broadcastChannel) {
      broadcastChannel.postMessage({ type: 'lock_update', isLocked: newLockState });
    }
    addTelemetry(newLockState ? 'Host locked the collaborative buffer.' : 'Host unlocked buffer for all peers.');
  });

  // Audio Huddle
  document.getElementById('joinHuddleBtn').addEventListener('click', () => {
    isHuddleActive = !isHuddleActive;
    const btn = document.getElementById('joinHuddleBtn');
    const statusBadge = document.getElementById('huddleStatus');
    if (isHuddleActive) {
      btn.innerText = 'Leave Audio';
      btn.className = 'btn btn-sm btn-outline-danger w-100 font-monospace py-1';
      statusBadge.innerText = 'LIVE';
      statusBadge.className = 'badge bg-danger text-light small';
      addTelemetry('Connected to P2P Voice Huddle.');
    } else {
      btn.innerText = 'Join Audio';
      btn.className = 'btn btn-sm btn-gh-secondary w-100 font-monospace py-1';
      statusBadge.innerText = 'OFF';
      statusBadge.className = 'badge bg-secondary small';
      addTelemetry('Disconnected from Audio Huddle.');
    }
  });

  // Conflict scan
  document.getElementById('scanConflictBtn').addEventListener('click', () => {
    const banner = document.getElementById('conflictAlertBanner');
    const statusText = document.getElementById('conflictStatusText');
    banner.classList.remove('d-none');
    statusText.innerText = '1 Conflict';
    statusText.className = 'text-danger fw-bold';
    addTelemetry('GitLive scan: Concurrent line modification detected.');
  });

  // Share Invite Link
  document.getElementById('shareInviteBtn').addEventListener('click', () => {
    if (navigator.clipboard) {
      navigator.clipboard.writeText(window.location.href);
      const btn = document.getElementById('shareInviteBtn');
      const orig = btn.innerHTML;
      btn.innerHTML = '✔ Link Copied!';
      setTimeout(() => btn.innerHTML = orig, 2000);
      addTelemetry('Codespace invite link copied to clipboard.');
    }
  });

  // Challenge Selection & Mission Intel
  function escapeHtml(str) {
    if (str === null || str === undefined) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function renderMissionBrief(challenge) {
    if (!challenge) return;
    if (briefChallengeCategory) briefChallengeCategory.innerText = challenge.category || 'Security Defense';
    if (briefChallengeDiff) {
      briefChallengeDiff.innerText = (challenge.difficulty || 'MEDIUM').toUpperCase();
    }
    if (briefChallengeReward) briefChallengeReward.innerText = `+${challenge.xp_reward || 100} XP`;
    if (briefChallengeDesc) briefChallengeDesc.innerText = challenge.description || '';
    if (briefChallengeInstructions) {
      briefChallengeInstructions.innerHTML = `<strong>MISSION OBJECTIVE:</strong> ${escapeHtml(challenge.instructions || '')}`;
    }
    if (testCaseCountBadge) {
      testCaseCountBadge.innerText = (challenge.test_cases || []).length;
    }

    if (briefTestCasesList) {
      const tests = challenge.test_cases || [];
      if (tests.length === 0) {
        briefTestCasesList.innerHTML = `<div class="col-12 text-muted small">No predefined test cases specified.</div>`;
      } else {
        briefTestCasesList.innerHTML = tests.map((t, idx) => `
          <div class="col-md-6">
            <div class="p-2 rounded bg-black border border-secondary" style="font-size: 0.73rem;">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-light fw-bold">Test #${t.id || (idx + 1)}: ${escapeHtml(t.name)}</span>
                <span class="badge bg-black border border-info text-info" style="font-size: 0.65rem;">${escapeHtml(t.type || 'Functional')}</span>
              </div>
              <div class="text-muted text-truncate mb-1">${escapeHtml(t.description || '')}</div>
              <div class="text-secondary" style="font-size: 0.68rem;">
                <span class="text-info">Input:</span> <code>${escapeHtml(t.input)}</code><br>
                <span class="text-warning">Expects:</span> <span class="text-light">${escapeHtml(t.expected)}</span>
              </div>
            </div>
          </div>
        `).join('');
      }
    }

    if (sidebarChallengeTitle) sidebarChallengeTitle.innerText = `#${challenge.id}: ${challenge.title}`;
    if (sidebarChallengeDiff) sidebarChallengeDiff.innerText = (challenge.difficulty || 'MEDIUM').toUpperCase();
    if (sidebarChallengeXp) sidebarChallengeXp.innerText = `+${challenge.xp_reward || 100} XP`;
    if (sidebarTestCount) sidebarTestCount.innerText = `${(challenge.test_cases || []).length} Test Cases`;
    if (sidebarTimeLimit) sidebarTimeLimit.innerText = formatTimeLimit(challenge.time_limit_seconds || 300);

    const isSolved = userSolvedChallengeIds.has(Number(challenge.id));
    if (challengeStatusBadge) {
      challengeStatusBadge.innerText = isSolved ? 'SOLVED' : 'UNSOLVED';
      challengeStatusBadge.className = isSolved ? 'badge bg-success text-black' : 'badge bg-black border border-secondary text-muted';
    }
    if (sidebarStatusText) {
      sidebarStatusText.innerText = isSolved ? 'SOLVED' : 'UNSOLVED';
      sidebarStatusText.className = isSolved ? 'text-success fw-bold' : 'text-warning';
    }
  }

  function formatTime(totalSecs) {
    if (!totalSecs || totalSecs < 0) totalSecs = 0;
    const mins = Math.floor(totalSecs / 60);
    const secs = Math.floor(totalSecs % 60);
    return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
  }

  function formatTimeLimit(totalSecs) {
    if (!totalSecs || totalSecs < 0) return '5m 00s';
    const mins = Math.floor(totalSecs / 60);
    const secs = Math.floor(totalSecs % 60);
    return `${mins}m ${String(secs).padStart(2, '0')}s`;
  }

  function updateTimerVisuals() {
    const formatted = formatTime(timerSecondsRemaining);
    if (countdownClockDisplay) countdownClockDisplay.innerText = formatted;
    if (sidebarTimeRemaining) sidebarTimeRemaining.innerText = formatted;

    const percent = timerTotalSeconds > 0 ? Math.max(0, Math.min(100, (timerSecondsRemaining / timerTotalSeconds) * 100)) : 0;
    if (countdownProgressBar) {
      countdownProgressBar.style.width = `${percent}%`;
    }
  }

  window.selectChallenge = function(challengeId) {
    const found = allChallenges.find(c => String(c.id) === String(challengeId));
    if (!found) return;
    selectedChallenge = found;
    renderMissionBrief(selectedChallenge);

    // Auto-switch language if challenge matches go or vue
    if (selectedChallenge.id === 7 || selectedChallenge.title.toLowerCase().includes('go')) {
      selectWorkspaceLanguage('go');
    } else if (selectedChallenge.id === 8 || selectedChallenge.title.toLowerCase().includes('vue')) {
      selectWorkspaceLanguage('vue');
    }

    addTelemetry(`Selected CTF Challenge #${selectedChallenge.id}: ${selectedChallenge.title}`);
  };

  window.toggleMissionDrawer = function() {
    if (missionBriefDrawer) {
      missionBriefDrawer.classList.toggle('d-none');
    }
  };

  // Load challenge skeleton code into editor
  function loadChallengeStarter() {
    if (!selectedChallenge) return;
    const currentLang = languageSelect ? languageSelect.value : 'go';
    let starterCode = '';
    if (selectedChallenge.starter_templates && selectedChallenge.starter_templates[currentLang]) {
      starterCode = selectedChallenge.starter_templates[currentLang];
    } else if (selectedChallenge.starter_templates) {
      const keys = Object.keys(selectedChallenge.starter_templates);
      if (keys.length > 0) {
        starterCode = selectedChallenge.starter_templates[keys[0]];
      }
    }

    if (starterCode && codeEditor) {
      codeEditor.setValue(starterCode);
      broadcastLocalEdit();
      addTelemetry(`Loaded starter skeleton for #${selectedChallenge.id}`);
    }
  }

  // Predefined Test Suite Submission
  async function submitMonacoChallenge() {
    if (isSubmittingChallenge || !selectedChallenge) return;

    const code = codeEditor ? codeEditor.getValue() : scratchpad.value;
    if (!code || !code.trim()) {
      alert('Please write or patch your solution code first.');
      return;
    }

    isSubmittingChallenge = true;
    switchVsCodePanel('tests');

    if (submitMonacoChallengeBtn) {
      submitMonacoChallengeBtn.disabled = true;
      submitMonacoChallengeBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Testing...';
    }
    if (testRunnerEmptyState) testRunnerEmptyState.classList.add('d-none');
    if (testRunnerResultsContainer) testRunnerResultsContainer.classList.add('d-none');
    if (testRunnerLoadingState) testRunnerLoadingState.classList.remove('d-none');

    try {
      const response = await fetch('/api/challenges/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          challengeId: selectedChallenge.id,
          code: code,
          language: languageSelect ? languageSelect.value : 'go',
          roomId: roomId
        })
      });

      const data = await response.json();
      if (testRunnerLoadingState) testRunnerLoadingState.classList.add('d-none');
      if (testRunnerResultsContainer) testRunnerResultsContainer.classList.remove('d-none');

      const allPassed = !!data.allPassed;
      const passedCount = data.testsPassed || 0;
      const totalCount = data.testsTotal || 0;

      if (testRunnerTabBadge) {
        testRunnerTabBadge.className = allPassed ? 'badge bg-success text-black ms-1' : 'badge bg-danger text-white ms-1';
        testRunnerTabBadge.innerText = allPassed ? `PASS (${passedCount}/${totalCount})` : `FAIL (${passedCount}/${totalCount})`;
      }
      if (testSuiteSummaryStatus) {
        testSuiteSummaryStatus.innerText = `${passedCount}/${totalCount} Passed`;
        testSuiteSummaryStatus.className = allPassed ? 'text-success fw-bold small' : 'text-danger small';
      }

      if (testResultsSummaryHeader) {
        if (allPassed) {
          testResultsSummaryHeader.innerHTML = `
            <div class="p-3 mb-2 rounded border border-success font-monospace" style="background: rgba(46, 160, 67, 0.15);">
              <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                  <div class="text-success fw-bold">🏆 ALL ${totalCount}/${totalCount} TEST CASES PASSED!</div>
                  <div class="text-light small">Vulnerability remediated. Code meets all assertions.</div>
                </div>
                <span class="badge bg-success text-black fw-bold px-2 py-1">+${data.xpAwarded || selectedChallenge.xp_reward || 100} XP</span>
              </div>
              ${data.flag ? `<div class="mt-2 p-1 bg-black border border-success small">FLAG: <code class="text-warning fw-bold">${escapeHtml(data.flag)}</code></div>` : ''}
            </div>
          `;
          userSolvedChallengeIds.add(Number(selectedChallenge.id));
          if (challengeStatusBadge) {
            challengeStatusBadge.innerText = 'SOLVED';
            challengeStatusBadge.className = 'badge bg-success text-black';
          }
        } else {
          testResultsSummaryHeader.innerHTML = `
            <div class="p-2 mb-2 rounded border border-danger font-monospace" style="background: rgba(248, 81, 73, 0.15);">
              <div class="text-danger fw-bold">❌ TEST SUITE FAILED: ${passedCount}/${totalCount} PASSED</div>
              <div class="text-muted small">One or more security assertions failed. Review diagnostics below.</div>
            </div>
          `;
        }
      }

      if (testCasesResultsList) {
        const results = data.testResults || [];
        testCasesResultsList.innerHTML = results.map(r => `
          <div class="p-2 rounded font-monospace" style="background: ${r.passed ? 'rgba(46, 160, 67, 0.08)' : 'rgba(248, 81, 73, 0.08)'}; border: 1px solid ${r.passed ? '#2ea043' : '#f85149'};">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <span class="fw-bold ${r.passed ? 'text-success' : 'text-danger'}">${r.passed ? '✔ PASS' : '✖ FAIL'}: ${escapeHtml(r.name)}</span>
              <span class="text-muted small">${r.durationMs || 12}ms</span>
            </div>
            <div class="small text-muted"><span class="text-info">Input:</span> <code>${escapeHtml(r.input)}</code></div>
            <div class="small text-muted"><span class="text-warning">Expected:</span> ${escapeHtml(r.expected)}</div>
            <div class="small ${r.passed ? 'text-success' : 'text-danger'}">Actual: ${escapeHtml(r.actual)}</div>
            ${!r.passed && r.hint ? `<div class="mt-1 text-warning small">💡 Hint: ${escapeHtml(r.hint)}</div>` : ''}
          </div>
        `).join('');
      }

    } catch (err) {
      console.error(err);
    } finally {
      isSubmittingChallenge = false;
      if (submitMonacoChallengeBtn) {
        submitMonacoChallengeBtn.disabled = false;
        submitMonacoChallengeBtn.innerHTML = '<i class="codicon codicon-pass text-success"></i> <span>Test &amp; Submit</span>';
      }
    }
  }

  // Event Listeners
  if (challengeSelect) {
    challengeSelect.addEventListener('change', (e) => selectChallenge(e.target.value));
  }
  if (toggleMissionBriefBtn) {
    toggleMissionBriefBtn.addEventListener('click', toggleMissionDrawer);
  }
  if (loadChallengeStarterBtn) {
    loadChallengeStarterBtn.addEventListener('click', loadChallengeStarter);
  }
  if (submitMonacoChallengeBtn) {
    submitMonacoChallengeBtn.addEventListener('click', submitMonacoChallenge);
  }

  // Initialize
  if (selectedChallenge) {
    renderMissionBrief(selectedChallenge);
  }
  updateTimerVisuals();
  initMonacoEditor();

  // Vue 3 SFC Interactive Workbench Toggle and Mount
  window.toggleWorkbenchMode = function() {
    const monacoLayout = document.querySelector('.vscode-main-layout');
    const vueContainer = document.getElementById('vue-workbench-container');
    const btn = document.getElementById('toggleWorkbenchModeBtn');
    
    if (!vueContainer) return;

    if (vueContainer.style.display === 'none') {
      if (monacoLayout) monacoLayout.style.display = 'none';
      vueContainer.style.display = 'block';
      if (btn) {
        btn.innerHTML = '<i class="codicon codicon-vscode text-info"></i> <span>Monaco Mode</span>';
      }
      if (!window.__vueWorkbenchMounted && window.CodeQuestVue) {
        window.CodeQuestVue.mount('vue-workbench-container', '/components/WorkspaceWorkbench.vue');
        window.__vueWorkbenchMounted = true;
      }
    } else {
      if (monacoLayout) monacoLayout.style.display = 'flex';
      vueContainer.style.display = 'none';
      if (btn) {
        btn.innerHTML = '<i class="codicon codicon-symbol-class text-vue"></i> <span>Vue 3 SFC Mode</span>';
      }
    }
  };

  // Check URL parameters for explicit Vue workbench activation
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('mode') === 'vue' || urlParams.get('view') === 'vue') {
    setTimeout(() => {
      window.toggleWorkbenchMode();
    }, 200);
  }
</script>

<%- include('../partials/footer') %>
