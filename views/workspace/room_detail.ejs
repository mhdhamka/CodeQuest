  // =========================================================================
  // Mission Urgency Visual Countdown Timer & Audio Feedback Engine
  // =========================================================================

  // Format seconds to mm:ss
  function formatTime(totalSecs) {
    if (totalSecs === undefined || totalSecs === null || isNaN(totalSecs) || totalSecs < 0) totalSecs = 0;
    const mins = Math.floor(totalSecs / 60);
    const secs = Math.floor(totalSecs % 60);
    return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
  }

  // Format seconds to human readable limit e.g. "5m 00s"
  function formatTimeLimit(totalSecs) {
    if (!totalSecs || totalSecs < 0) return '5m 00s';
    const mins = Math.floor(totalSecs / 60);
    const secs = Math.floor(totalSecs % 60);
    return `${mins}m ${String(secs).padStart(2, '0')}s`;
  }

  // Web Audio API Synthesizer for Cyberpunk Urgency Cues
  let audioCtx = null;
  function getAudioContext() {
    if (!audioCtx && (window.AudioContext || window.webkitAudioContext)) {
      audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    }
    if (audioCtx && audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
    return audioCtx;
  }

  function playUrgencyBeep(type = 'tick') {
    if (!timerSoundEnabled) return;
    try {
      const ctx = getAudioContext();
      if (!ctx) return;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.connect(gain);
      gain.connect(ctx.destination);

      const now = ctx.currentTime;
      if (type === 'tick') {
        osc.type = 'sine';
        osc.frequency.setValueAtTime(880, now);
        gain.gain.setValueAtTime(0.025, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.05);
        osc.start(now);
        osc.stop(now + 0.05);
      } else if (type === 'critical') {
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(1040, now);
        osc.frequency.setValueAtTime(1380, now + 0.06);
        gain.gain.setValueAtTime(0.08, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.18);
        osc.start(now);
        osc.stop(now + 0.18);
      } else if (type === 'buzzer') {
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(160, now);
        osc.frequency.setValueAtTime(110, now + 0.2);
        gain.gain.setValueAtTime(0.12, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.45);
        osc.start(now);
        osc.stop(now + 0.45);
      } else if (type === 'victory') {
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(523.25, now);
        osc.frequency.setValueAtTime(659.25, now + 0.09);
        osc.frequency.setValueAtTime(783.99, now + 0.18);
        osc.frequency.setValueAtTime(1046.5, now + 0.27);
        gain.gain.setValueAtTime(0.09, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.55);
        osc.start(now);
        osc.stop(now + 0.55);
      }
    } catch (e) {
      console.warn('Audio cue notice:', e);
    }
  }

  // Update Visual Timer HUD & Urgency Styles
  function updateTimerVisuals() {
    const formatted = formatTime(timerSecondsRemaining);
    if (countdownClockDisplay) countdownClockDisplay.innerText = formatted;
    if (sidebarTimeRemaining) sidebarTimeRemaining.innerText = formatted;

    const percent = timerTotalSeconds > 0 ? Math.max(0, Math.min(100, (timerSecondsRemaining / timerTotalSeconds) * 100)) : 0;
    if (countdownProgressBar) {
      countdownProgressBar.style.width = `${percent}%`;
      countdownProgressBar.setAttribute('aria-valuenow', Math.round(percent));
    }

    // Urgency styling states
    if (timerSecondsRemaining <= 0) {
      // 00:00 - Time Expired
      timerExpired = true;
      if (countdownClockDisplay) {
        countdownClockDisplay.innerText = '00:00';
        countdownClockDisplay.className = 'fs-4 fw-bold text-danger px-3 py-0 rounded bg-black border border-danger font-monospace shadow-sm';
      }
      if (sidebarTimeRemaining) {
        sidebarTimeRemaining.innerText = '00:00 [LOCKED]';
        sidebarTimeRemaining.className = 'text-danger fw-bold';
      }
      if (timerUrgencyStatusBadge) {
        timerUrgencyStatusBadge.innerText = '💀 TIME EXPIRED // SUBMISSIONS LOCKED';
        timerUrgencyStatusBadge.className = 'badge bg-danger text-black fw-bold px-2 py-1 small';
      }
      if (missionTimerBar) {
        missionTimerBar.classList.remove('timer-critical-pulse');
        missionTimerBar.style.borderColor = '#ff0055';
        missionTimerBar.style.boxShadow = '0 0 16px rgba(255, 0, 85, 0.4)';
      }
      if (countdownProgressBar) {
        countdownProgressBar.className = 'progress-bar bg-danger';
      }
      if (submitMonacoChallengeBtn) {
        submitMonacoChallengeBtn.disabled = true;
        submitMonacoChallengeBtn.innerHTML = '⏰ [ TIME EXPIRED - RESTART TIMER ]';
        submitMonacoChallengeBtn.title = 'Mission time expired. Click RESTART TIMER to begin a new attempt.';
      }
      if (timerToggleBtn) {
        timerToggleBtn.innerText = '▶ RESTART MISSION CLOCK';
        timerToggleBtn.className = 'btn btn-sm btn-outline-warning font-monospace py-0 px-2 d-flex align-items-center gap-1';
      }
    } else if (timerSecondsRemaining <= 60) {
      // Danger Zone (< 60s remaining)
      timerExpired = false;
      if (countdownClockDisplay) {
        countdownClockDisplay.className = 'fs-4 fw-bold text-danger px-3 py-0 rounded bg-black border border-danger font-monospace shadow-sm timer-critical-text';
      }
      if (sidebarTimeRemaining) {
        sidebarTimeRemaining.innerText = formatted;
        sidebarTimeRemaining.className = 'text-danger fw-bold';
      }
      if (timerUrgencyStatusBadge) {
        timerUrgencyStatusBadge.innerText = '⚠️ CRITICAL: EXPIRING SOON (<60s)';
        timerUrgencyStatusBadge.className = 'badge bg-danger text-black fw-bold px-2 py-1 small';
      }
      if (missionTimerBar) {
        missionTimerBar.classList.add('timer-critical-pulse');
      }
      if (countdownProgressBar) {
        countdownProgressBar.className = 'progress-bar progress-bar-striped progress-bar-animated bg-danger';
      }
      if (submitMonacoChallengeBtn && !isSubmittingChallenge) {
        submitMonacoChallengeBtn.disabled = false;
        submitMonacoChallengeBtn.innerHTML = '🚀 [ VALIDATE &amp; SUBMIT ]';
      }
    } else if (timerSecondsRemaining <= timerTotalSeconds * 0.4) {
      // Pacing Warning (20% - 40%)
      timerExpired = false;
      if (countdownClockDisplay) {
        countdownClockDisplay.classList.remove('timer-critical-text');
        countdownClockDisplay.className = 'fs-4 fw-bold text-warning px-3 py-0 rounded bg-black border border-warning font-monospace shadow-sm';
      }
      if (sidebarTimeRemaining) {
        sidebarTimeRemaining.innerText = formatted;
        sidebarTimeRemaining.className = 'text-warning fw-bold';
      }
      if (timerUrgencyStatusBadge) {
        timerUrgencyStatusBadge.innerText = isTimerRunning ? '⚡ PACING WARNING' : '⏱️ PAUSED';
        timerUrgencyStatusBadge.className = 'badge bg-black border border-warning text-warning px-2 py-1 small';
      }
      if (missionTimerBar) {
        missionTimerBar.classList.remove('timer-critical-pulse');
        missionTimerBar.style.borderColor = '#ffb700';
        missionTimerBar.style.boxShadow = '0 0 12px rgba(255, 183, 0, 0.2)';
      }
      if (countdownProgressBar) {
        countdownProgressBar.className = 'progress-bar progress-bar-striped progress-bar-animated bg-warning';
      }
      if (submitMonacoChallengeBtn && !isSubmittingChallenge) {
        submitMonacoChallengeBtn.disabled = false;
        submitMonacoChallengeBtn.innerHTML = '🚀 [ VALIDATE &amp; SUBMIT ]';
      }
    } else {
      // Normal / Safe Zone (> 40%)
      timerExpired = false;
      if (countdownClockDisplay) {
        countdownClockDisplay.classList.remove('timer-critical-text');
        countdownClockDisplay.className = 'fs-4 fw-bold text-info px-3 py-0 rounded bg-black border border-info font-monospace shadow-sm';
      }
      if (sidebarTimeRemaining) {
        sidebarTimeRemaining.innerText = formatted;
        sidebarTimeRemaining.className = 'text-info fw-bold';
      }
      if (timerUrgencyStatusBadge) {
        timerUrgencyStatusBadge.innerText = isTimerRunning ? '⚡ MISSION CLOCK ACTIVE' : '⏱️ TIMER READY';
        timerUrgencyStatusBadge.className = 'badge bg-black border border-info text-info px-2 py-1 small';
      }
      if (missionTimerBar) {
        missionTimerBar.classList.remove('timer-critical-pulse');
        missionTimerBar.style.borderColor = '#00e5ff';
        missionTimerBar.style.boxShadow = '0 0 14px rgba(0, 229, 255, 0.15)';
      }
      if (countdownProgressBar) {
        countdownProgressBar.className = 'progress-bar progress-bar-striped progress-bar-animated bg-info';
      }
      if (submitMonacoChallengeBtn && !isSubmittingChallenge) {
        submitMonacoChallengeBtn.disabled = false;
        submitMonacoChallengeBtn.innerHTML = '🚀 [ VALIDATE &amp; SUBMIT ]';
      }
    }

    if (timerChallengeLimitInfo) {
      timerChallengeLimitInfo.innerText = `Limit: ${formatTimeLimit(timerTotalSeconds)}`;
    }
    if (sidebarTimeLimit) {
      sidebarTimeLimit.innerText = formatTimeLimit(timerTotalSeconds);
    }
  }

  // Ticker loop
  function timerTick() {
    if (!isTimerRunning) return;

    if (timerSecondsRemaining > 0) {
      timerSecondsRemaining -= 1;

      // Audio alerts at critical milestones
      if (timerSecondsRemaining === 60 && !hasAlerted60s) {
        hasAlerted60s = true;
        playUrgencyBeep('critical');
        appendConsoleLog(`<span class="text-danger fw-bold">[URGENCY ALERT] ⚠️ Less than 60 seconds remaining for Challenge #${selectedChallenge?.id}! Prepare solution submission.</span><br>`);
        addTelemetry(`Urgency alert: 60s remaining on challenge #${selectedChallenge?.id}.`);
      } else if (timerSecondsRemaining === 30 && !hasAlerted30s) {
        hasAlerted30s = true;
        playUrgencyBeep('critical');
        appendConsoleLog(`<span class="text-danger fw-bold">[URGENCY ALERT] ⚠️ 30 seconds remaining! Submit code promptly.</span><br>`);
      } else if (timerSecondsRemaining <= 10 && timerSecondsRemaining > 0) {
        // High urgency ticking on last 10 seconds
        playUrgencyBeep('tick');
      }

      updateTimerVisuals();

      // Broadcast periodic sync every 5 seconds
      if (timerSecondsRemaining % 5 === 0) {
        broadcastTimerState();
      }
    } else {
      // Time Expired
      timerSecondsRemaining = 0;
      isTimerRunning = false;
      clearInterval(timerIntervalId);
      timerIntervalId = null;
      timerExpired = true;

      playUrgencyBeep('buzzer');
      updateTimerVisuals();

      appendConsoleLog(`<span class="text-danger fw-bold">[MISSION TIMEOUT] 💀 Time limit expired for Challenge #${selectedChallenge?.id}. Submissions locked. Hit "RESTART TIMER" to re-attempt.</span><br>`);
      addTelemetry(`Mission timeout: Challenge #${selectedChallenge?.id} time limit expired.`);

      broadcastTimerState();
    }
  }

  function startCountdownTimer(broadcast = true) {
    if (timerSecondsRemaining <= 0) {
      restartCountdownTimer(true, broadcast);
      return;
    }
    if (isTimerRunning) return;

    isTimerRunning = true;
    if (timerToggleBtn) {
      timerToggleBtn.innerText = '⏸ PAUSE TIMER';
      timerToggleBtn.className = 'btn btn-sm btn-outline-warning font-monospace py-0 px-2 d-flex align-items-center gap-1';
    }

    clearInterval(timerIntervalId);
    timerIntervalId = setInterval(timerTick, 1000);
    playUrgencyBeep('tick');
    updateTimerVisuals();

    appendConsoleLog(`<span class="text-info">[TIMER STARTED] Mission countdown active: ${formatTime(timerSecondsRemaining)} remaining.</span><br>`);
    addTelemetry(`Mission clock started (${timerSecondsRemaining}s).`);

    if (broadcast) {
      broadcastTimerState();
    }
  }

  function pauseCountdownTimer(broadcast = true) {
    if (!isTimerRunning) return;
    isTimerRunning = false;
    clearInterval(timerIntervalId);
    timerIntervalId = null;

    if (timerToggleBtn) {
      timerToggleBtn.innerText = '▶ RESUME MISSION CLOCK';
      timerToggleBtn.className = 'btn btn-sm btn-outline-info font-monospace py-0 px-2 d-flex align-items-center gap-1';
    }
    updateTimerVisuals();

    appendConsoleLog(`<span class="text-muted">[TIMER PAUSED] Mission countdown paused at ${formatTime(timerSecondsRemaining)}.</span><br>`);
    addTelemetry(`Mission clock paused at ${formatTime(timerSecondsRemaining)}.`);

    if (broadcast) {
      broadcastTimerState();
    }
  }

  function toggleCountdownTimer() {
    if (isTimerRunning) {
      pauseCountdownTimer(true);
    } else {
      startCountdownTimer(true);
    }
  }

  function restartCountdownTimer(autoStart = false, broadcast = true) {
    clearInterval(timerIntervalId);
    timerIntervalId = null;
    isTimerRunning = false;
    timerExpired = false;

    hasAlerted60s = false;
    hasAlerted30s = false;
    hasAlerted10s = false;

    timerTotalSeconds = selectedChallenge ? (selectedChallenge.time_limit_seconds || 300) : 300;
    timerSecondsRemaining = timerTotalSeconds;

    if (timerToggleBtn) {
      timerToggleBtn.innerText = '▶ START MISSION CLOCK';
      timerToggleBtn.className = 'btn btn-sm btn-outline-info font-monospace py-0 px-2 d-flex align-items-center gap-1';
    }

    updateTimerVisuals();

    if (submitMonacoChallengeBtn) {
      submitMonacoChallengeBtn.disabled = false;
      submitMonacoChallengeBtn.innerHTML = '🚀 [ VALIDATE &amp; SUBMIT ]';
      submitMonacoChallengeBtn.title = 'Validate solution against predefined test cases';
    }

    appendConsoleLog(`<span class="text-warning">[TIMER RESET] Mission clock reset to full challenge limit: ${formatTime(timerTotalSeconds)}.</span><br>`);
    addTelemetry(`Mission countdown reset to ${formatTime(timerTotalSeconds)}.`);

    if (autoStart) {
      startCountdownTimer(broadcast);
    } else if (broadcast) {
      broadcastTimerState();
    }
  }

  function broadcastTimerState() {
    const payload = {
      type: 'timer_sync',
      challengeId: selectedChallenge ? selectedChallenge.id : null,
      secondsRemaining: timerSecondsRemaining,
      totalSeconds: timerTotalSeconds,
      isRunning: isTimerRunning,
      expired: timerExpired,
      timestamp: Date.now(),
      sender: currentUser
    };

    if (broadcastChannel) {
      broadcastChannel.postMessage(payload);
    }

    if (roomDocRef) {
      setDoc(roomDocRef, {
        missionTimer: payload
      }, { merge: true }).catch(err => console.warn('Timer doc sync notice:', err));
    }
  }

  function handleRemoteTimerSync(data) {
    if (!data || data.sender === currentUser) return;
    if (selectedChallenge && data.challengeId && data.challengeId !== selectedChallenge.id) {
      selectChallenge(data.challengeId, false);
    }

    timerTotalSeconds = data.totalSeconds || timerTotalSeconds;
    timerSecondsRemaining = typeof data.secondsRemaining === 'number' ? data.secondsRemaining : timerSecondsRemaining;
    timerExpired = !!data.expired;

    if (data.isRunning && !isTimerRunning) {
      isTimerRunning = true;
      if (timerToggleBtn) {
        timerToggleBtn.innerText = '⏸ PAUSE TIMER';
        timerToggleBtn.className = 'btn btn-sm btn-outline-warning font-monospace py-0 px-2 d-flex align-items-center gap-1';
      }
      clearInterval(timerIntervalId);
      timerIntervalId = setInterval(timerTick, 1000);
    } else if (!data.isRunning && isTimerRunning) {
      isTimerRunning = false;
      clearInterval(timerIntervalId);
      timerIntervalId = null;
      if (timerToggleBtn) {
        timerToggleBtn.innerText = timerSecondsRemaining <= 0 ? '▶ RESTART MISSION CLOCK' : '▶ RESUME MISSION CLOCK';
        timerToggleBtn.className = 'btn btn-sm btn-outline-info font-monospace py-0 px-2 d-flex align-items-center gap-1';
      }
    }

    updateTimerVisuals();
  }

  window.restartCountdownTimer = restartCountdownTimer;
  window.startCountdownTimer = startCountdownTimer;

  // Switch Active Selected Challenge
  function selectChallenge(challengeId, autoLoadStarter = false) {
    const found = roomChallenges.find(c => String(c.id) === String(challengeId));
    if (!found) return;
    selectedChallenge = found;
    renderMissionBrief(found);

    // Reset countdown timer to match the newly selected challenge's time limit
    restartCountdownTimer(false, true);

    if (autoLoadStarter) {
      loadChallengeStarter();
    }
    addTelemetry(`Switched target challenge to #${found.id}: ${found.title}`);
  }

  // Load starter template / vulnerable code into Monaco editor
  function loadChallengeStarter() {
    if (!selectedChallenge) return;
    const currentCode = codeEditor ? codeEditor.getValue() : scratchpad.value;
    const hasCustomCode = currentCode.trim().length > 0 && !Object.values(languageConfigs).some(c => c.template.trim() === currentCode.trim());

    if (hasCustomCode) {
      const ok = confirm(`Replace editor buffer with starter skeleton for Challenge #${selectedChallenge.id}: "${selectedChallenge.title}"?`);
      if (!ok) return;
    }

    // Determine starter code based on active or preferred language
    let starterCode = selectedChallenge.vulnerable_code || '';
    const currentLang = languageSelect ? languageSelect.value : 'python';
    if (selectedChallenge.starter_templates && selectedChallenge.starter_templates[currentLang]) {
      starterCode = selectedChallenge.starter_templates[currentLang];
    }

    if (codeEditor) {
      codeEditor.setValue(starterCode);
    } else {
      scratchpad.value = starterCode;
    }

    broadcastLocalEdit();
    appendConsoleLog(`<span class="text-warning">[CHALLENGE SKELETON LOADED] #${selectedChallenge.id}: ${selectedChallenge.title}</span><br>`);
    addTelemetry(`Loaded starter skeleton for Challenge #${selectedChallenge.id}.`);

    // Automatically trigger mission timer countdown when operative begins the challenge
    if (!isTimerRunning && !timerExpired) {
      startCountdownTimer(true);
    }
  }

  // Console / Test Runner Tab Switcher
  function switchConsoleTab(tabName) {
    if (tabName === 'testRunner') {
      if (tabTestRunnerBtn) {
        tabTestRunnerBtn.className = 'btn btn-outline-info active py-1 px-3 position-relative';
      }
      if (tabContainerLogsBtn) {
        tabContainerLogsBtn.className = 'btn btn-outline-warning py-1 px-3';
      }
      if (testRunnerPanel) testRunnerPanel.classList.remove('d-none');
      if (containerLogsPanel) containerLogsPanel.classList.add('d-none');
    } else {
      if (tabContainerLogsBtn) {
        tabContainerLogsBtn.className = 'btn btn-outline-warning active py-1 px-3';
      }
      if (tabTestRunnerBtn) {
        tabTestRunnerBtn.className = 'btn btn-outline-info py-1 px-3 position-relative';
      }
      if (containerLogsPanel) containerLogsPanel.classList.remove('d-none');
      if (testRunnerPanel) testRunnerPanel.classList.add('d-none');
    }
  }

  // Submit Monaco Editor Code for Challenge Predefined Test Verification
  async function submitMonacoChallenge() {
    if (isSubmittingChallenge) return;
    if (!selectedChallenge) {
      alert('Please select a target challenge first.');
      return;
    }

    // Urgency Check: Rejection if Countdown Timer Expired
    if (timerExpired || timerSecondsRemaining <= 0) {
      switchConsoleTab('testRunner');
      if (testRunnerResultsContainer) testRunnerResultsContainer.classList.remove('d-none');
      if (testRunnerEmptyState) testRunnerEmptyState.classList.add('d-none');
      if (testRunnerLoadingState) testRunnerLoadingState.classList.add('d-none');
      if (testResultsSummaryHeader) {
        testResultsSummaryHeader.innerHTML = `
          <div class="p-3 rounded border border-danger bg-black font-monospace">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="text-danger fw-bold fs-6">⏰ MISSION TIME LIMIT EXPIRED</span>
              <span class="badge bg-danger text-black fw-bold">SUBMISSION LOCKED</span>
            </div>
            <p class="text-secondary small mb-2">
              The allowed time window (${formatTimeLimit(timerTotalSeconds)}) for Challenge #${selectedChallenge.id} has closed.
              Late submissions are disabled to maintain mission urgency pacing. Hit 'RESTART TIMER' to launch a fresh attempt.
            </p>
            <button type="button" class="btn btn-sm btn-outline-warning font-monospace" onclick="restartCountdownTimer(true, true)">
              🔄 RESTART TIMER &amp; RETRY
            </button>
          </div>
        `;
      }
      playUrgencyBeep('buzzer');
      appendConsoleLog(`<span class="text-danger">[MISSION LOCKED] Submission rejected: Time limit expired for Challenge #${selectedChallenge.id}.</span><br>`);
      addTelemetry(`Submission blocked: Timer expired.`);
      return;
    }

    const code = codeEditor ? codeEditor.getValue() : scratchpad.value;
    if (!code || !code.trim()) {
      switchConsoleTab('testRunner');
      if (testRunnerResultsContainer) testRunnerResultsContainer.classList.remove('d-none');
      if (testRunnerEmptyState) testRunnerEmptyState.classList.add('d-none');
      if (testRunnerLoadingState) testRunnerLoadingState.classList.add('d-none');
      if (testResultsSummaryHeader) {
        testResultsSummaryHeader.innerHTML = `
          <div class="p-2 rounded border border-danger bg-black text-danger font-monospace small">
            ⚠️ <strong>BUFFER EMPTY:</strong> Please write or patch solution code before submitting to the test runner.
          </div>
        `;
      }
      return;
    }

    isSubmittingChallenge = true;
    switchConsoleTab('testRunner');

    // UI Loading State
    if (submitMonacoChallengeBtn) {
      submitMonacoChallengeBtn.disabled = true;
      submitMonacoChallengeBtn.innerHTML = `
        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
        [ VALIDATING... ]
      `;
    }
    if (testRunnerEmptyState) testRunnerEmptyState.classList.add('d-none');
    if (testRunnerResultsContainer) testRunnerResultsContainer.classList.add('d-none');
    if (testRunnerLoadingState) testRunnerLoadingState.classList.remove('d-none');
    if (testRunnerTabBadge) {
      testRunnerTabBadge.className = 'badge bg-warning text-black ms-1';
      testRunnerTabBadge.innerText = 'TESTING...';
    }

    const timestamp = new Date().toLocaleTimeString();
    const elapsed = Math.max(0, timerTotalSeconds - timerSecondsRemaining);
    appendConsoleLog(`<span class="text-info">[${timestamp}] Submitting code buffer for Challenge #${selectedChallenge.id}: "${selectedChallenge.title}" (Elapsed: ${formatTime(elapsed)} / Limit: ${formatTimeLimit(timerTotalSeconds)})...</span><br>`);
    addTelemetry(`Validating challenge #${selectedChallenge.id} against predefined test suite...`);

    try {
      const response = await fetch('/api/challenges/submit', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          challengeId: selectedChallenge.id,
          code: code,
          language: languageSelect ? languageSelect.value : 'python',
          roomId: roomId,
          timeExpired: timerExpired || timerSecondsRemaining <= 0,
          elapsedSeconds: elapsed
        })
      });

      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(data.error || 'Server rejected challenge verification.');
      }

      // Display results
      if (testRunnerLoadingState) testRunnerLoadingState.classList.add('d-none');
      if (testRunnerResultsContainer) testRunnerResultsContainer.classList.remove('d-none');

      const allPassed = !!data.allPassed;
      const passedCount = data.testsPassed || 0;
      const totalCount = data.testsTotal || 0;
      const failedCount = data.testsFailed || 0;

      // Update Tab badge & count
      if (testRunnerTabBadge) {
        testRunnerTabBadge.className = allPassed ? 'badge bg-success text-black ms-1' : 'badge bg-danger text-white ms-1';
        testRunnerTabBadge.innerText = allPassed ? `PASS (${passedCount}/${totalCount})` : `FAIL (${passedCount}/${totalCount})`;
      }
      if (testSuiteSummaryStatus) {
        testSuiteSummaryStatus.innerText = `${passedCount}/${totalCount} Tests Passed`;
        testSuiteSummaryStatus.className = allPassed ? 'text-success fw-bold small' : 'text-danger small';
      }

      // Render Summary Header Banner
      if (testResultsSummaryHeader) {
        if (allPassed) {
          // Pause timer and mark mission solved on the countdown clock
          pauseCountdownTimer(false);
          if (timerUrgencyStatusBadge) {
            timerUrgencyStatusBadge.innerText = `🏆 SOLVED (${formatTime(timerSecondsRemaining)} REMAINING)`;
            timerUrgencyStatusBadge.className = 'badge bg-success text-black fw-bold px-2 py-1 small';
          }
          if (countdownProgressBar) {
            countdownProgressBar.className = 'progress-bar bg-success';
          }
          playUrgencyBeep('victory');

          testResultsSummaryHeader.innerHTML = `
            <div class="p-3 mb-3 rounded border border-success font-monospace text-light" style="background: rgba(0, 255, 102, 0.08); box-shadow: 0 0 16px rgba(0, 255, 102, 0.25);">
              <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                  <span style="font-size: 1.5rem;">🏆</span>
                  <div>
                    <div class="text-success fw-bold" style="font-size: 0.95rem;">
                      ALL ${totalCount}/${totalCount} PREDEFINED TEST CASES PASSED!
                    </div>
                    <div class="text-muted small">
                      Vulnerability successfully remediated in ${formatTime(elapsed)} (${formatTime(timerSecondsRemaining)} remaining). Code meets all security, functional & boundary assertions.
                    </div>
                  </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                  <span class="badge bg-success text-black fw-bold px-2 py-1" style="font-size: 0.85rem;">
                    +${data.xpAwarded || selectedChallenge.xp_reward || 100} XP AWARDED
                  </span>
                  <span class="badge bg-black border border-info text-info small">
                    Level ${data.newLevel || 1}
                  </span>
                </div>
              </div>

              ${data.flag ? `
                <div class="mt-2 p-2 rounded bg-black border border-success d-flex justify-content-between align-items-center flex-wrap gap-2">
                  <div>
                    <span class="text-muted small">FLAG CAPTURED:</span>
                    <code class="text-warning fw-bold ms-2" style="font-size: 0.9rem;" id="capturedFlagCode">${escapeHtml(data.flag)}</code>
                  </div>
                  <button type="button" class="btn btn-sm btn-outline-success font-monospace py-0 px-2" id="copyFlagBtn" style="font-size: 0.72rem;">
                    📋 Copy Flag
                  </button>
                </div>
              ` : ''}
            </div>
          `;

          const copyBtn = document.getElementById('copyFlagBtn');
          if (copyBtn) {
            copyBtn.addEventListener('click', () => {
              const flagText = document.getElementById('capturedFlagCode')?.innerText;
              if (flagText && navigator.clipboard) {
                navigator.clipboard.writeText(flagText);
                copyBtn.innerText = '✔ COPIED!';
                setTimeout(() => copyBtn.innerText = '📋 Copy Flag', 2000);
              }
            });
          }

          // Mark challenge as solved locally
          userSolvedChallengeIds.add(Number(selectedChallenge.id));
          if (challengeStatusBadge) {
            challengeStatusBadge.innerText = 'SOLVED';
            challengeStatusBadge.className = 'badge bg-black border border-success text-success px-2 py-1';
          }
          if (sidebarStatusText) {
            sidebarStatusText.innerText = 'SOLVED (PASS)';
            sidebarStatusText.className = 'text-success fw-bold';
          }

          // Visual celebration feedback on Monaco editor card
          if (editorCard) {
            editorCard.style.transition = 'box-shadow 0.4s ease, border-color 0.4s ease';
            editorCard.style.borderColor = '#00ff66';
            editorCard.style.boxShadow = '0 0 25px rgba(0, 255, 102, 0.6)';
            setTimeout(() => {
              editorCard.style.borderColor = '#00e5ff';
              editorCard.style.boxShadow = '0 0 15px rgba(0, 229, 255, 0.2)';
            }, 2500);
          }

          appendConsoleLog(`<span class="text-success fw-bold">[TEST SUITE PASSED] All ${totalCount} test cases validated successfully for #${selectedChallenge.id}: ${selectedChallenge.title}! (+${data.xpAwarded} XP) [Solved in ${formatTime(elapsed)}]</span><br>`);
          addTelemetry(`MISSION COMPLETE: Challenge #${selectedChallenge.id} passed all ${totalCount} test cases!`);

          // Broadcast victory to peer collaborators across room
          if (broadcastChannel) {
            broadcastChannel.postMessage({
              type: 'challenge_solved',
              challengeId: selectedChallenge.id,
              challengeTitle: selectedChallenge.title,
              solver: currentUser,
              testsPassed: passedCount,
              testsTotal: totalCount,
              xpAwarded: data.xpAwarded || selectedChallenge.xp_reward
            });
          }

          if (roomDocRef) {
            setDoc(roomDocRef, {
              lastSolvedChallenge: {
                id: selectedChallenge.id,
                title: selectedChallenge.title,
                solver: currentUser,
                testsPassed: passedCount,
                testsTotal: totalCount,
                timestamp: Date.now()
              }
            }, { merge: true }).catch(e => console.warn('Room sync notice:', e));
          }

        } else {
          // Play warning audio feedback on test failure
          playUrgencyBeep('critical');

          // Failure banner
          testResultsSummaryHeader.innerHTML = `
            <div class="p-2 mb-3 rounded border border-danger font-monospace text-light" style="background: rgba(255, 68, 102, 0.08); box-shadow: 0 0 12px rgba(255, 68, 102, 0.2);">
              <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                  <div class="text-danger fw-bold">
                    ❌ TEST SUITE FAILED: ${passedCount}/${totalCount} PASSED (${failedCount} FAILED)
                  </div>
                  <div class="text-muted small">
                    One or more predefined security exploits or edge case assertions failed. Inspect details below.
                  </div>
                </div>
                <span class="badge bg-danger text-black fw-bold px-2 py-1">REVISE BUFFER</span>
              </div>
            </div>
          `;

          // Flash editor border with red warning glow
          if (editorCard) {
            editorCard.style.transition = 'box-shadow 0.3s ease, border-color 0.3s ease';
            editorCard.style.borderColor = '#ff4466';
            editorCard.style.boxShadow = '0 0 20px rgba(255, 68, 102, 0.5)';
            setTimeout(() => {
              editorCard.style.borderColor = '#00e5ff';
              editorCard.style.boxShadow = '0 0 15px rgba(0, 229, 255, 0.2)';
            }, 1800);
          }

          appendConsoleLog(`<span class="text-danger">[TEST SUITE] Submission failed: ${passedCount}/${totalCount} tests passed. See Test Runner tab for diagnostics.</span><br>`);
          addTelemetry(`Validation finished with ${failedCount} failing tests on challenge #${selectedChallenge.id}.`);
        }
      }

      // Render Individual Test Cases Results List
      if (testCasesResultsList) {
        const results = data.testResults || [];
        testCasesResultsList.innerHTML = results.map(r => `
          <div class="p-2 rounded font-monospace" style="background: ${r.passed ? 'rgba(0, 255, 102, 0.04)' : 'rgba(255, 68, 102, 0.06)'}; border: 1px solid ${r.passed ? '#1a4731' : '#5c1d24'};">
            <div class="d-flex justify-content-between align-items-center mb-1 flex-wrap gap-1">
              <div class="d-flex align-items-center gap-2">
                <span class="badge ${r.passed ? 'bg-success text-black' : 'bg-danger text-white'} fw-bold" style="font-size: 0.68rem;">
                  ${r.passed ? '✔ PASS' : '✖ FAIL'}
                </span>
                <span class="text-light fw-bold" style="font-size: 0.8rem;">${escapeHtml(r.name)}</span>
                <span class="badge bg-black border border-secondary text-info" style="font-size: 0.65rem;">${escapeHtml(r.type || 'Functional')}</span>
              </div>
              <span class="text-muted" style="font-size: 0.7rem;">${r.durationMs || 10}ms</span>
            </div>
            <div class="row g-1 text-muted" style="font-size: 0.73rem;">
              <div class="col-md-6 text-truncate">
                <span class="text-info">Input:</span> <code>${escapeHtml(r.input)}</code>
              </div>
              <div class="col-md-6 text-truncate">
                <span class="text-warning">Expected:</span> <span class="text-light">${escapeHtml(r.expected)}</span>
              </div>
            </div>
            <div class="mt-1" style="font-size: 0.73rem;">
              <span class="${r.passed ? 'text-success' : 'text-danger'}">Actual:</span> <span class="text-light">${escapeHtml(r.actual)}</span>
            </div>
            ${!r.passed && r.hint ? `
              <div class="mt-2 p-2 rounded bg-black border border-warning text-warning" style="font-size: 0.72rem;">
                💡 <strong>HINT:</strong> ${escapeHtml(r.hint)}
              </div>
            ` : ''}
          </div>
        `).join('');
      }

    } catch (err) {
      console.error('Submission error:', err);
      if (testRunnerLoadingState) testRunnerLoadingState.classList.add('d-none');
      if (testRunnerResultsContainer) testRunnerResultsContainer.classList.remove('d-none');
      if (testResultsSummaryHeader) {
        testResultsSummaryHeader.innerHTML = `
          <div class="p-2 rounded border border-danger bg-black text-danger font-monospace small">
            ❌ <strong>EXECUTION ERROR:</strong> ${escapeHtml(err.message || 'Failed to communicate with test validator.')}
          </div>
        `;
      }
      appendConsoleLog(`<span class="text-danger">[ERROR] Test runner failure: ${escapeHtml(err.message)}</span><br>`);
      addTelemetry(`Test runner error: ${err.message}`);
    } finally {
      isSubmittingChallenge = false;
      if (submitMonacoChallengeBtn) {
        if (timerExpired || timerSecondsRemaining <= 0) {
          submitMonacoChallengeBtn.disabled = true;
          submitMonacoChallengeBtn.innerHTML = '⏰ [ TIME EXPIRED - RESTART TIMER ]';
        } else {
          submitMonacoChallengeBtn.disabled = false;
          submitMonacoChallengeBtn.innerHTML = `🚀 [ VALIDATE &amp; SUBMIT ]`;
        }
      }
    }
  }

  // Bind Challenge, Timer, and Test Runner Event Listeners
  if (challengeSelect) {
    challengeSelect.addEventListener('change', (e) => {
      selectChallenge(e.target.value);
    });
  }

  if (toggleMissionBriefBtn) {
    toggleMissionBriefBtn.addEventListener('click', () => {
      if (missionBriefDrawer) {
        missionBriefDrawer.classList.toggle('d-none');
      }
    });
  }

  if (loadChallengeStarterBtn) {
    loadChallengeStarterBtn.addEventListener('click', () => {
      loadChallengeStarter();
    });
  }

  if (timerToggleBtn) {
    timerToggleBtn.addEventListener('click', () => {
      toggleCountdownTimer();
    });
  }

  if (timerResetBtn) {
    timerResetBtn.addEventListener('click', () => {
      restartCountdownTimer(false, true);
    });
  }

  if (timerSoundToggleBtn) {
    timerSoundToggleBtn.addEventListener('click', () => {
      timerSoundEnabled = !timerSoundEnabled;
      localStorage.setItem('codequest_timer_sound', timerSoundEnabled ? 'true' : 'false');
      timerSoundToggleBtn.innerText = timerSoundEnabled ? '🔊 SOUND: ON' : '🔇 SOUND: OFF';
      timerSoundToggleBtn.classList.toggle('btn-outline-secondary', !timerSoundEnabled);
      timerSoundToggleBtn.classList.toggle('btn-outline-info', timerSoundEnabled);
      if (timerSoundEnabled) {
        playUrgencyBeep('tick');
      }
    });
    // Set initial sound button style
    timerSoundToggleBtn.innerText = timerSoundEnabled ? '🔊 SOUND: ON' : '🔇 SOUND: OFF';
    timerSoundToggleBtn.classList.toggle('btn-outline-secondary', !timerSoundEnabled);
    timerSoundToggleBtn.classList.toggle('btn-outline-info', timerSoundEnabled);
  }

  if (tabContainerLogsBtn) {
    tabContainerLogsBtn.addEventListener('click', () => {
      switchConsoleTab('logs');
    });
  }

  if (tabTestRunnerBtn) {
    tabTestRunnerBtn.addEventListener('click', () => {
      switchConsoleTab('testRunner');
    });
  }

  if (submitMonacoChallengeBtn) {
    submitMonacoChallengeBtn.addEventListener('click', () => {
      submitMonacoChallenge();
    });
  }

  // Initialize first challenge if available
  if (selectedChallenge) {
    renderMissionBrief(selectedChallenge);
  }

  // Initialize countdown timer visuals for initial challenge
  updateTimerVisuals();

  // Bootstrap Monaco Editor
  initMonacoEditor();
</script>

<%- include('../partials/footer') %>
