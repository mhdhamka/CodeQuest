<%- include('../partials/header', { title: 'VS Code Codespace // ' + room.name, fluidBody: true }) %>
<%- include('../partials/navbar', { activeNav: 'workspace' }) %>

<!-- Monaco Editor Styles & Loader CDN -->
<link rel="stylesheet" data-name="vs/editor/editor.main" href="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs/editor/editor.main.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs/loader.min.js"></script>

<style>
  /* VS Code Workspace Styles */
  .vscode-outer-container {
    width: 100%;
    margin: 0 auto;
    border-radius: 8px;
    border: 1px solid var(--vscode-border);
    background-color: var(--vscode-editor-bg);
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.45);
  }

  /* VS Code Window Titlebar */
  .vscode-top-window-bar {
    height: 36px;
    background-color: var(--vscode-titlebar-bg);
    border-bottom: 1px solid var(--vscode-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 12px;
    font-size: 0.78rem;
    user-select: none;
  }

  .vscode-window-dots {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .vscode-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    display: inline-block;
  }
  .dot-red { background-color: #ff5f56; border: 1px solid #e0443e; }
  .dot-yellow { background-color: #ffbd2e; border: 1px solid #dea123; }
  .dot-green { background-color: #27c93f; border: 1px solid #1aab29; }

  /* Workbench Body Layout (Activity Bar + Sidebar + Editor + Side Panel) */
  .vscode-main-layout {
    display: flex;
    min-height: 740px;
    background-color: var(--vscode-editor-bg);
  }

  /* Activity Bar (Vertical 48px rail) */
  .vscode-activity-bar {
    width: 48px;
    background-color: var(--vscode-activitybar-bg);
    border-right: 1px solid var(--vscode-border);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 10px 0;
    gap: 16px;
    flex-shrink: 0;
  }
  .activity-icon-btn {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #858585;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s ease;
    text-decoration: none;
    position: relative;
  }
  .activity-icon-btn:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
  }
  .activity-icon-btn.active {
    color: #ffffff;
    border-left: 2px solid var(--vscode-accent);
  }
  .activity-icon-btn .badge-pill {
    position: absolute;
    top: 2px;
    right: 2px;
    background: var(--vscode-accent);
    color: white;
    font-size: 0.6rem;
    padding: 1px 4px;
    border-radius: 10px;
  }

  /* VS Code Sidebar (File Explorer) */
  .vscode-sidebar-panel {
    width: 220px;
    background-color: var(--vscode-sidebar-bg);
    border-right: 1px solid var(--vscode-border);
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    font-size: 0.8rem;
  }
  .sidebar-header {
    height: 35px;
    padding: 0 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-weight: 600;
    letter-spacing: 0.05em;
    font-size: 0.72rem;
    color: #bbbbbb;
    border-bottom: 1px solid var(--vscode-border);
    text-transform: uppercase;
  }
  .sidebar-section-title {
    padding: 6px 12px;
    font-size: 0.7rem;
    font-weight: 700;
    color: #888888;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 4px;
    cursor: pointer;
  }
  .vscode-file-item {
    padding: 4px 12px 4px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    color: #cccccc;
    cursor: pointer;
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: background 0.12s ease;
  }
  .vscode-file-item:hover {
    background-color: var(--vscode-list-hover);
    color: #ffffff;
  }
  .vscode-file-item.active {
    background-color: var(--vscode-list-active);
    color: #ffffff;
    border-left-color: var(--vscode-accent);
  }

  /* Editor Main Workspace Area */
  .vscode-editor-pane {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    background-color: var(--vscode-editor-bg);
    overflow: hidden;
  }

  /* Tab Bar */
  .vscode-tabs-container {
    height: 36px;
    background-color: var(--vscode-tabs-bg);
    border-bottom: 1px solid var(--vscode-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-right: 8px;
    overflow-x: auto;
  }
  .vscode-tabs-list {
    display: flex;
    align-items: center;
    height: 100%;
    margin: 0;
    padding: 0;
  }
  .vscode-tab {
    height: 100%;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 14px;
    font-size: 0.78rem;
    color: #969696;
    background-color: var(--vscode-tab-inactive);
    border-right: 1px solid var(--vscode-border);
    border-top: 2px solid transparent;
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
  }
  .vscode-tab:hover {
    background-color: #22272e;
    color: #e6edf3;
  }
  .vscode-tab.active {
    background-color: var(--vscode-tab-active);
    color: #ffffff;
    border-top-color: var(--vscode-accent);
  }
  .vscode-tab-close {
    font-size: 11px;
    border-radius: 3px;
    padding: 1px 3px;
    opacity: 0.6;
  }
  .vscode-tab:hover .vscode-tab-close {
    opacity: 1;
  }
  .vscode-tab-close:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  /* Breadcrumbs */
  .vscode-breadcrumbs {
    height: 24px;
    background-color: var(--vscode-editor-bg);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    padding: 0 14px;
    font-size: 0.74rem;
    color: #8b949e;
    gap: 6px;
  }

  /* Monaco Editor Mount */
  #monacoEditorMount {
    width: 100%;
    height: 380px;
    background-color: var(--vscode-editor-bg);
  }

  /* VS Code Status Bar */
  .vscode-statusbar {
    height: 24px;
    background-color: var(--vscode-statusbar-bg);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 10px;
    font-size: 0.72rem;
    user-select: none;
    font-family: var(--gh-font-mono);
  }
  .statusbar-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 0 6px;
    height: 100%;
    cursor: pointer;
  }
  .statusbar-item:hover {
    background-color: rgba(255, 255, 255, 0.15);
  }

  /* VS Code Bottom Panel (Terminal / Output / Vue Preview / Test Runner) */
  .vscode-bottom-panel {
    background-color: var(--vscode-panel-bg);
    border-top: 1px solid var(--vscode-border);
    display: flex;
    flex-direction: column;
    height: 240px;
  }
  .vscode-panel-tabs {
    height: 32px;
    border-bottom: 1px solid var(--vscode-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 10px;
    font-size: 0.74rem;
    text-transform: uppercase;
  }
  .panel-tab-btn {
    background: transparent;
    border: none;
    color: #8b949e;
    font-weight: 600;
    padding: 6px 12px;
    cursor: pointer;
    font-size: 0.72rem;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border-bottom: 2px solid transparent;
  }
  .panel-tab-btn:hover {
    color: #ffffff;
  }
  .panel-tab-btn.active {
    color: #ffffff;
    border-bottom-color: var(--vscode-accent);
  }
  .panel-tab-content {
    flex-grow: 1;
    overflow-y: auto;
    padding: 10px;
    font-family: var(--gh-font-mono);
    font-size: 0.78rem;
  }

  /* Live Vue SFC Preview Panel */
  #vueComponentPreviewArea {
    background: #0d1117;
    border: 1px solid var(--gh-border-default);
    border-radius: 6px;
    padding: 16px;
    min-height: 140px;
    color: #e6edf3;
  }

  /* Remote Peer Cursor Marker in Monaco */
  .peer-remote-cursor-line {
    border-left: 2px solid #58a6ff !important;
    position: relative;
  }
  .peer-cursor-glyph-marker {
    background: #58a6ff;
    width: 6px !important;
    height: 6px !important;
    border-radius: 50%;
    margin-top: 6px;
    margin-left: 4px;
    box-shadow: 0 0 6px #58a6ff;
  }
</style>

<div class="container-fluid px-3 py-2">
  
  <!-- Outer VS Code Workbench Window -->
  <div class="vscode-outer-container">
    
    <!-- Top VS Code Titlebar -->
    <div class="vscode-top-window-bar">
      <!-- Mac Window Buttons + Codespace Identity -->
      <div class="d-flex align-items-center gap-3">
        <div class="vscode-window-dots">
          <span class="vscode-dot dot-red"></span>
          <span class="vscode-dot dot-yellow"></span>
          <span class="vscode-dot dot-green"></span>
        </div>
        <div class="d-flex align-items-center gap-2">
          <i class="codicon codicon-vscode text-info"></i>
          <span class="fw-semibold text-light">codequest-arena</span>
          <span class="text-muted">—</span>
          <span class="text-light" id="topBarRoomTitle"><%= room.name %></span>
          <span class="badge bg-black border border-secondary text-muted small ms-1">[Room #<%= room.id %>]</span>
        </div>
      </div>

      <!-- Center Search & Command Palette Trigger -->
      <div class="d-none d-md-flex align-items-center justify-content-center">
        <div class="px-3 py-1 rounded bg-black border border-secondary text-muted font-monospace small d-flex align-items-center gap-2" style="cursor: pointer; border-color: var(--gh-border-default) !important;" onclick="openCommandPalette()">
          <i class="codicon codicon-search"></i>
          <span>codequest: <span id="titlebarActiveFile">main.go</span></span>
          <kbd style="background: #21262d; border: 1px solid #30363d; color: #c9d1d9; font-size: 0.65rem;">⌘P</kbd>
        </div>
      </div>

      <!-- Right Controls: Port, Branch, Host Lock, Room Actions -->
      <div class="d-flex align-items-center gap-2">
        <span class="badge bg-success text-black fw-semibold d-none d-sm-inline-flex align-items-center gap-1">
          <i class="codicon codicon-radio-tower"></i>
          <span>Port 3000 Active</span>
        </span>
        <span class="badge bg-black border border-info text-info font-monospace d-none d-md-inline-block" id="syncStatusBadge">
          🟢 LIVE
        </span>
        <button class="btn btn-sm btn-outline-secondary py-0 px-2 font-monospace" id="lockModeBtn" style="height: 24px; font-size: 0.7rem;">
          Host: Unlocked
        </button>
        <button class="btn btn-sm btn-gh-secondary py-0 px-2 font-monospace text-light d-flex align-items-center gap-1" id="toggleWorkbenchModeBtn" onclick="toggleWorkbenchMode()" style="height: 24px; font-size: 0.7rem;">
          <i class="codicon codicon-symbol-class text-vue"></i>
          <span>Vue 3 SFC Mode</span>
        </button>
        <a href="/workspace/rooms/<%= room.id %>/edit/" class="btn btn-sm btn-outline-secondary py-0 px-2 font-monospace" style="height: 24px; font-size: 0.7rem;">
          Edit Room
        </a>
      </div>
    </div>

    <!-- Vue 3 Single-File Component Workbench Container (Mounted Dynamically) -->
    <div id="vue-workbench-container" style="display: none; min-height: 600px;"></div>

    <!-- Main Workbench Layout -->
    <div class="vscode-main-layout">
      
      <!-- Activity Bar (Left 48px) -->
      <div class="vscode-activity-bar">
        <a href="javascript:void(0)" class="activity-icon-btn active" id="actBarExplorer" title="Explorer (Ctrl+Shift+E)">
          <i class="codicon codicon-files fs-5"></i>
        </a>
        <a href="javascript:void(0)" class="activity-icon-btn" onclick="openCommandPalette()" title="Search (Ctrl+Shift+F)">
          <i class="codicon codicon-search fs-5"></i>
        </a>
        <a href="javascript:void(0)" class="activity-icon-btn" title="Source Control (Ctrl+Shift+G)">
          <i class="codicon codicon-source-control fs-5"></i>
          <span class="badge-pill">1</span>
        </a>
        <a href="javascript:void(0)" class="activity-icon-btn" onclick="document.getElementById('runContainerBtn').click()" title="Run & Debug (Ctrl+Shift+D)">
          <i class="codicon codicon-debug-alt fs-5"></i>
        </a>
        <a href="javascript:void(0)" class="activity-icon-btn" onclick="toggleMissionDrawer()" title="CTF Challenges (8 available)">
          <i class="codicon codicon-extensions fs-5"></i>
          <span class="badge-pill bg-warning text-black">8</span>
        </a>
        <div class="mt-auto d-flex flex-column gap-2">
          <a href="/projects/profile/" class="activity-icon-btn" title="Developer Profile Dossier">
            <i class="codicon codicon-account fs-5"></i>
          </a>
          <a href="javascript:void(0)" class="activity-icon-btn" title="Settings (Ctrl+,)">
            <i class="codicon codicon-settings-gear fs-5"></i>
          </a>
        </div>
      </div>

      <!-- Sidebar (File Explorer Tree) -->
      <div class="vscode-sidebar-panel" id="vscodeSidebar">
        <div class="sidebar-header">
          <span>Explorer</span>
          <div class="d-flex align-items-center gap-1">
            <i class="codicon codicon-new-file" title="New File" style="cursor: pointer;"></i>
            <i class="codicon codicon-refresh" title="Refresh Explorer" style="cursor: pointer;" onclick="refreshExplorerTree()"></i>
            <i class="codicon codicon-collapse-all" title="Collapse All" style="cursor: pointer;"></i>
          </div>
        </div>

        <div class="py-1">
          <!-- Section 1: Open Editors -->
          <div class="sidebar-section-title">
            <i class="codicon codicon-chevron-down"></i>
            <span>Open Editors</span>
          </div>
          <div id="openEditorsList">
            <div class="vscode-file-item" data-lang="go" onclick="selectWorkspaceLanguage('go')">
              <span class="d-flex align-items-center gap-2">
                <i class="codicon codicon-file-code text-go"></i>
                <span>main.go</span>
              </span>
              <span class="badge badge-go" style="font-size: 0.6rem; padding: 1px 4px;">.go</span>
            </div>
            <div class="vscode-file-item" data-lang="vue" onclick="selectWorkspaceLanguage('vue')">
              <span class="d-flex align-items-center gap-2">
                <i class="codicon codicon-symbol-class text-vue"></i>
                <span>App.vue</span>
              </span>
              <span class="badge badge-vue" style="font-size: 0.6rem; padding: 1px 4px;">.vue</span>
            </div>
            <div class="vscode-file-item" data-lang="python" onclick="selectWorkspaceLanguage('python')">
              <span class="d-flex align-items-center gap-2">
                <i class="codicon codicon-file-code text-warning"></i>
                <span>solution.py</span>
              </span>
              <span class="badge bg-black border border-secondary text-muted" style="font-size: 0.6rem; padding: 1px 4px;">.py</span>
            </div>
          </div>

          <!-- Section 2: CodeQuest Workspace Tree -->
          <div class="sidebar-section-title mt-2">
            <i class="codicon codicon-chevron-down"></i>
            <span>codequest // src</span>
          </div>
          <div class="ps-1">
            <!-- Go file -->
            <div class="vscode-file-item" data-lang="go" onclick="selectWorkspaceLanguage('go')">
              <span class="d-flex align-items-center gap-2">
                <i class="codicon codicon-file-code text-go"></i>
                <span>main.go</span>
              </span>
              <span class="badge badge-go" style="font-size: 0.6rem; padding: 1px 4px;">GO</span>
            </div>
            <!-- Vue 3 SFC file -->
            <div class="vscode-file-item" data-lang="vue" onclick="selectWorkspaceLanguage('vue')">
              <span class="d-flex align-items-center gap-2">
                <i class="codicon codicon-symbol-class text-vue"></i>
                <span>App.vue</span>
              </span>
              <span class="badge badge-vue" style="font-size: 0.6rem; padding: 1px 4px;">VUE</span>
            </div>
            <!-- TypeScript -->
            <div class="vscode-file-item" data-lang="typescript" onclick="selectWorkspaceLanguage('typescript')">
              <span class="d-flex align-items-center gap-2">
                <i class="codicon codicon-file-code text-info"></i>
                <span>handler.ts</span>
              </span>
              <span class="badge bg-black border border-secondary text-muted" style="font-size: 0.6rem; padding: 1px 4px;">TS</span>
            </div>
            <!-- JavaScript -->
            <div class="vscode-file-item" data-lang="javascript" onclick="selectWorkspaceLanguage('javascript')">
              <span class="d-flex align-items-center gap-2">
                <i class="codicon codicon-file-code text-warning"></i>
                <span>index.js</span>
              </span>
              <span class="badge bg-black border border-secondary text-muted" style="font-size: 0.6rem; padding: 1px 4px;">JS</span>
            </div>
            <!-- SQL -->
            <div class="vscode-file-item" data-lang="sql" onclick="selectWorkspaceLanguage('sql')">
              <span class="d-flex align-items-center gap-2">
                <i class="codicon codicon-database text-light"></i>
                <span>query.sql</span>
              </span>
              <span class="badge bg-black border border-secondary text-muted" style="font-size: 0.6rem; padding: 1px 4px;">SQL</span>
            </div>
            <!-- C++ -->
            <div class="vscode-file-item" data-lang="cpp" onclick="selectWorkspaceLanguage('cpp')">
              <span class="d-flex align-items-center gap-2">
                <i class="codicon codicon-file-code text-primary"></i>
                <span>main.cpp</span>
              </span>
              <span class="badge bg-black border border-secondary text-muted" style="font-size: 0.6rem; padding: 1px 4px;">CPP</span>
            </div>
            <!-- Shell -->
            <div class="vscode-file-item" data-lang="shell" onclick="selectWorkspaceLanguage('shell')">
              <span class="d-flex align-items-center gap-2">
                <i class="codicon codicon-terminal text-success"></i>
                <span>deploy.sh</span>
              </span>
              <span class="badge bg-black border border-secondary text-muted" style="font-size: 0.6rem; padding: 1px 4px;">SH</span>
            </div>
          </div>

          <!-- Section 3: CTF Raids Folder -->
          <div class="sidebar-section-title mt-2">
            <i class="codicon codicon-chevron-down"></i>
            <span>ctf-targets</span>
          </div>
          <div class="ps-1">
            <div class="vscode-file-item" onclick="selectChallenge(7)">
              <span class="d-flex align-items-center gap-2">
                <i class="codicon codicon-bug text-go"></i>
                <span>07_race_condition.go</span>
              </span>
              <span class="badge badge-go" style="font-size: 0.6rem;">#7</span>
            </div>
            <div class="vscode-file-item" onclick="selectChallenge(8)">
              <span class="d-flex align-items-center gap-2">
                <i class="codicon codicon-shield text-vue"></i>
                <span>08_vue_xss.vue</span>
              </span>
              <span class="badge badge-vue" style="font-size: 0.6rem;">#8</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Center: Editor Pane + Bottom Panels -->
      <div class="vscode-editor-pane">
        
        <!-- VS Code Tab Bar -->
        <div class="vscode-tabs-container">
          <div class="vscode-tabs-list" id="editorTabsBar">
            <!-- Go Tab -->
            <div class="vscode-tab" id="tabGo" data-lang="go" onclick="selectWorkspaceLanguage('go')">
              <i class="codicon codicon-file-code text-go"></i>
              <span>main.go</span>
              <span class="badge badge-go" style="font-size: 0.6rem; padding: 1px 4px;">.go</span>
              <span class="vscode-tab-close" onclick="event.stopPropagation()">×</span>
            </div>
            <!-- Vue Tab -->
            <div class="vscode-tab" id="tabVue" data-lang="vue" onclick="selectWorkspaceLanguage('vue')">
              <i class="codicon codicon-symbol-class text-vue"></i>
              <span>App.vue</span>
              <span class="badge badge-vue" style="font-size: 0.6rem; padding: 1px 4px;">.vue</span>
              <span class="vscode-tab-close" onclick="event.stopPropagation()">×</span>
            </div>
            <!-- Python Tab -->
            <div class="vscode-tab active" id="tabPython" data-lang="python" onclick="selectWorkspaceLanguage('python')">
              <i class="codicon codicon-file-code text-warning"></i>
              <span>solution.py</span>
              <span class="vscode-tab-close" onclick="event.stopPropagation()">×</span>
            </div>
            <!-- JavaScript Tab -->
            <div class="vscode-tab" id="tabJavascript" data-lang="javascript" onclick="selectWorkspaceLanguage('javascript')">
              <i class="codicon codicon-file-code text-warning"></i>
              <span>index.js</span>
              <span class="vscode-tab-close" onclick="event.stopPropagation()">×</span>
            </div>
          </div>

          <!-- Top-Right Editor Action Icons -->
          <div class="d-flex align-items-center gap-2">
            <!-- Run Container Button -->
            <button class="btn btn-sm btn-gh-primary py-0 px-2 d-flex align-items-center gap-1 font-monospace" id="runContainerBtn" style="height: 26px; font-size: 0.72rem;" title="Run in container sandbox">
              <i class="codicon codicon-play"></i>
              <span>Run</span>
            </button>
            <!-- Validate & Submit Button -->
            <button class="btn btn-sm btn-gh-secondary py-0 px-2 d-flex align-items-center gap-1 font-monospace text-light" id="submitMonacoChallengeBtn" style="height: 26px; font-size: 0.72rem;" title="Run test suite & submit">
              <i class="codicon codicon-pass text-success"></i>
              <span>Test &amp; Submit</span>
            </button>
            <span class="text-muted">|</span>
            <!-- Format Buffer -->
            <button class="btn btn-sm btn-dark py-0 px-2 text-muted" id="btnFormatCode" title="Format Buffer" style="background: transparent; border: none; height: 26px;">
              <i class="codicon codicon-symbol-misc"></i>
            </button>
            <!-- Minimap toggle -->
            <button class="btn btn-sm btn-dark py-0 px-2 text-muted" id="btnToggleMinimap" title="Toggle Minimap" style="background: transparent; border: none; height: 26px;">
              <i class="codicon codicon-layout-sidebar-right"></i>
            </button>
            <!-- Zoom -->
            <div class="btn-group btn-group-sm">
