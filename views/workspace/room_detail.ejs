// Real-time Go Microservice & Goroutine Concurrency Arena
package main

import (
	"fmt"
	"sync"
	"time"
)

type BankAccount struct {
	mu      sync.Mutex
	balance int
}

func (a *BankAccount) Deposit(amount int) {
	a.mu.Lock()
	defer a.mu.Unlock()
	a.balance += amount
}

func (a *BankAccount) Balance() int {
	a.mu.Lock()
	defer a.mu.Unlock()
	return a.balance
}

func main() {
	account := &BankAccount{balance: 0}
	var wg sync.WaitGroup

	// Launch 100 concurrent workers
	for i := 0; i < 100; i++ {
		wg.Add(1)
		go func(workerId int) {
			defer wg.Done()
			account.Deposit(10)
		}(i)
	}

	wg.Wait()
	fmt.Printf("[OK] Concurrency safe balance: %d (Expected: 1000)\\n", account.Balance())
