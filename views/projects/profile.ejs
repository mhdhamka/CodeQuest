<%- include('../partials/header', { title: 'CodeQuest // ' + userProfile.username + ' Profile' }) %>
<%- include('../partials/navbar', { activeNav: 'dossier' }) %>

<div class="container my-4">
  
  <div class="row g-4">
    <!-- Left Column: GitHub User Profile Card -->
    <div class="col-lg-4">
      <div class="p-3 rounded border font-monospace" style="background: var(--gh-canvas-default); border-color: var(--gh-border-default) !important;">
        <!-- Avatar -->
        <div class="text-center mb-3">
          <div class="position-relative d-inline-block">
            <% if (userProfile.avatar) { %>
              <img src="<%= userProfile.avatar %>" alt="Developer Avatar" class="rounded-circle border border-secondary shadow" style="width: 130px; height: 130px; object-fit: cover;">
            <% } else { %>
              <div class="rounded-circle border border-secondary d-flex align-items-center justify-content-center bg-dark text-muted" style="width: 130px; height: 130px; font-size: 3rem;">
                <i class="codicon codicon-account"></i>
              </div>
            <% } %>
            <span class="position-absolute bottom-0 end-0 bg-success border border-dark rounded-circle p-1" title="Online" style="width: 22px; height: 22px;"></span>
          </div>

          <h2 class="h4 text-light fw-bold mt-3 mb-1" id="profileUsername"><%= userProfile.username %></h2>
          <div class="text-muted small mb-2"><%= userProfile.email || 'developer@codequest.dev' %></div>
          <div class="d-flex justify-content-center gap-1 mb-3">
            <span class="badge badge-go"><i class="codicon codicon-file-code"></i> Go</span>
            <span class="badge badge-vue"><i class="codicon codicon-symbol-class"></i> Vue</span>
            <span class="badge bg-black border border-secondary text-info"><%= userProfile.role_class_display %></span>
          </div>
        </div>

        <!-- Clearance & XP Bar -->
        <div class="p-3 rounded bg-black border mb-3" style="border-color: var(--gh-border-default) !important;">
          <div class="d-flex justify-content-between align-items-center mb-1 small">
            <span class="text-muted">Clearance Level:</span>
            <span class="text-success fw-bold" id="profileLevelDisplay">LVL <%= userProfile.level %></span>
          </div>
          <div class="d-flex justify-content-between align-items-center mb-2 small">
            <span class="text-muted">Total XP Earned:</span>
            <span class="text-info fw-bold" id="profileXpDisplay"><%= userProfile.xp %> XP</span>
          </div>
          <div class="progress" style="height: 6px; background-color: #21262d;">
            <div class="progress-bar bg-success" style="width: <%= Math.min(100, (userProfile.xp % 1000) / 10) %>%;"></div>
          </div>
        </div>

        <!-- Details & Cloud Persistence -->
        <div class="small text-muted mb-3 d-flex flex-column gap-2" style="font-size: 0.78rem;">
          <div class="d-flex align-items-center gap-2">
            <i class="codicon codicon-organization text-muted"></i>
            <span>CodeQuest Developers</span>
          </div>
          <div class="d-flex align-items-center gap-2">
            <i class="codicon codicon-location text-muted"></i>
            <span>Codespace Container / US-Central</span>
          </div>
          <div class="d-flex align-items-center gap-2">
            <i class="codicon codicon-cloud text-info"></i>
            <span>Firestore Document: <code>/users/<%= userProfile.uid %></code></span>
          </div>
          <div class="d-flex align-items-center gap-2">
            <i class="codicon codicon-shield text-warning"></i>
            <span>Identity: <strong class="text-light"><%= userProfile.googleLinked ? 'Google Linked' : (userProfile.githubLinked ? 'GitHub Linked' : 'Codespace Operative') %></strong></span>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="d-grid gap-2">
          <button class="btn btn-sm btn-gh-secondary font-monospace d-flex align-items-center justify-content-center gap-2 text-light" onclick="syncFirebaseCloudProgress()" id="btnManualCloudSync">
            <i class="codicon codicon-sync"></i>
            <span>Sync Firestore Cloud</span>
          </button>
          <% if (!(userProfile.googleLinked || userProfile.githubLinked)) { %>
            <button class="btn btn-sm btn-gh-primary font-monospace" onclick="openAuthModal()">
              Sign in with GitHub / Google
            </button>
          <% } else { %>
            <button class="btn btn-sm btn-outline-danger font-monospace" type="button" data-bs-toggle="modal" data-bs-target="#logoutConfirmModal">
              Disconnect Session
            </button>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Right Column: Captured Flags & Codespace History -->
    <div class="col-lg-8">
      <!-- Top Overview Box -->
      <div class="p-3 rounded border mb-4 font-monospace" style="background: var(--gh-canvas-default); border-color: var(--gh-border-default) !important;">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <div class="d-flex align-items-center gap-2">
            <i class="codicon codicon-pass text-success fs-5"></i>
            <h3 class="h5 text-light fw-bold mb-0">Captured CTF Flags &amp; Verified Exploits</h3>
          </div>
          <span class="badge bg-black border border-success text-success"><%= solved_submissions.length %> Completed</span>
        </div>
        <p class="text-muted small mb-0" style="font-size: 0.78rem;">
          Cryptographically signed flags secured by patching vulnerable code architectures in the Monaco codespace sandbox.
        </p>
      </div>

      <!-- Solved Submissions List (GitHub Release / Commit Style) -->
      <div class="d-flex flex-column gap-3 mb-4 font-monospace">
        <% if (solved_submissions && solved_submissions.length > 0) { %>
          <% solved_submissions.forEach(function(sub) { 
              var titleLower = (sub.challenge.title || '').toLowerCase();
              var isGo = titleLower.includes('go') || sub.challenge.id === 7;
              var isVue = titleLower.includes('vue') || sub.challenge.id === 8;
          %>
            <div class="p-3 rounded border d-flex justify-content-between align-items-center flex-wrap gap-2" style="background: var(--gh-canvas-default); border-color: var(--gh-border-default) !important;">
              <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                  <% if (isGo) { %>
                    <span class="badge badge-go"><i class="codicon codicon-file-code"></i> Go</span>
                  <% } else if (isVue) { %>
                    <span class="badge badge-vue"><i class="codicon codicon-symbol-class"></i> Vue</span>
                  <% } else { %>
                    <span class="badge bg-black border border-secondary text-info">#<%= sub.challenge.id %></span>
                  <% } %>
                  <strong class="text-light" style="font-size: 0.9rem;"><%= sub.challenge.title %></strong>
                </div>
                <div class="text-muted small mb-1" style="font-size: 0.74rem;">
                  <i class="codicon codicon-history"></i> Captured <%= new Date(sub.solved_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                </div>
                <div class="small" style="font-size: 0.74rem;">
                  <span class="text-muted">Flag:</span> <code><%= sub.submitted_flag %></code>
                </div>
              </div>

              <div class="text-end">
                <span class="badge bg-success text-black fw-bold px-3 py-1">+<%= sub.challenge.xp_reward %> XP</span>
                <div class="mt-2">
                  <a href="/projects/challenge/<%= sub.challenge.id %>/" class="btn btn-sm btn-gh-secondary text-light py-0 px-2" style="font-size: 0.72rem;">
                    View Raid
                  </a>
                </div>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="p-4 rounded border text-center text-muted font-monospace" style="background: var(--gh-canvas-default); border-color: var(--gh-border-default) !important;">
            <i class="codicon codicon-shield text-warning fs-3 mb-2"></i>
            <div>No CTF flags captured yet.</div>
            <a href="/projects/" class="btn btn-sm btn-gh-primary mt-2">Start First Raid</a>
          </div>
        <% } %>
      </div>

      <!-- Quick Codespace Links -->
      <div class="p-3 rounded border font-monospace" style="background: var(--gh-canvas-default); border-color: var(--gh-border-default) !important;">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <span class="text-light fw-bold d-flex align-items-center gap-2">
            <i class="codicon codicon-vscode text-info"></i> Jump to Codespace
          </span>
          <a href="/workspace/" class="text-info text-decoration-none small">All Codespaces →</a>
        </div>
        <div class="d-flex gap-2 flex-wrap">
          <a href="/workspace/1?lang=go" class="btn btn-sm btn-gh-secondary text-light d-flex align-items-center gap-1">
            <i class="codicon codicon-file-code text-go"></i> Go Codespace
          </a>
          <a href="/workspace/1?lang=vue" class="btn btn-sm btn-gh-secondary text-light d-flex align-items-center gap-1">
            <i class="codicon codicon-symbol-class text-vue"></i> Vue Codespace
          </a>
          <a href="/workspace/1?lang=python" class="btn btn-sm btn-gh-secondary text-light d-flex align-items-center gap-1">
            <i class="codicon codicon-file-code text-warning"></i> Python Codespace
          </a>
        </div>
      </div>
    </div>
  </div>

</div>

<%- include('../partials/footer') %>
