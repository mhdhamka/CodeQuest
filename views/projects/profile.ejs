<%- include('../partials/header', { title: 'Player Dossier // ' + userProfile.username }) %>
<%- include('../partials/navbar', { activeNav: 'dossier' }) %>

<div class="container my-4">
  <!-- Hero Header / Player Dossier Briefing -->
  <div class="row mb-4 text-center">
    <div class="col">
      <div class="d-inline-block border border-warning bg-black px-3 py-1 rounded-pill mb-3 shadow-sm">
        <span class="text-warning font-monospace small tracking-widest">// OPERATIVE_DOSSIER_SYSTEM</span>
      </div>
      <h1 class="display-5 fw-bold text-light font-monospace" style="text-shadow: 0 0 25px rgba(255, 193, 7, 0.4);">
        OPERATIVE DOSSIER <span class="text-info">// TELEMETRY</span>
      </h1>
      <p class="lead text-muted font-monospace mt-2 mx-auto" style="font-size: 0.95rem; max-width: 720px; line-height: 1.7;">
        [RECORD ACTIVE]: Personal clearance metrics, captured CTF tactical flags, and Firebase Cloud progression synchronization.
      </p>
    </div>
  </div>

  <!-- Identity & Cloud Link Status Banner (if not linked) -->
  <% if (!(userProfile && (userProfile.googleLinked || userProfile.githubLinked))) { %>
    <div class="alert alert-dark border border-info bg-black text-light font-monospace shadow-lg mb-4 p-3 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 rounded" style="box-shadow: 0 0 20px rgba(0, 240, 255, 0.15) !important;">
      <div class="d-flex align-items-center gap-3">
        <span class="display-6 text-info">⚡</span>
        <div>
          <h5 class="text-info mb-1 fw-bold">// LINK YOUR OPERATIVE IDENTITY</h5>
          <p class="text-muted small mb-0">
            Sign in with Google (via configured OAuth) or GitHub to save your CodeQuest progress, clearance level, and captured flags permanently to Cloud Firestore.
          </p>
        </div>
      </div>
      <div class="d-flex gap-2 flex-wrap flex-shrink-0">
        <button class="btn btn-outline-info font-monospace fw-bold px-3 py-2 text-white shadow-sm d-flex align-items-center gap-2" onclick="openAuthModal()" id="profileLinkGoogleBtn" style="border-color: #4285F4; background: rgba(66, 133, 244, 0.2);">
          <svg width="16" height="16" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17Z"/>
            <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24Z"/>
            <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.98 0 12s.45 3.82 1.25 5.42l4.03-3.15Z"/>
            <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98Z"/>
          </svg>
          <span>GOOGLE SIGN IN</span>
        </button>
        <button class="btn btn-warning font-monospace fw-bold px-3 py-2 text-dark shadow-sm d-flex align-items-center gap-2" onclick="openAuthModal()" id="profileLinkGithubBtn" style="background-color: #ffe600; border: none; box-shadow: 0 0 10px rgba(255, 230, 0, 0.4);">
          <svg height="15" width="15" viewBox="0 0 16 16" fill="currentColor">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
          </svg>
          <span>GITHUB SIGN IN</span>
        </button>
      </div>
    </div>
  <% } %>

  <div class="row g-4">
    <!-- Profile Stats Card -->
    <div class="col-lg-4">
      <div class="card bg-dark text-white border-warning shadow-lg h-100 position-relative overflow-hidden hover-lift" style="background-color: #12161f !important; box-shadow: 0 0 15px rgba(255, 193, 7, 0.12);">
        <div class="position-absolute top-0 start-0 w-100 <%= userProfile.googleLinked ? 'bg-info' : 'bg-warning' %>" style="height: 3px;"></div>
        <div class="card-body p-4 text-center d-flex flex-column justify-content-between">
          <div>
            <!-- Avatar Display -->
            <div class="mb-3 mt-2 position-relative d-inline-block">
              <% if (userProfile.avatar) { %>
                <img src="<%= userProfile.avatar %>" alt="Operative Avatar" class="rounded-circle border <%= userProfile.googleLinked ? 'border-info' : 'border-warning' %> shadow" style="width: 88px; height: 88px; object-fit: cover; box-shadow: 0 0 15px rgba(0, 240, 255, 0.35) !important;">
              <% } else { %>
                <span class="badge bg-black border border-warning text-warning p-3 rounded-circle shadow-sm font-monospace display-6">
                  🛡️
                </span>
              <% } %>
              <% if (userProfile.googleLinked || userProfile.githubLinked) { %>
                <span class="position-absolute bottom-0 end-0 bg-success border border-black rounded-circle p-1" title="Identity Verified" style="width: 22px; height: 22px; font-size: 10px; display: flex; align-items: center; justify-content: center;">✔</span>
              <% } %>
            </div>

            <h3 class="fw-bold text-light font-monospace mb-1" id="profileUsername">
              <%= userProfile.username %>
            </h3>

            <% if (userProfile.email) { %>
              <div class="text-muted small font-monospace mb-2 text-truncate" style="font-size: 0.8rem;">
                <%= userProfile.email %>
              </div>
            <% } %>

            <% if (userProfile.githubLinked) { %>
              <div class="mb-2">
                <a href="https://github.com/<%= userProfile.username %>" target="_blank" rel="noopener noreferrer" class="text-info small font-monospace text-decoration-none d-inline-flex align-items-center gap-1">
                  <span>github.com/<%= userProfile.username %></span> ↗
                </a>
              </div>
            <% } %>

            <div class="mb-3">
              <% if (userProfile.googleLinked) { %>
                <span class="badge bg-black border border-info text-info px-3 py-1 font-monospace small shadow-sm">
                  🌐 GOOGLE_LINKED
                </span>
              <% } else if (userProfile.githubLinked) { %>
                <span class="badge bg-black border border-success text-success px-3 py-1 font-monospace small shadow-sm">
                  🐙 GITHUB_LINKED
                </span>
              <% } else { %>
                <span class="badge bg-black border border-secondary text-warning px-3 py-1 font-monospace small shadow-sm">
                  GUEST_OPERATIVE
                </span>
              <% } %>
              <span class="badge bg-black border border-info text-info px-3 py-1 font-monospace small shadow-sm ms-1">
                <%= userProfile.role_class_display %>
              </span>
            </div>

            <hr class="border-secondary my-3">

            <!-- Level and XP Counters -->
            <div class="d-flex justify-content-around text-center my-3 font-monospace">
              <div class="p-2 bg-black bg-opacity-50 border border-secondary rounded flex-fill me-2 shadow-sm">
                <small class="text-muted d-block mb-1 font-monospace">CLEARANCE</small>
                <span class="h4 fw-bold text-success font-monospace" id="profileLevelDisplay">LVL <%= userProfile.level %></span>
              </div>
              <div class="p-2 bg-black bg-opacity-50 border border-secondary rounded flex-fill ms-2 shadow-sm">
                <small class="text-muted d-block mb-1 font-monospace">TOTAL XP</small>
                <span class="h4 fw-bold text-info font-monospace" id="profileXpDisplay"><%= userProfile.xp %></span>
              </div>
            </div>

            <!-- Profile Action Controls -->
            <div class="d-grid gap-2 mt-3 font-monospace">
              <button class="btn btn-outline-warning btn-sm d-flex align-items-center justify-content-center gap-2" onclick="syncFirebaseCloudProgress()" id="btnManualCloudSync">
                <span>⚡</span> <span>SYNC TO FIRESTORE CLOUD</span>
              </button>

              <% if (userProfile.googleLinked || userProfile.githubLinked) { %>
                <button class="btn btn-outline-danger btn-sm d-flex align-items-center justify-content-center gap-2" type="button" data-bs-toggle="modal" data-bs-target="#logoutConfirmModal" id="btnDisconnectSession">
                  <span>🚪</span> <span>DISCONNECT SESSION</span>
                </button>
              <% } else { %>
                <button class="btn btn-info btn-sm d-flex align-items-center justify-content-center gap-2 text-dark fw-bold" onclick="openAuthModal()" id="btnModalLinkAuth">
                  <span>⚡</span> <span>SIGN IN & PERSIST PROGRESS</span>
                </button>
              <% } %>
            </div>
          </div>

          <div class="mt-4 pt-3 border-top border-secondary">
            <div class="text-muted font-monospace small">
              SESSION: <span class="text-info fw-bold"><%= (userProfile.googleLinked || userProfile.githubLinked) ? 'CLOUD_SYNCHRONIZED' : 'LOCAL_STORAGE' %></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Solved Challenges & Cloud Telemetry Card -->
    <div class="col-lg-8">
      <!-- Firestore Cloud Telemetry Info Box -->
      <div class="card bg-dark text-white border-secondary mb-4 p-3 rounded shadow-sm font-monospace" style="background-color: #0b0f17 !important;">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
          <div>
            <div class="small text-info fw-bold d-flex align-items-center gap-2 mb-1">
              <span class="spinner-grow spinner-grow-sm text-info" role="status" style="width: 0.5rem; height: 0.5rem;"></span>
              FIREBASE FIRESTORE CLOUD LINK
            </div>
            <div class="text-muted small" style="font-size: 0.78rem;">
              DATABASE: <code class="text-warning">ai-studio-codequest-ec4fb69b-f265-4317-a519-d663784b2c96</code>
            </div>
            <div class="text-muted small" style="font-size: 0.78rem;">
              DOC_PATH: <code class="text-info">/users/<%= userProfile.uid %></code>
            </div>
          </div>
          <div>
            <span class="badge bg-black border border-info text-info py-2 px-3">
              AUTH_STATUS: <strong class="<%= (userProfile.googleLinked || userProfile.githubLinked) ? 'text-success' : 'text-warning' %>"><%= userProfile.googleLinked ? 'GOOGLE_VERIFIED' : (userProfile.githubLinked ? 'GITHUB_VERIFIED' : 'GUEST_MODE') %></strong>
            </span>
          </div>
        </div>
      </div>

      <!-- Solved Challenges Card -->
      <div class="card bg-dark text-white border-info shadow-lg h-100 position-relative overflow-hidden" style="background-color: #12161f !important; box-shadow: 0 0 15px rgba(13, 202, 240, 0.12);">
        <div class="position-absolute top-0 start-0 w-100 bg-info" style="height: 3px;"></div>
        <div class="card-body p-4 d-flex flex-column justify-content-between">
          <div>
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h2 class="h4 text-info border-bottom border-info pb-2 mb-0 font-monospace d-flex align-items-center gap-2 w-100" style="text-shadow: 0 0 10px rgba(13, 202, 240, 0.3);">
                <span>🚩</span> CAPTURED_FLAGS // <span class="text-light small">Verified Challenge Submissions</span>
              </h2>
            </div>
            
            <% if (solved_submissions && solved_submissions.length > 0) { %>
              <div class="list-group list-group-flush bg-transparent font-monospace mt-3">
                <% solved_submissions.forEach(function(sub) { %>
                  <div class="list-group-item bg-black bg-opacity-50 text-white border-secondary d-flex justify-content-between align-items-center py-3 mb-2 rounded shadow-sm" style="transition: border-color 0.2s ease;">
                    <div>
                      <h6 class="mb-1 text-info fw-bold font-monospace">⚡ <%= sub.challenge.title %></h6>
                      <small class="text-muted font-monospace">TIMESTAMP: <%= new Date(sub.solved_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></small>
                      <div class="text-secondary small mt-1 font-monospace" style="font-size: 0.75rem;">
                        FLAG: <code><%= sub.submitted_flag %></code>
                      </div>
                    </div>
                    <span class="badge bg-black border border-success text-success fw-bold px-3 py-2 shadow-sm">+<%= sub.challenge.xp_reward %> XP</span>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <div class="text-center py-5 font-monospace">
                <div class="alert alert-dark border border-secondary text-muted py-4 bg-black shadow mb-3">
                  // NO_FLAGS_CAPTURED: No exploit telemetry found. Infiltrate the challenge arena to earn clearance.
                </div>
                <a href="/projects/" class="btn btn-outline-info btn-sm fw-bold px-4 py-2 shadow-sm">
                  [ GO TO ARENA_MAIN_MENU ] →
                </a>
              </div>
            <% } %>
          </div>
          <div class="mt-4 pt-3 border-top border-secondary d-flex justify-content-between align-items-center">
            <span class="text-muted font-monospace small">TOTAL FLAGS SECURED: <strong class="text-success" id="totalFlagsCount"><%= solved_submissions.length %></strong></span>
            <a href="/projects/" class="btn btn-sm btn-outline-info font-monospace">[ EXPLORE MORE RAIDS → ]</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .hover-lift {
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease-in-out;
  }
  .hover-lift:hover {
    transform: translateY(-6px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.8) !important;
  }
</style>

<%- include('../partials/footer') %>
