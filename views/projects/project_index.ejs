<%- include('../partials/header', { title: 'CTF Security Arena // Projects & Challenges' }) %>
<%- include('../partials/navbar', { activeNav: 'ctf' }) %>

<div class="container my-4">
  <!-- Hero Header / Game Mission Briefing -->
  <div class="row mb-5 text-center">
    <div class="col">
      <div class="d-inline-block border border-info bg-black px-3 py-1 rounded-pill mb-3 shadow-sm">
        <span class="text-info font-monospace small tracking-widest">// SECURE_OPERATIONS_COMMAND</span>
      </div>
      <h1 class="display-4 fw-bold text-light font-monospace" style="text-shadow: 0 0 25px rgba(13, 202, 240, 0.4);">
        CTF SECURITY ARENA <span class="text-warning"></span>
      </h1>
      <p class="lead text-muted font-monospace mt-3 mx-auto" style="font-size: 0.95rem; max-width: 700px; line-height: 1.7;">
        [MISSION BRIEFING]: Raid encrypted challenge dungeons, exploit vulnerable code architectures, decrypt telemetry data, and capture high-value flags.
      </p>
    </div>
  </div>

  <!-- Portfolio Projects Section -->
  <div class="row align-items-center mb-4">
    <div class="col">
      <h2 class="h4 text-info border-bottom border-info pb-2 mb-0 font-monospace d-flex align-items-center gap-2" style="text-shadow: 0 0 10px rgba(13, 202, 240, 0.3);">
        <span></span> ARCHIVE_VAULT // <span class="text-light small">Production Systems & Deployments</span>
      </h2>
    </div>
  </div>

  <div class="row g-4 mb-4">
    <% if (projects && projects.length > 0) { %>
      <% projects.forEach(function(project) { %>
        <div class="col-md-4">
          <div class="card h-100 shadow-lg border-secondary bg-dark text-white hover-lift position-relative overflow-hidden" style="background-color: #12161f !important;">
            <div class="position-absolute top-0 start-0 w-100 bg-info" style="height: 2px;"></div>
            <% if (project.image && project.image.url) { %>
              <div class="overflow-hidden border-bottom border-secondary position-relative" style="height: 180px;">
                <img src="<%= project.image.url %>" class="card-img-top w-100 h-100 object-fit-cover opacity-75" alt="<%= project.title %>" style="transition: transform 0.4s ease;">
                <div class="position-absolute bottom-0 start-0 bg-black bg-opacity-75 px-2 py-1 m-2 rounded font-monospace small text-info border border-secondary">
                  SYSTEM_BUILD_<%= project.id %>
                </div>
              </div>
            <% } %>
            <div class="card-body d-flex flex-column justify-content-between p-4">
              <div>
                <h5 class="card-title text-info fw-bold font-monospace mb-2"><%= project.title %></h5>
                <p class="card-text text-muted small font-monospace" style="line-height: 1.6;"><%= project.description.slice(0, 100) %>...</p>
              </div>
              <div class="mt-4 pt-3 border-top border-secondary">
                <a href="/projects/project/<%= project.id %>/" class="btn btn-outline-info btn-sm w-100 font-monospace fw-bold">
                  [ INSPECT_SYSTEM ] →
                </a>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div class="col">
        <div class="alert alert-dark border border-secondary text-center text-muted py-4 font-monospace bg-black">
          // NO_PROJECTS_INITIALIZED: Systems offline. Deploy repositories from command center.
        </div>
      </div>
    <% } %>
  </div>

  <!-- Projects Pagination -->
  <% if (projectTotalPages > 1) { %>
    <nav class="my-4 font-monospace">
      <ul class="pagination justify-content-center">
        <% if (projectCurrentPage > 1) { %>
          <li class="page-item"><a class="page-link bg-dark text-info border-secondary shadow" href="?project_page=<%= projectCurrentPage - 1 %>&filter=<%= current_filter %>&q=<%= search_query %>&sort=<%= current_sort %>">◀ PREV_VAULT</a></li>
        <% } else { %>
          <li class="page-item disabled"><span class="page-link bg-dark text-muted border-secondary">◀ PREV_VAULT</span></li>
        <% } %>
        <li class="page-item disabled"><span class="page-link bg-dark text-light border-secondary">SECTOR <%= projectCurrentPage %> / <%= projectTotalPages %></span></li>
        <% if (projectCurrentPage < projectTotalPages) { %>
          <li class="page-item"><a class="page-link bg-dark text-info border-secondary shadow" href="?project_page=<%= projectCurrentPage + 1 %>&filter=<%= current_filter %>&q=<%= search_query %>&sort=<%= current_sort %>">NEXT_VAULT ▶</a></li>
        <% } else { %>
          <li class="page-item disabled"><span class="page-link bg-dark text-muted border-secondary">NEXT_VAULT ▶</span></li>
        <% } %>
      </ul>
    </nav>
  <% } %>

  <!-- CTF Security Challenges Section -->
  <div class="row align-items-center mb-3 mt-5">
    <div class="col-md-4">
      <h2 class="h4 text-warning border-bottom border-warning pb-2 mb-0 font-monospace d-flex align-items-center gap-2" style="text-shadow: 0 0 10px rgba(255, 193, 7, 0.3);">
        <span></span> TACTICAL_RAIDS // <span class="text-light small">Combat Security Zones</span>
      </h2>
    </div>

    <!-- Search Bar & Controls -->
    <div class="col-md-8 text-md-end mt-3 mt-md-0 font-monospace">
      <form method="GET" action="" class="d-flex flex-wrap justify-content-md-end align-items-center gap-2">
        <input type="hidden" name="filter" value="<%= current_filter %>">
        <input type="hidden" name="sort" value="<%= current_sort %>">
        
        <!-- Search Input -->
        <div class="input-group input-group-sm shadow-sm" style="max-width: 250px;">
          <input type="text" name="q" class="form-control bg-dark text-light border-secondary font-monospace" placeholder="Search target raid..." value="<%= search_query %>">
          <button class="btn btn-outline-warning fw-bold" type="submit">🔍</button>
        </div>

        <!-- Sort Dropdown -->
        <select name="sort" class="form-select form-select-sm bg-dark text-light border-secondary w-auto font-monospace shadow-sm" onchange="this.form.submit()">
          <option value="default" <%= current_sort === 'default' ? 'selected' : '' %>>SORT: DEFAULT_GRID</option>
          <option value="xp_high" <%= current_sort === 'xp_high' ? 'selected' : '' %>>XP: HIGH → LOW</option>
          <option value="xp_low" <%= current_sort === 'xp_low' ? 'selected' : '' %>>XP: LOW → HIGH</option>
          <option value="newest" <%= current_sort === 'newest' ? 'selected' : '' %>>TIMESTAMP: LATEST</option>
        </select>

        <!-- Quick Difficulty Filter Tabs -->
        <div class="btn-group btn-group-sm shadow-sm" role="group">
          <a href="?filter=all&q=<%= search_query %>&sort=<%= current_sort %>" class="btn btn-outline-warning fw-bold <%= current_filter === 'all' || !current_filter ? 'active' : '' %>">ALL</a>
          <a href="?filter=easy&q=<%= search_query %>&sort=<%= current_sort %>" class="btn btn-outline-info fw-bold <%= current_filter === 'easy' ? 'active' : '' %>">EASY</a>
          <a href="?filter=medium&q=<%= search_query %>&sort=<%= current_sort %>" class="btn btn-outline-warning fw-bold <%= current_filter === 'medium' ? 'active' : '' %>">MEDIUM</a>
          <a href="?filter=hard&q=<%= search_query %>&sort=<%= current_sort %>" class="btn btn-outline-danger fw-bold <%= current_filter === 'hard' ? 'active' : '' %>">HARD</a>
        </div>
      </form>
    </div>
  </div>

  <div class="row g-4 mb-4">
    <% if (challenges && challenges.length > 0) { %>
      <% challenges.forEach(function(challenge) { 
          var diff = (challenge.difficulty || '').toLowerCase();
          var isEasy = diff.includes('easy') || diff === 'e';
          var isMed = diff.includes('med') || diff === 'm';
          var borderClass = isEasy ? 'border-info' : (isMed ? 'border-warning' : 'border-danger');
          var bgClass = isEasy ? 'bg-info' : (isMed ? 'bg-warning' : 'bg-danger');
          var textClass = isEasy ? 'text-info' : (isMed ? 'text-warning' : 'text-danger');
          var btnClass = isEasy ? 'btn-outline-info' : (isMed ? 'btn-outline-warning' : 'btn-outline-danger');
          var glowColor = isEasy ? 'rgba(13, 202, 240, 0.12)' : (isMed ? 'rgba(255, 193, 7, 0.12)' : 'rgba(220, 53, 69, 0.12)');
      %>
        <div class="col-md-4">
          <div class="card h-100 shadow-lg bg-dark text-white position-relative overflow-hidden hover-lift <%= borderClass %>" 
            style="background-color: #12161f !important; box-shadow: 0 0 15px <%= glowColor %>; border-width: <%= !isEasy && !isMed ? '2px !important' : '1px' %>;">
            
            <!-- Top neon tactical status line -->
            <div class="position-absolute top-0 start-0 w-100 <%= bgClass %>" style="height: 3px;"></div>

            <div class="card-body d-flex flex-column justify-content-between p-4">
              <div>
                <div class="d-flex justify-content-between align-items-center mb-3 font-monospace small">
                  <span class="badge bg-black border <%= borderClass %> <%= textClass %> px-2 py-1 shadow-sm">
                    ⚡ RAID_ACTIVE
                  </span>
                  <span class="badge bg-black border border-secondary text-warning fw-bold px-2 py-1 shadow-sm">+<%= challenge.xp_reward %> XP</span>
                </div>
                <h5 class="card-title text-light fw-bold font-monospace mb-2"><%= challenge.title %></h5>
                <h6 class="card-subtitle mb-3 text-secondary font-monospace small">
                  THREAT_LVL: <span class="text-uppercase fw-bold <%= textClass %>"><%= challenge.difficulty %></span>
                </h6>
                <p class="card-text text-muted small font-monospace" style="line-height: 1.6;"><%= challenge.description %></p>
              </div>
              <div class="mt-4 pt-3 border-top border-secondary">
                <a href="/projects/challenge/<%= challenge.id %>/" class="btn <%= btnClass %> btn-sm w-100 font-monospace fw-bold shadow-sm">
                  [ INITIATE RAID ] →
                </a>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div class="col">
        <div class="alert alert-dark border border-secondary text-center text-muted py-4 font-monospace bg-black shadow">
          // NO_RAIDS_DETECTED: No combat vectors found matching current telemetry parameters.
        </div>
      </div>
    <% } %>
  </div>

  <!-- Challenges Pagination -->
  <% if (challengeTotalPages > 1) { %>
    <nav class="my-4 font-monospace">
      <ul class="pagination justify-content-center">
        <% if (challengeCurrentPage > 1) { %>
          <li class="page-item"><a class="page-link bg-dark text-warning border-secondary shadow" href="?challenge_page=<%= challengeCurrentPage - 1 %>&filter=<%= current_filter %>&q=<%= search_query %>&sort=<%= current_sort %>">◀ PREV_SECTOR</a></li>
        <% } else { %>
          <li class="page-item disabled"><span class="page-link bg-dark text-muted border-secondary">◀ PREV_SECTOR</span></li>
        <% } %>
        <li class="page-item disabled"><span class="page-link bg-dark text-light border-secondary">ZONE <%= challengeCurrentPage %> / <%= challengeTotalPages %></span></li>
        <% if (challengeCurrentPage < challengeTotalPages) { %>
          <li class="page-item"><a class="page-link bg-dark text-warning border-secondary shadow" href="?challenge_page=<%= challengeCurrentPage + 1 %>&filter=<%= current_filter %>&q=<%= search_query %>&sort=<%= current_sort %>">NEXT_SECTOR ▶</a></li>
        <% } else { %>
          <li class="page-item disabled"><span class="page-link bg-dark text-muted border-secondary">NEXT_SECTOR ▶</span></li>
        <% } %>
      </ul>
    </nav>
  <% } %>

</div>

<style>
  .hover-lift {
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease-in-out;
  }
  .hover-lift:hover {
    transform: translateY(-6px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.8) !important;
  }
</style>

<%- include('../partials/footer') %>
