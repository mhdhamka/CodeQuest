<%- include('../partials/header', { title: 'CodeQuest // CTF Raids & Challenges' }) %>
<%- include('../partials/navbar', { activeNav: 'ctf' }) %>

<div class="container my-4">
  
  <!-- Header / Breadcrumb -->
  <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <i class="codicon codicon-issues text-warning fs-4"></i>
        <h1 class="h3 fw-bold text-light mb-0">CTF Security Raids &amp; Codebases</h1>
        <span class="badge bg-black border border-secondary text-muted"><%= challenges ? challenges.length : 0 %> Raids Available</span>
      </div>
      <p class="text-muted small mb-0 font-monospace">
        Audit vulnerable code architectures, resolve concurrency bugs in Go, remediate XSS in Vue 3, and capture flags.
      </p>
    </div>

    <!-- Quick action to start workspace -->
    <a href="/workspace/create/" class="btn btn-sm btn-gh-primary font-monospace d-flex align-items-center gap-1">
      <i class="codicon codicon-plus"></i>
      <span>New Codespace</span>
    </a>
  </div>

  <!-- Filter & Search Controls (GitHub Issues Style) -->
  <div class="p-3 rounded border mb-4" style="background: var(--gh-canvas-default); border-color: var(--gh-border-default) !important;">
    <form method="GET" action="" class="row g-2 align-items-center">
      <input type="hidden" name="sort" value="<%= current_sort %>">

      <!-- Search Input -->
      <div class="col-md-5">
        <div class="input-group input-group-sm">
          <span class="input-group-text bg-dark border-secondary text-muted">
            <i class="codicon codicon-search"></i>
          </span>
          <input type="text" name="q" class="form-control bg-dark text-light border-secondary font-monospace" placeholder="Filter raids (e.g. go, vue, sql, race)..." value="<%= search_query %>">
        </div>
      </div>

      <!-- Language / Difficulty Filter Badges -->
      <div class="col-md-5">
        <div class="d-flex flex-wrap gap-1">
          <a href="?filter=all&q=<%= search_query %>&sort=<%= current_sort %>" class="btn btn-sm <%= current_filter === 'all' || !current_filter ? 'btn-gh-primary' : 'btn-gh-secondary text-light' %> font-monospace py-0 px-2" style="font-size: 0.75rem;">
            All
          </a>
          <a href="?filter=go&q=<%= search_query %>&sort=<%= current_sort %>" class="btn btn-sm <%= current_filter === 'go' ? 'btn-gh-primary' : 'btn-gh-secondary text-light' %> font-monospace py-0 px-2" style="font-size: 0.75rem;">
            <i class="codicon codicon-file-code text-go"></i> Go (.go)
          </a>
          <a href="?filter=vue&q=<%= search_query %>&sort=<%= current_sort %>" class="btn btn-sm <%= current_filter === 'vue' ? 'btn-gh-primary' : 'btn-gh-secondary text-light' %> font-monospace py-0 px-2" style="font-size: 0.75rem;">
            <i class="codicon codicon-symbol-class text-vue"></i> Vue (.vue)
          </a>
          <a href="?filter=easy&q=<%= search_query %>&sort=<%= current_sort %>" class="btn btn-sm <%= current_filter === 'easy' ? 'btn-gh-primary' : 'btn-gh-secondary text-light' %> font-monospace py-0 px-2" style="font-size: 0.75rem;">
            Easy
          </a>
          <a href="?filter=medium&q=<%= search_query %>&sort=<%= current_sort %>" class="btn btn-sm <%= current_filter === 'medium' ? 'btn-gh-primary' : 'btn-gh-secondary text-light' %> font-monospace py-0 px-2" style="font-size: 0.75rem;">
            Medium
          </a>
          <a href="?filter=hard&q=<%= search_query %>&sort=<%= current_sort %>" class="btn btn-sm <%= current_filter === 'hard' ? 'btn-gh-primary' : 'btn-gh-secondary text-light' %> font-monospace py-0 px-2" style="font-size: 0.75rem;">
            Hard
          </a>
        </div>
      </div>

      <!-- Sort Selection -->
      <div class="col-md-2 text-md-end">
        <select name="sort" class="form-select form-select-sm bg-dark text-light border-secondary font-monospace" onchange="this.form.submit()">
          <option value="default" <%= current_sort === 'default' ? 'selected' : '' %>>Sort: Default</option>
          <option value="xp_high" <%= current_sort === 'xp_high' ? 'selected' : '' %>>XP: High → Low</option>
          <option value="xp_low" <%= current_sort === 'xp_low' ? 'selected' : '' %>>XP: Low → High</option>
          <option value="newest" <%= current_sort === 'newest' ? 'selected' : '' %>>Newest First</option>
        </select>
      </div>
    </form>
  </div>

  <!-- Challenge Cards Grid (GitHub Repo / Issue Style) -->
  <div class="row g-3 mb-4">
    <% if (challenges && challenges.length > 0) { %>
      <% challenges.forEach(function(challenge) { 
          var titleLower = (challenge.title || '').toLowerCase();
          var isGo = titleLower.includes('golang') || titleLower.includes('go') || challenge.id === 7;
          var isVue = titleLower.includes('vue') || challenge.id === 8;
          var diff = (challenge.difficulty || '').toLowerCase();
          var isEasy = diff.includes('easy');
          var isMed = diff.includes('med');
      %>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 rounded border p-3 font-monospace d-flex flex-column justify-content-between" style="background: var(--gh-canvas-default); border-color: var(--gh-border-default) !important;">
            <div>
              <!-- Top Card Meta -->
              <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-1">
                <div class="d-flex align-items-center gap-1">
                  <% if (isGo) { %>
                    <span class="badge badge-go"><i class="codicon codicon-file-code"></i> .go</span>
                  <% } else if (isVue) { %>
                    <span class="badge badge-vue"><i class="codicon codicon-symbol-class"></i> .vue</span>
                  <% } else { %>
                    <span class="badge bg-black border border-secondary text-muted">#<%= challenge.id %></span>
                  <% } %>
                  
                  <span class="badge <%= isEasy ? 'bg-success text-black' : (isMed ? 'bg-warning text-black' : 'bg-danger text-white') %> fw-bold" style="font-size: 0.65rem;">
                    <%= challenge.difficulty %>
                  </span>
                </div>
                <span class="badge bg-black border border-warning text-warning fw-bold">+<%= challenge.xp_reward %> XP</span>
              </div>

              <!-- Title & Category -->
              <h5 class="text-light fw-bold mb-1" style="font-size: 0.95rem;">
                <a href="/projects/challenge/<%= challenge.id %>/" class="text-light text-decoration-none hover-text-blue">
                  <%= challenge.title %>
                </a>
              </h5>
              <div class="text-muted small mb-2" style="font-size: 0.72rem;">
                <i class="codicon codicon-tag"></i> <%= challenge.category || 'Security Defense' %>
                <span class="mx-1">•</span>
                <i class="codicon codicon-history"></i> <%= Math.floor((challenge.time_limit_seconds || 300) / 60) %>m limit
              </div>

              <!-- Description -->
              <p class="text-muted small mb-3" style="line-height: 1.5; font-size: 0.78rem;">
                <%= challenge.description %>
              </p>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex gap-2 pt-2 border-top" style="border-color: var(--gh-border-default) !important;">
              <a href="/projects/challenge/<%= challenge.id %>/" class="btn btn-sm btn-gh-secondary flex-grow-1 text-center font-monospace text-light">
                <i class="codicon codicon-book"></i> Mission Intel
              </a>
              <a href="/workspace/1?lang=<%= isGo ? 'go' : (isVue ? 'vue' : 'python') %>" class="btn btn-sm btn-gh-primary font-monospace px-3" title="Open directly in VS Code Workbench">
                <i class="codicon codicon-play"></i> Solve
              </a>
            </div>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div class="col-12">
        <div class="p-4 rounded border text-center font-monospace text-muted" style="background: var(--gh-canvas-default); border-color: var(--gh-border-default) !important;">
          <i class="codicon codicon-info fs-3 mb-2 text-warning"></i>
          <div>No CTF raids match your active filter or search terms.</div>
          <a href="/projects/" class="btn btn-sm btn-gh-secondary mt-2">Reset Filters</a>
        </div>
      </div>
    <% } %>
  </div>

  <!-- Pagination -->
  <% if (challengeTotalPages > 1) { %>
    <nav class="my-4 font-monospace">
      <ul class="pagination justify-content-center">
        <% if (challengeCurrentPage > 1) { %>
          <li class="page-item">
            <a class="page-link bg-dark text-info border-secondary" href="?challenge_page=<%= challengeCurrentPage - 1 %>&filter=<%= current_filter %>&q=<%= search_query %>&sort=<%= current_sort %>">← Previous</a>
          </li>
        <% } %>
        <li class="page-item disabled">
          <span class="page-link bg-dark text-muted border-secondary">Page <%= challengeCurrentPage %> of <%= challengeTotalPages %></span>
        </li>
        <% if (challengeCurrentPage < challengeTotalPages) { %>
          <li class="page-item">
            <a class="page-link bg-dark text-info border-secondary" href="?challenge_page=<%= challengeCurrentPage + 1 %>&filter=<%= current_filter %>&q=<%= search_query %>&sort=<%= current_sort %>">Next →</a>
          </li>
        <% } %>
      </ul>
    </nav>
  <% } %>

  <!-- Production Deployments Vault -->
  <div class="mt-5 pt-3 border-top" style="border-color: var(--gh-border-default) !important;">
    <div class="d-flex align-items-center gap-2 mb-3">
      <i class="codicon codicon-repo text-info fs-4"></i>
      <h2 class="h4 fw-bold text-light mb-0">Production Repositories &amp; Deployments</h2>
    </div>

    <div class="row g-3">
      <% if (projects && projects.length > 0) { %>
        <% projects.forEach(function(project) { %>
          <div class="col-md-4">
            <div class="p-3 rounded border font-monospace h-100 d-flex flex-column justify-content-between" style="background: var(--gh-canvas-default); border-color: var(--gh-border-default) !important;">
              <div>
                <div class="d-flex align-items-center gap-2 mb-2">
                  <i class="codicon codicon-repo text-muted"></i>
                  <a href="/projects/project/<%= project.id %>/" class="text-info fw-bold text-decoration-none">
                    <%= project.title %>
                  </a>
                </div>
                <p class="text-muted small mb-3" style="line-height: 1.5; font-size: 0.78rem;">
                  <%= (project.description || '').slice(0, 110) %>...
                </p>
              </div>
              <a href="/projects/project/<%= project.id %>/" class="btn btn-sm btn-gh-secondary text-center text-light">
                Inspect Repository →
              </a>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>
  </div>

</div>

<%- include('../partials/footer') %>
