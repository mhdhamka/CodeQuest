<%- include('../partials/header', { title: 'CodeQuest // Raid #' + challenge.id + ': ' + challenge.title }) %>
<%- include('../partials/navbar', { activeNav: 'ctf' }) %>

<div class="container my-4">
  
  <% 
    var titleLower = (challenge.title || '').toLowerCase();
    var isGo = titleLower.includes('go') || challenge.id === 7;
    var isVue = titleLower.includes('vue') || challenge.id === 8;
    var langParam = isGo ? 'go' : (isVue ? 'vue' : 'python');
  %>

  <!-- Breadcrumb -->
  <div class="d-flex align-items-center gap-2 mb-3 text-muted small font-monospace">
    <a href="/projects/" class="text-info text-decoration-none">raids</a>
    <span>/</span>
    <span class="text-light fw-bold">#<%= challenge.id %></span>
    <span class="mx-1">•</span>
    <% if (isGo) { %>
      <span class="badge badge-go"><i class="codicon codicon-file-code"></i> Go 1.22</span>
    <% } else if (isVue) { %>
      <span class="badge badge-vue"><i class="codicon codicon-symbol-class"></i> Vue 3 SFC</span>
    <% } %>
  </div>

  <!-- Challenge Title Header (GitHub Issue Style) -->
  <div class="p-3 rounded border mb-4" style="background: var(--gh-canvas-default); border-color: var(--gh-border-default) !important;">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div>
        <div class="d-flex align-items-center gap-2 mb-1">
          <span class="badge <%= already_solved ? 'bg-success text-black' : 'bg-warning text-black' %> fw-bold">
            <i class="codicon <%= already_solved ? 'codicon-pass' : 'codicon-issue-opened' %>"></i>
            <%= already_solved ? 'SOLVED' : 'UNSOLVED RAID' %>
          </span>
          <h1 class="h4 text-light fw-bold mb-0 font-monospace"><%= challenge.title %></h1>
        </div>
        <div class="text-muted small font-monospace">
          <span>Target Category: <strong class="text-info"><%= challenge.category || 'Security Defense' %></strong></span>
          <span class="mx-2">•</span>
          <span>Difficulty: <strong class="text-warning"><%= challenge.difficulty %></strong></span>
          <span class="mx-2">•</span>
          <span>Bounty Reward: <strong class="text-success">+<%= challenge.xp_reward %> XP</strong></span>
        </div>
      </div>

      <div class="d-flex align-items-center gap-2">
        <a href="/workspace/1?lang=<%= langParam %>" class="btn btn-sm btn-gh-primary font-monospace d-flex align-items-center gap-2">
          <i class="codicon codicon-vscode"></i>
          <span>Solve in VS Code Workbench</span>
        </a>
      </div>
    </div>
  </div>

  <% if (typeof alertMessage !== 'undefined' && alertMessage) { %>
    <div class="alert alert-<%= alertType === 'success' ? 'success' : 'danger' %> font-monospace small mb-4" style="<%= alertType === 'success' ? 'background: #112d1b; border-color: #2ea043; color: #3fb950;' : 'background: #2d1114; border-color: #f85149; color: #ff7b72;' %>">
      <strong><%= alertType === 'success' ? '✔ VERIFIED:' : '✖ FAILURE:' %></strong> <%= alertMessage %>
    </div>
  <% } %>

  <div class="row g-4">
    <!-- Left Column: Vulnerable Code Segment & Mission Brief -->
    <div class="col-lg-8">
      <div class="p-3 rounded border font-monospace h-100 d-flex flex-column" style="background: var(--gh-canvas-default); border-color: var(--gh-border-default) !important;">
        <div class="mb-3">
          <h5 class="text-light fw-bold small d-flex align-items-center gap-2 mb-2">
            <i class="codicon codicon-book text-muted"></i> Mission Intel &amp; Exploit Vector
          </h5>
          <p class="text-muted small mb-0" style="line-height: 1.6;">
            <%= challenge.description %>
          </p>
        </div>

        <% if (challenge.instructions) { %>
          <div class="p-2 mb-3 rounded bg-black border border-secondary text-warning small">
            <strong>MISSION OBJECTIVE:</strong> <%= challenge.instructions %>
          </div>
        <% } %>

        <!-- Predefined Test Cases to Satisfy -->
        <% if (challenge.test_cases && challenge.test_cases.length > 0) { %>
          <div class="mb-3">
            <div class="text-info fw-bold small mb-2 d-flex align-items-center gap-1">
              <i class="codicon codicon-beaker"></i> Predefined Test Cases (<%= challenge.test_cases.length %>)
            </div>
            <div class="row g-2">
              <% challenge.test_cases.forEach(function(tc) { %>
                <div class="col-md-6">
                  <div class="p-2 rounded bg-black border border-secondary small" style="font-size: 0.72rem;">
                    <div class="d-flex justify-content-between text-light fw-bold mb-1">
                      <span><%= tc.name %></span>
                      <span class="badge bg-secondary"><%= tc.type || 'Functional' %></span>
                    </div>
                    <div class="text-muted"><span class="text-info">Input:</span> <code><%= tc.input %></code></div>
                    <div class="text-muted"><span class="text-warning">Expects:</span> <span class="text-light"><%= tc.expected %></span></div>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
        <% } %>

        <!-- Vulnerable Code Segment -->
        <div class="flex-grow-1 d-flex flex-column mt-2">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="text-muted small fw-bold">
              <i class="codicon codicon-code"></i> Vulnerable Code Segment
            </span>
            <button class="btn btn-sm btn-gh-secondary font-monospace py-0 px-2" id="copyCodeBtn" onclick="copySnippetCode()">
              <i class="codicon codicon-copy"></i> Copy
            </button>
          </div>
          <div class="rounded border bg-black p-3 flex-grow-1 overflow-auto" style="border-color: var(--gh-border-default) !important; max-height: 320px;">
            <pre class="text-light font-monospace small mb-0" id="codeSnippetContent"><code><%= challenge.vulnerable_code %></code></pre>
          </div>
        </div>

        <!-- Vue 3 SFC CTF Test Suite Runner Component -->
        <div class="mt-3">
          <div id="vue-ctf-runner-mount"></div>
          <script>
            document.addEventListener('DOMContentLoaded', function() {
              if (window.CodeQuestVue) {
                window.CodeQuestVue.mount('vue-ctf-runner-mount', '/components/CtfChallengeRunner.vue', {
                  challengeId: <%= challenge.id %>,
                  challengeTitle: <%- JSON.stringify(challenge.title) %>,
                  sourceCode: <%- JSON.stringify(challenge.vulnerable_code) %>
                });
              }
            });
          </script>
        </div>
      </div>
    </div>

    <!-- Right Column: Flag Submission & Quick Actions -->
    <div class="col-lg-4">
      <div class="p-3 rounded border font-monospace h-100 d-flex flex-column justify-content-between" style="background: var(--gh-canvas-default); border-color: var(--gh-border-default) !important;">
        <div>
          <div class="d-flex align-items-center gap-2 mb-3">
            <i class="codicon codicon-key text-warning fs-5"></i>
            <h5 class="text-light fw-bold mb-0">Flag Verification</h5>
          </div>

          <% if (already_solved) { %>
            <div class="p-3 mb-3 rounded border border-success text-center" style="background: rgba(46, 160, 67, 0.15);">
              <i class="codicon codicon-check text-success fs-1 mb-2"></i>
              <div class="text-success fw-bold">FLAG VERIFIED &amp; LOGGED</div>
              <div class="text-muted small mt-1">+<%= challenge.xp_reward %> XP awarded to your operative dossier.</div>
            </div>
          <% } else { %>
            <p class="text-muted small mb-3" style="font-size: 0.78rem; line-height: 1.5;">
              Patch the vulnerability in the collaborative editor or exploit it to uncover the signed flag.
            </p>

            <form method="post" action="/projects/challenge/<%= challenge.id %>/" id="flagSubmissionForm" onsubmit="handleFormSubmit(event)">
              <div class="mb-3">
                <label for="id_flag" class="form-label text-muted small">Enter Target Flag:</label>
                <div class="input-group input-group-sm">
                  <span class="input-group-text bg-dark border-secondary text-warning">&gt;</span>
                  <input type="text" name="flag" id="id_flag" class="form-control bg-dark text-light border-secondary font-monospace" placeholder="FLAG{...}" required autocomplete="off">
                </div>
              </div>
              <button type="submit" id="submitBtn" class="btn btn-sm btn-gh-primary w-100 font-monospace py-2">
                Submit Flag Checksum
              </button>
            </form>
          <% } %>
        </div>

        <div class="pt-3 border-top d-flex flex-column gap-2" style="border-color: var(--gh-border-default) !important;">
          <a href="/workspace/1?lang=<%= langParam %>" class="btn btn-sm btn-gh-secondary text-light w-100 font-monospace text-center">
            <i class="codicon codicon-play"></i> Launch in Codespace (<%= isGo ? '.go' : (isVue ? '.vue' : '.py') %>)
          </a>
          <a href="/projects/" class="btn btn-sm btn-link text-muted font-monospace text-center text-decoration-none">
            ← Return to Raids Index
          </a>
        </div>
      </div>
    </div>
  </div>

</div>

<script>
  function copySnippetCode() {
    const codeText = document.getElementById('codeSnippetContent').innerText;
    navigator.clipboard.writeText(codeText).then(() => {
      const btn = document.getElementById('copyCodeBtn');
      btn.innerHTML = '<i class="codicon codicon-check text-success"></i> Copied!';
      setTimeout(() => {
        btn.innerHTML = '<i class="codicon codicon-copy"></i> Copy';
      }, 2000);
    });
  }

  function handleFormSubmit(event) {
    const btn = document.getElementById('submitBtn');
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Verifying...';
    }
    return true;
  }
</script>

<%- include('../partials/footer') %>
