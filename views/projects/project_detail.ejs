<%- include('../partials/header', { title: 'System Inspection // ' + project.title }) %>
<%- include('../partials/navbar', { activeNav: 'ctf' }) %>

<!-- Player HUD / Return Navigation Bar -->
<nav class="navbar navbar-dark bg-dark mb-4 rounded border border-secondary shadow-lg px-4" style="background: linear-gradient(180deg, #16202c 0%, #0d1117 100%) !important;">
  <div class="container-fluid px-0">
    <div class="d-flex align-items-center gap-3">
      <a href="/projects/" class="btn btn-sm btn-outline-info font-monospace">← // BACK_TO_ARENA</a>
      <span class="text-secondary d-none d-md-inline">|</span>
      <span class="text-light small fw-bold font-monospace text-uppercase tracking-wider">🛡️ SYSTEM_INSPECTION_MODE</span>
    </div>
    <div>
      <span class="badge bg-black border border-info px-3 py-2 text-info font-monospace shadow-sm">
        TECH: <strong class="text-light"><%= project.technology %></strong>
      </span>
    </div>
  </div>
</nav>

<div class="container my-4">
  <!-- Title Header -->
  <div class="row mb-4">
    <div class="col">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
          <span class="text-info font-monospace small uppercase tracking-widest d-block mb-1">#SYSTEM_BUILD_<%= project.id %></span>
          <h1 class="display-6 fw-bold text-light font-monospace mb-0" style="text-shadow: 0 0 10px rgba(13, 202, 240, 0.3);">
            <%= project.title %>
          </h1>
        </div>
        <div>
          <span class="badge bg-black border border-info text-info px-3 py-2 font-monospace text-uppercase">
            <%= project.technology %>
          </span>
        </div>
      </div>
      <hr class="border-secondary mt-3 opacity-50">
    </div>
  </div>

  <!-- Main Content Grid -->
  <div class="row g-4 mb-5">
    <div class="col-lg-8">
      <div class="card border-secondary shadow-lg h-100 bg-dark text-white" style="background-color: #12161f !important;">
        <div class="card-body p-4 d-flex flex-column">
          <% if (project.image && project.image.url) { %>
            <div class="mb-4 rounded overflow-hidden border border-secondary" style="max-height: 280px;">
              <img src="<%= project.image.url %>" class="w-100 h-100 object-fit-cover opacity-75" alt="<%= project.title %>">
            </div>
          <% } %>

          <div class="mb-4">
            <h5 class="text-info fw-bold mb-3 font-monospace d-flex align-items-center gap-2">
              <span>📂</span> Architecture Specification
            </h5>
            <p class="text-light mb-0" style="line-height: 1.7; color: #c7d5e0;">
              <%= project.description %>
            </p>
          </div>
          
          <hr class="border-secondary opacity-25 my-3">

          <div class="p-3 rounded border border-secondary bg-black">
            <h6 class="text-warning font-monospace small mb-2">// SECURITY AUDIT TELEMETRY</h6>
            <pre class="text-success font-monospace small mb-0"><code>[SYSTEM_HEALTH]: 100% OK
[CONTAINER_STATUS]: Isolated sandbox operational
[CIPHER_SUITE]: TLS_AES_256_GCM_SHA384 active
[DEPLOYMENT_TARGET]: Production Edge Node (Port 3000)</code></pre>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card h-100 border-info shadow-lg bg-dark text-white position-relative overflow-hidden" style="background-color: #12161f !important; box-shadow: 0 0 20px rgba(13, 202, 240, 0.1);">
        <div class="position-absolute top-0 start-0 w-100 bg-info" style="height: 3px;"></div>

        <div class="card-body d-flex flex-column justify-content-between p-4">
          <div>
            <h5 class="card-title text-info fw-bold mb-3 font-monospace d-flex align-items-center gap-2">
              <span>⚡</span> System Controls
            </h5>
            
            <p class="text-muted small mb-4" style="line-height: 1.5;">
              Production system deployed and actively monitored. Team members can launch collaborative workspaces or run vulnerability scans against this target.
            </p>

            <div class="d-grid gap-2 font-monospace">
              <a href="/workspace/room/create/" class="btn btn-outline-info font-monospace fw-bold py-2">
                + Launch Work Session
              </a>
              <a href="/projects/" class="btn btn-outline-warning font-monospace py-2">
                Audit Tactical Raids
              </a>
            </div>
          </div>

          <div class="mt-4 pt-3 border-top border-secondary opacity-75">
            <a href="/projects/" class="btn btn-outline-secondary btn-sm w-100 font-monospace">
              ← Return to Arena Index
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
