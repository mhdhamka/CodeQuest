    <span style="color: #7ee787;">&lt;button</span> <span style="color: #79c0ff;">@click=</span><span style="color: #a5d6ff;">"syncPulse"</span><span style="color: #7ee787;">&gt;</span>Sync Peers: {{ syncCount }}<span style="color: #7ee787;">&lt;/button&gt;</span>
  <span style="color: #7ee787;">&lt;/div&gt;</span>
<span style="color: #ff7b72;">&lt;/template&gt;</span>

<span style="color: #ff7b72;">&lt;script</span> <span style="color: #79c0ff;">setup lang=</span><span style="color: #a5d6ff;">"ts"</span><span style="color: #ff7b72;">&gt;</span>
<span style="color: #ff7b72;">import</span> { ref } <span style="color: #ff7b72;">from</span> <span style="color: #a5d6ff;">'vue'</span>
<span style="color: #ff7b72;">const</span> title = <span style="color: #d2a8ff;">ref</span>(<span style="color: #a5d6ff;">'CodeQuest Vue 3 Arena'</span>)
<span style="color: #ff7b72;">const</span> syncCount = <span style="color: #d2a8ff;">ref</span>(<span style="color: #79c0ff;">42</span>)
<span style="color: #ff7b72;">function</span> <span style="color: #d2a8ff;">syncPulse</span>() { syncCount.value++ }
<span style="color: #ff7b72;">&lt;/script&gt;</span></code></pre>
