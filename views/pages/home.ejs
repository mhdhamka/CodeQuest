          <pre class="p-3 mb-0 font-monospace text-light small overflow-auto" style="height: 220px; background: #0d1117; font-size: 0.75rem; line-height: 1.5;"><code><span style="color: #ff7b72;">package</span> main

<span style="color: #ff7b72;">import</span> (
    <span style="color: #a5d6ff;">"fmt"</span>
    <span style="color: #a5d6ff;">"sync"</span>
)

<span style="color: #ff7b72;">type</span> <span style="color: #79c0ff;">SafeCounter</span> <span style="color: #ff7b72;">struct</span> {
    mu sync.Mutex
    v  <span style="color: #79c0ff;">int</span>
}

<span style="color: #ff7b72;">func</span> (c *<span style="color: #79c0ff;">SafeCounter</span>) <span style="color: #d2a8ff;">Inc</span>() {
    c.mu.<span style="color: #d2a8ff;">Lock</span>()
    <span style="color: #ff7b72;">defer</span> c.mu.<span style="color: #d2a8ff;">Unlock</span>()
    c.v++
}

<span style="color: #ff7b72;">func</span> <span style="color: #d2a8ff;">main</span>() {
    c := &amp;SafeCounter{}
    <span style="color: #8b949e;">// Concurrently increment 100 times</span>
    <span style="color: #ff7b72;">var</span> wg sync.WaitGroup
    <span style="color: #ff7b72;">for</span> i := <span style="color: #79c0ff;">0</span>; i &lt; <span style="color: #79c0ff;">100</span>; i++ {
        wg.<span style="color: #d2a8ff;">Add</span>(<span style="color: #79c0ff;">1</span>)
        <span style="color: #ff7b72;">go</span> <span style="color: #ff7b72;">func</span>() { <span style="color: #ff7b72;">defer</span> wg.<span style="color: #d2a8ff;">Done</span>(); c.<span style="color: #d2a8ff;">Inc</span>() }()
    }
    wg.<span style="color: #d2a8ff;">Wait</span>()
    fmt.<span style="color: #d2a8ff;">Println</span>(<span style="color: #a5d6ff;">"[OK] Go Goroutine safe balance:"</span>, c.v)
}</code></pre>
